    "commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "ids":{"type":"array","maxItems":2048,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1024}},
    "result":{"type":"object","additionalProperties":false,"required":["strict_percent","data_percent","target_bytes","candidate_bytes","strict_difference_count","data_difference_count","strict_row_ids_sha256","data_row_ids_sha256","physical_target_count","physical_candidate_count","physical_difference_count","physical_difference_ids_sha256","protected_total","protected_losses","protected_sibling_digest","source_link_exact"],"properties":{"strict_percent":{"const":100},"data_percent":{"const":100},"target_bytes":{"type":"integer","minimum":0},"candidate_bytes":{"type":"integer","minimum":0},"strict_difference_count":{"type":"integer","minimum":0},"data_difference_count":{"type":"integer","minimum":0},"strict_row_ids_sha256":{"$ref":"#/$defs/sha"},"data_row_ids_sha256":{"$ref":"#/$defs/sha"},"physical_target_count":{"type":"integer","minimum":0},"physical_candidate_count":{"type":"integer","minimum":0},"physical_difference_count":{"type":"integer","minimum":0},"physical_difference_ids_sha256":{"$ref":"#/$defs/sha"},"protected_total":{"type":"integer","minimum":0},"protected_losses":{"type":"integer","minimum":0},"protected_sibling_digest":{"$ref":"#/$defs/sha"},"source_link_exact":{"const":true}}},
