{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CRACK_WINNING_CELL_EVIDENCE_V1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner", "function", "strategy", "rank", "expected_terminal", "candidate_sha256", "predicted_rows_sha256", "alternatives_compiled", "negative_controls", "pivot_if_unranked", "source_class", "inputs", "causal_prediction"],
  "properties": {
    "schema": {"const": "crack_winning_cell_evidence/v1"},
    "owner": {"type": "string", "minLength": 1},
    "function": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "strategy": {"const": "winning_cell_first"},
    "rank": {"const": 1},
    "expected_terminal": {"enum": ["exact", "improved"]},
    "candidate_sha256": {"$ref": "#/$defs/sha"},
    "predicted_rows_sha256": {"$ref": "#/$defs/sha"},
    "alternatives_compiled": {"const": 0},
    "negative_controls": {"const": 0},
    "pivot_if_unranked": {"const": true},
    "source_class": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha"},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "causal_prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earliest_divergence", "predicted_effect", "predicted_rows"],
      "properties": {
        "earliest_divergence": {"type": "string", "minLength": 1},
        "predicted_effect": {"type": "string", "minLength": 1},
        "predicted_rows": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
