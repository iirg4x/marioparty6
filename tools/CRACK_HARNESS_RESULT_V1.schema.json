{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CRACK_HARNESS_RESULT_V1.schema.json",
  "title": "Bounded crack cell terminal result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "approval_id", "approval_sha256", "owner", "task_id", "function", "base_commit", "campaign_id", "attempt_sha256", "candidate_sha256", "base_sha256", "status", "expected_terminal", "terminal_expectation_met", "reason", "predicted_rows", "receipts", "finished_at", "source_restored", "cleanup_status", "cleanup_errors", "authority_advanced", "result_sha256"],
  "properties": {
    "schema": {"const": "crack_harness_result/v1"},
    "approval_id": {"type": "string", "minLength": 1},
    "approval_sha256": {"$ref": "#/$defs/sha256"},
    "owner": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "function": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "attempt_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "base_sha256": {"$ref": "#/$defs/sha256"},
    "frontier_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["exact", "improved", "no_gain", "failed"]},
    "expected_terminal": {"enum": ["exact", "improved"]},
    "terminal_expectation_met": {"type": "boolean"},
    "reason": {"type": "string", "minLength": 1},
    "owner_gain": {"type": ["number", "null"]},
    "predicted_rows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "precompile": {"$ref": "#/$defs/compact_receipt"},
        "compile": {"$ref": "#/$defs/compile_receipt"},
        "strict": {"$ref": "#/$defs/compact_receipt"},
        "data": {"$ref": "#/$defs/compact_receipt"},
        "focus": {"$ref": "#/$defs/compact_receipt"},
        "siblings": {"$ref": "#/$defs/compact_receipt"},
        "physical": {"$ref": "#/$defs/compact_receipt"},
        "assess": {"$ref": "#/$defs/compact_receipt"},
        "record": {"$ref": "#/$defs/compact_receipt"},
        "discard": {"$ref": "#/$defs/compact_receipt"},
        "failure": {"$ref": "#/$defs/failure_receipt"},
        "discard_failure": {"$ref": "#/$defs/failure_receipt"},
        "secondary_failures": {"$ref": "#/$defs/secondary_failures"}
      }
    },
    "finished_at": {"type": "string", "format": "date-time"},
    "source_restored": {"type": "boolean"},
    "cleanup_status": {"enum": ["pending", "complete", "cleanup_incomplete"]},
    "cleanup_errors": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 1000}},
    "authority_advanced": {"const": false},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "exact"}}},
      "then": {
        "required": ["owner_gain", "report_sha256"],
        "not": {"required": ["frontier_sha256"]},
        "properties": {
          "terminal_expectation_met": {"const": true},
          "owner_gain": {"type": "number", "exclusiveMinimum": 0},
          "receipts": {
            "required": ["precompile", "compile", "strict", "data", "focus", "siblings", "physical", "assess", "record"]
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "no_gain"}}},
      "then": {
        "not": {"anyOf": [
          {"required": ["report_sha256"]},
          {"required": ["frontier_sha256"]}
        ]},
        "properties": {
          "terminal_expectation_met": {"const": false},
          "receipts": {
            "required": ["precompile", "compile", "strict", "data", "focus", "siblings", "physical", "assess", "discard"]
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "improved"}}},
      "then": {
        "required": ["owner_gain", "frontier_sha256"],
        "not": {"required": ["report_sha256"]},
        "properties": {
          "owner_gain": {"type": "number", "exclusiveMinimum": 0},
          "source_restored": {"const": false},
          "receipts": {
            "required": ["precompile", "compile", "strict", "data", "focus", "siblings", "physical", "assess", "discard"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["status", "expected_terminal"],
        "properties": {
          "status": {"const": "improved"},
          "expected_terminal": {"const": "exact"}
        }
      },
      "then": {"properties": {"terminal_expectation_met": {"const": false}}}
    },
    {
      "if": {
        "required": ["status", "expected_terminal"],
        "properties": {
          "status": {"const": "improved"},
          "expected_terminal": {"const": "improved"}
        }
      },
      "then": {"properties": {"terminal_expectation_met": {"const": true}}}
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "not": {"anyOf": [
          {"required": ["report_sha256"]},
          {"required": ["frontier_sha256"]}
        ]},
        "properties": {
          "terminal_expectation_met": {"const": false},
          "receipts": {"required": ["failure"]}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "command_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv_sha256", "returncode", "active_seconds", "stdout_sha256", "stderr_sha256", "cleanup_errors"],
      "properties": {
        "argv_sha256": {"$ref": "#/$defs/sha256"},
        "returncode": {"type": "integer", "const": 0},
        "active_seconds": {"type": "number", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "cleanup_errors": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "compact_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "hook", "ok", "summary", "payload_sha256", "command"],
      "properties": {
        "schema": {"const": "crack_harness_receipt/v1"},
        "hook": {"type": "string", "minLength": 1},
        "ok": {"type": "boolean"},
        "summary": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "oneOf": [
              {"type": ["string", "number", "boolean", "null"]},
              {
                "type": "array",
                "maxItems": 64,
                "items": {"type": ["string", "number", "boolean", "null"]}
              }
            ]
          }
        },
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "command": {"$ref": "#/$defs/command_receipt"}
      }
    },
    "compile_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "hook", "baseline_command", "candidate_command"],
      "properties": {
        "schema": {"const": "crack_harness_receipt/v1"},
        "hook": {"const": "compile"},
        "baseline_command": {"$ref": "#/$defs/command_receipt"},
        "candidate_command": {"$ref": "#/$defs/command_receipt"}
      }
    },
    "failure_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "hook", "reason", "command"],
      "properties": {
        "schema": {"const": "crack_harness_failure_receipt/v1"},
        "hook": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "argv_sha256": {"$ref": "#/$defs/sha256"},
        "command": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/failure_command_receipt"}
          ]
        }
      }
    },
    "failure_command_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv_sha256", "returncode", "active_seconds", "stdout_sha256", "stderr_sha256", "cleanup_errors", "object_observed"],
      "properties": {
        "argv_sha256": {"$ref": "#/$defs/sha256"},
        "returncode": {"type": ["integer", "null"]},
        "active_seconds": {"type": "number", "minimum": 0},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "cleanup_errors": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "maxLength": 1000}
        },
        "object_observed": {"type": "boolean"}
      }
    },
    "secondary_failures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "items"],
      "properties": {
        "schema": {"const": "crack_harness_secondary_failures/v1"},
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
