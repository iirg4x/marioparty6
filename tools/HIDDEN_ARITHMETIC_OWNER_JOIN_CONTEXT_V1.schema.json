{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HIDDEN_ARITHMETIC_OWNER_JOIN_CONTEXT_V1.schema.json",
  "title": "Hidden arithmetic owner join context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "partial_evidence_path", "partial_evidence_sha256", "function",
    "session_id", "source_sha256", "compiler_sha256",
    "trace_candidate_object_sha256", "failure_graph_sha256", "machine_sites",
    "production_row_groups", "source_owners", "source_class_allowlist",
    "rejected_controls", "target_object", "production_candidate_object",
    "focus_artifact", "strict_report_sha256", "data_report_sha256",
    "physical_relocation_receipt", "physical_relocation_count", "residual_rows",
    "context_sha256"
  ],
  "properties": {
    "schema": {"const": "hidden_arithmetic_owner_join_context/v1"},
    "partial_evidence_path": {"$ref": "#/$defs/absolutePath"},
    "partial_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "function": {"type": "string", "minLength": 1, "maxLength": 192},
    "session_id": {"type": "string", "pattern": "^session-[A-Za-z0-9]+$"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_sha256": {"$ref": "#/$defs/sha256"},
    "trace_candidate_object_sha256": {"$ref": "#/$defs/sha256"},
    "failure_graph_sha256": {"$ref": "#/$defs/sha256"},
    "machine_sites": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "production_row_groups": {
      "type": "array", "minItems": 2,
      "items": {"$ref": "#/$defs/rowGroup"}
    },
    "source_owners": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/sourceOwner"}
    },
    "source_class_allowlist": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": [
        "named_owner_chronology_x_reloaded_value_boundary",
        "named_owner_chronology_x_direct_expression_boundary"
      ]}
    },
    "rejected_controls": {
      "type": "array", "minItems": 2,
      "items": {"$ref": "#/$defs/rejectedControl"}
    },
    "target_object": {"$ref": "#/$defs/boundFile"},
    "production_candidate_object": {"$ref": "#/$defs/boundFile"},
    "focus_artifact": {"$ref": "#/$defs/boundFocusFile"},
    "strict_report_sha256": {"$ref": "#/$defs/sha256"},
    "data_report_sha256": {"$ref": "#/$defs/sha256"},
    "physical_relocation_receipt": {"$ref": "#/$defs/boundReceiptFile"},
    "physical_relocation_count": {"type": "integer", "minimum": 0},
    "residual_rows": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/residualRow"}
    },
    "context_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolutePath": {"type": "string", "minLength": 3},
    "boundFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/absolutePath"}, "size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "boundFocusFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256", "artifact_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"}, "size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "boundReceiptFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256", "receipt_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"}, "size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rowGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["trace_machine_site", "production_fmuls_index", "residual_indices"],
      "properties": {
        "trace_machine_site": {"type": "integer", "minimum": 0},
        "production_fmuls_index": {"type": "integer", "minimum": 0},
        "residual_indices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "sourceOwner": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "object_token", "byte_start", "byte_end", "span_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "object_token": {"type": "string", "minLength": 1, "maxLength": 192},
        "byte_start": {"type": "integer", "minimum": 0}, "byte_end": {"type": "integer", "minimum": 1},
        "span_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rejectedControl": {
      "type": "object", "additionalProperties": false,
      "required": ["control_id", "source_sha256", "object_sha256", "source_class", "boundary_kind", "outcome"],
      "properties": {
        "control_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_sha256": {"$ref": "#/$defs/sha256"}, "object_sha256": {"$ref": "#/$defs/sha256"},
        "source_class": {"type": "string", "minLength": 1, "maxLength": 192},
        "boundary_kind": {"enum": ["DIRECT_EXPRESSION_ARITHMETIC_BOUNDARY", "RELOADED_VALUE_BOUNDARY", "SPILL_RELOAD_BOUNDARY", "OTHER_AUTHENTICATED"]},
        "outcome": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "residualRow": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "target_diff_kind", "target_formatted", "candidate_diff_kind", "candidate_formatted"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "target_diff_kind": {"type": "string", "minLength": 1}, "candidate_diff_kind": {"type": "string", "minLength": 1},
        "target_formatted": {"type": ["string", "null"]}, "candidate_formatted": {"type": ["string", "null"]}
      }
    }
  }
}
