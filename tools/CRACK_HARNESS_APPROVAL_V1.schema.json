{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CRACK_HARNESS_APPROVAL_V1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "approval_id", "owner", "task_id", "function", "unit", "base_commit", "toolchain_key", "target_sha256", "permit_sha256", "issued_at", "expires_at", "source", "base", "candidate", "function_span", "predicted_rows", "commands", "campaign"],
  "properties": {
    "schema": {"const": "crack_harness_approval/v1"},
    "approval_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,96}$"},
    "owner": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "function": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "unit": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "minLength": 1},
    "toolchain_key": {"const": "b6764a1e5883ea1a096bfe4f8b888b93f1740f0f4046eb6149e0fe1d64cc6d90"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "permit_sha256": {"$ref": "#/$defs/sha"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "source": {"$ref": "#/$defs/file"},
    "base": {"$ref": "#/$defs/file"},
    "candidate": {"$ref": "#/$defs/file"},
    "function_span": {"type": "object", "additionalProperties": false, "required": ["start_line", "end_line", "base_span_sha256"], "properties": {"start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1}, "base_span_sha256": {"$ref": "#/$defs/sha"}}},
    "predicted_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "commands": {"type": "object", "additionalProperties": false, "required": ["precompile", "compile", "strict", "data", "focus", "siblings", "physical", "assess", "record"], "properties": {
      "precompile": {"$ref": "#/$defs/canonical_admission"}, "compile": {"$ref": "#/$defs/compile"},
      "strict": {"$ref": "#/$defs/proof_strict"}, "data": {"$ref": "#/$defs/proof_data"},
      "focus": {"$ref": "#/$defs/proof_focus"}, "siblings": {"$ref": "#/$defs/proof_siblings"},
      "physical": {"$ref": "#/$defs/proof_physical"}, "assess": {"$ref": "#/$defs/assessment"},
      "record": {"$ref": "#/$defs/canonical_record"}
    }},
    "campaign": {"type": "object", "additionalProperties": false, "required": ["id", "quota"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,96}$"}, "quota": {"const": 1}}},
    "limits": {"type": "object", "additionalProperties": false, "properties": {"active_seconds": {"type": "integer", "minimum": 1, "maximum": 1800}, "temporary_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}, "candidates": {"const": 1}}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "binary": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "descriptor": {"type": "object", "additionalProperties": false, "required": ["kind", "argv", "executable", "script"], "properties": {"kind": {"type": "string"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "executable": {"$ref": "#/$defs/binary"}, "script": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/binary"}]}}},
    "canonical_admission": {"allOf": [{"$ref": "#/$defs/descriptor"}, {"properties": {"kind": {"const": "canonical_admission"}}}]},
    "compile": {"allOf": [{"$ref": "#/$defs/descriptor"}, {"properties": {"kind": {"const": "compile"}}}]},
    "proof_strict": {"allOf": [{"$ref": "#/$defs/descriptor"}, {"properties": {"kind": {"const": "proof_strict"}}}]},
    "proof_data": {"allOf": [{"$ref": "#/$defs/descriptor"}, {"properties": {"kind": {"const": "proof_data"}}}]},
    "proof_focus": {"allOf": [{"$ref": "#/$defs/descriptor"}, {"properties": {"kind": {"const": "proof_focus"}}}]},
    "proof_siblings": {"allOf": [{"$ref": "#/$defs/descriptor"}, {"properties": {"kind": {"const": "proof_siblings"}}}]},
    "proof_physical": {"allOf": [{"$ref": "#/$defs/descriptor"}, {"properties": {"kind": {"const": "proof_physical"}}}]},
    "assessment": {"allOf": [{"$ref": "#/$defs/descriptor"}, {"properties": {"kind": {"const": "assessment"}}}]},
    "canonical_record": {"allOf": [{"$ref": "#/$defs/descriptor"}, {"properties": {"kind": {"const": "canonical_record"}}}]}
  }
}
