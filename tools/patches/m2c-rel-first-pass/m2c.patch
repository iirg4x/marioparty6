+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from m2c.options import Formatter
+from m2c.types import StructDeclaration, Type, TypePool
+
+
+class InferredArrayConsumerTests(unittest.TestCase):
+    @staticmethod
+    def inferred(*, size=12, align=1):
+        return StructDeclaration.unknown(
+            TypePool("unk", True), size, "_struct_points_0xC", align=align
+        )
+
+    @staticmethod
+    def point(*, name="Point3d", size=12, align=4):
+        return StructDeclaration(
+            size=size,
+            align=align,
+            new_field_prefix="unk",
+            typedef_name=name,
+            fields=[
+                StructDeclaration.StructField(Type.f32(), i * 4, axis, True)
+                for i, axis in enumerate(("x", "y", "z"))
+            ],
+        )
+
+    def test_empty_stride_type_adopts_consumer_in_both_orders(self):
+        for reverse in (False, True):
+            with self.subTest(reverse=reverse):
+                inferred, known = self.inferred(), self.point()
+                element = Type.struct(inferred)
+                old_binding = Type.struct(inferred)
+                array = Type.array(element, 2)
+                actual, expected = array.reference(), Type.ptr(Type.struct(known))
+                left, right = (expected, actual) if reverse else (actual, expected)
+                self.assertTrue(left.unify(right))
+                self.assertIs(element.get_struct_declaration(), known)
+                self.assertIs(old_binding.get_struct_declaration(), known)
+                self.assertIs(Type.struct(inferred).get_struct_declaration(), known)
+                self.assertEqual(array.to_decl("points", Formatter()), "Point3d points[2]")
+                self.assertEqual([field.name for field in known.fields], ["x", "y", "z"])
+
+    def test_known_records_and_context_forward_declarations_never_merge(self):
+        known = self.point()
+        for other in (
+            self.point(name="Other"),
+            StructDeclaration(12, 4, "unk", tag_name="EmptyKnown"),
+            StructDeclaration(0, 1, "unk", tag_name="Forward"),
+        ):
+            with self.subTest(other=other):
+                self.assertFalse(Type.struct(other).unify(Type.struct(known)))
+                self.assertIs(Type.struct(other).get_struct_declaration(), other)
+                self.assertIs(Type.struct(known).get_struct_declaration(), known)
+
+    def test_conflicting_or_unproven_extent_and_alignment_rejected(self):
+        for size, align in ((16, 1), (None, 1), (12, 8), (12, 2)):
+            with self.subTest(size=size, align=align):
+                inferred, known = self.inferred(size=size, align=align), self.point()
+                self.assertFalse(Type.struct(inferred).unify(Type.struct(known)))
+                self.assertIs(Type.struct(inferred).get_struct_declaration(), inferred)
+
+    def test_observed_fields_stack_and_union_records_rejected(self):
+        for kind in ("field", "bitfield", "stack", "union"):
+            with self.subTest(kind=kind):
+                inferred, known = self.inferred(), self.point()
+                if kind == "field":
+                    inferred.try_add_field(Type.f32(), 0, "unk0", 4)
+                elif kind == "bitfield":
+                    inferred.has_bitfields = True
+                elif kind == "stack":
+                    inferred.is_stack = True
+                else:
+                    inferred.is_union = True
+                self.assertFalse(Type.struct(inferred).unify(Type.struct(known)))
+
+    def test_repeated_reverse_adoption_cannot_create_alias_cycles(self):
+        first, second, known = self.inferred(), self.inferred(), self.point()
+        self.assertFalse(Type.struct(first).unify(Type.struct(second)))
+        self.assertFalse(Type.struct(second).unify(Type.struct(first)))
+        self.assertTrue(Type.struct(first).unify(Type.struct(known)))
+        self.assertTrue(Type.struct(known).unify(Type.struct(first)))
+        self.assertTrue(Type.struct(second).unify(Type.struct(first)))
+        self.assertTrue(Type.struct(first).unify(Type.struct(second)))
+        for record in (first, second, known):
+            self.assertIs(Type.struct(record).get_struct_declaration(), known)
+        other_known = self.point(name="OtherPoint")
+        self.assertFalse(Type.struct(first).unify(Type.struct(other_known)))
+        self.assertIs(Type.struct(first).get_struct_declaration(), known)
+
+    def test_conflicting_array_dimensions_do_not_adopt_element(self):
+        inferred, known = self.inferred(), self.point()
+        self.assertFalse(
+            Type.array(Type.struct(inferred), 2).unify(Type.array(Type.struct(known), 3))
+        )
+        self.assertIs(Type.struct(inferred).get_struct_declaration(), inferred)
+
+    def test_recursive_or_incomplete_consumer_constraints_do_not_adopt(self):
+        inferred, known = self.inferred(), self.point()
+        element = Type.struct(inferred)
+        element.data().new_field_within.add(known)
+        self.assertFalse(element.unify(Type.struct(known)))
+        self.assertIs(element.get_struct_declaration(), inferred)
+        for member_type, offset in ((Type.any(), 0), (Type.f32(), 12)):
+            with self.subTest(offset=offset):
+                inferred, known = self.inferred(), self.point()
+                known.fields = [
+                    StructDeclaration.StructField(member_type, offset, "field", True)
+                ]
+                self.assertFalse(Type.struct(inferred).unify(Type.struct(known)))
+                self.assertIs(Type.struct(inferred).get_struct_declaration(), inferred)
+
+    def test_real_consumer_recovers_array_declaration_and_initializer(self):
+        assembly = """.section .text
+.global sample
+sample:
+    stwu r1, -0x10(r1)
+    mflr r0
+    stw r0, 0x14(r1)
+    mulli r0, r3, 12
+    lis r4, points@ha
+    addi r4, r4, points@l
+    add r4, r4, r0
+    li r3, 7
+    bl set_position
+    lwz r0, 0x14(r1)
+    mtlr r0
+    addi r1, r1, 0x10
+    blr
+.section .data
+.balign 4
+.global points
+points:
+    .4byte 0x3f800000, 0x40000000, 0x40400000
+    .4byte 0x40800000, 0x40a00000, 0x40c00000
+"""
+        context = """typedef struct Point3d { float x, y, z; } Point3d;
+void set_position(int model, Point3d *position);
+void sample(int index);
+"""
+        root = Path(__file__).resolve().parents[2]
+        with tempfile.TemporaryDirectory() as directory:
+            asm_path = Path(directory) / "sample.s"
+            ctx_path = Path(directory) / "ctx.c"
+            asm_path.write_text(assembly, encoding="utf-8")
+            ctx_path.write_text(context, encoding="utf-8")
+            proc = subprocess.run(
+                [sys.executable, str(root / "m2c.py"), "-t", "ppc-mwcc-c",
+                 "--valid-syntax", "--no-cache", "--context", str(ctx_path),
+                 str(asm_path)],
+                capture_output=True, text=True,
+            )
+        self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
+        self.assertIn("Point3d points[2] =", proc.stdout)
+        self.assertIn("1.0f, 2.0f, 3.0f", proc.stdout)
+        self.assertIn("4.0f, 5.0f, 6.0f", proc.stdout)
+        self.assertNotIn("_struct_points", proc.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
