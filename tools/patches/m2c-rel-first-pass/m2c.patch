+def mwcc_empty_switch_tail(
+    context: Context, node: Node, end: Node, bounds: Bounds, selector: Expression
+) -> Optional[int]:
+    """Recognize MWCC's dead exclusive upper bound for one empty last case.
+
+    A noncontiguous empty case retains an equality branch. Do not reinterpret
+    such branches, plain empty gotos, or a range containing several values.
+    The caller also requires three contiguous nonempty cases below this singleton.
+    """
+    if (
+        context.options.target.arch != Target.ArchEnum.PPC
+        or context.options.target.compiler != Target.CompilerEnum.MWCC
+        or not isinstance(node, BasicNode)
+        or not isinstance(end, (ReturnNode, TerminalNode))
+    ):
+        return None
+    exit_node = node.successor
+    # Flow-graph construction may duplicate the common return epilogue.
+    if not isinstance(exit_node, ReturnNode) or not (
+        exit_node is end or exit_node.terminal is end
+    ):
+        return None
+    exit_info = get_block_info(exit_node)
+    if exit_info.statements_to_write() or exit_info.return_value is not None:
+        return None
+    instructions = list(node.block.instructions)
+    if len(instructions) != 2 or [inst.mnemonic for inst in instructions] != ["cmpwi", "b"]:
+        return None
+    comparison = get_block_info(node).final_register_states.get_raw(Register("cr0_lt"))
+    if comparison is None:
+        return None
+    cond = simplify_condition(comparison)
+    if (
+        not isinstance(cond, BinaryOp)
+        or cond.op != "<"
+        or early_unwrap_ints(cond.left) != selector
+        or not isinstance(cond.right, Literal)
+    ):
+        return None
+    values = bounds.at_most(cond.right.value - 1).values(max_count=1)
+    if values is None or len(values) != 1 or values[0] != cond.right.value - 1:
+        return None
+    return values[0]
+
