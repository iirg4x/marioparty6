--- /dev/null
+++ b/tests/unit/test_incomplete_pointer_offsets.py
@@ -0,0 +1,113 @@
+import unittest
+
+from m2c.asm_instruction import Register
+from m2c.evaluate import add_imm, deref, handle_add_real
+from m2c.options import Formatter
+from m2c.translate import BinaryOp, DeferredPointerOffset, GlobalSymbol, Literal
+from m2c.types import StructDeclaration, Type
+from tests.unit import test_pointer_arithmetic as support
+
+
+class TestIncompletePointerOffsets(unittest.TestCase):
+    def test_late_unknown_base_becomes_void_pointer(self):
+        for offset in (16, -16):
+            base = GlobalSymbol('record', Type.intptr())
+            expr = add_imm(Register('r3'), base, Literal(offset),
+                           support.TestPointerArithmetic._args(valid_syntax=True))
+            self.assertIsInstance(expr, DeferredPointerOffset)
+            base.type.unify(Type.ptr(Type.void()))
+            text = expr.format(Formatter(valid_syntax=True))
+            self.assertIn('(u8 *) record', text)
+            self.assertIn('+ 0x10' if offset > 0 else '- 0x10', text)
+            self.assertNotIn('(u8 *)', expr.format(Formatter()))
+            self.assertNotIn('(u8 *)', expr.format(Formatter(valid_syntax=True, skip_casts=True)))
+
+    def test_late_incomplete_record_does_not_invent_fields(self):
+        record = StructDeclaration(size=0, align=1, new_field_prefix='unk', typedef_name='Record')
+        base = GlobalSymbol('record', Type.intptr())
+        expr = add_imm(Register('r3'), base, Literal(16),
+                       support.TestPointerArithmetic._args(valid_syntax=True))
+        base.type.unify(Type.ptr(Type.struct(record)))
+        self.assertIn('(u8 *) record', expr.format(Formatter(valid_syntax=True)))
+        self.assertEqual(record.fields, [])
+        self.assertEqual(record.size, 0)
+
+    def test_late_integer_and_sized_pointer_keep_existing_spelling(self):
+        for final_type in (Type.s32(), Type.ptr(Type.u32())):
+            base = GlobalSymbol('value', Type.intptr())
+            expr = add_imm(Register('r3'), base, Literal(16),
+                           support.TestPointerArithmetic._args(valid_syntax=True))
+            base.type.unify(final_type)
+            self.assertEqual(expr.format(Formatter(valid_syntax=True)), '(value + 0x10)')
+
+    def test_late_unknown_exclusions_keep_binary_expression(self):
+        for options in ({'valid_syntax': False}, {'valid_syntax': True, 'skip_casts': True},
+                        {'valid_syntax': True, 'partial': True}):
+            base = GlobalSymbol('record', Type.intptr())
+            expr = add_imm(Register('r3'), base, Literal(16),
+                           support.TestPointerArithmetic._args(**options))
+            self.assertNotIsInstance(expr, DeferredPointerOffset)
+        base = GlobalSymbol('record', Type.intptr())
+        self.assertIs(add_imm(Register('r3'), base, Literal(0),
+                            support.TestPointerArithmetic._args(valid_syntax=True)), base)
+
+    def test_constant_void_and_incomplete_offsets(self):
+        incomplete = Type.struct(StructDeclaration(
+            size=None, align=4, new_field_prefix='unk', typedef_name='M621Effect'))
+        for type in (Type.ptr(Type.void()), Type.ptr(incomplete)):
+            with self.subTest(type=type):
+                base = GlobalSymbol('record', type)
+                expr = add_imm(Register('r3'), base, Literal(28),
+                               support.TestPointerArithmetic._args(valid_syntax=True))
+                self.assertIsInstance(expr, DeferredPointerOffset)
+                self.assertIn('((u8 *) record + 0x1C)', expr.format(Formatter(valid_syntax=True)))
+                self.assertIsNone(incomplete.get_size_bytes())
+
+    def test_forward_declaration_zero_size_uses_byte_offset(self):
+        # Context forward declarations currently carry a zero-size sentinel.
+        record = StructDeclaration(size=0, align=1, new_field_prefix='unk', typedef_name='M621Effect')
+        base = GlobalSymbol('lbl_1_bss_20', Type.ptr(Type.struct(record)))
+        index = BinaryOp.sint(GlobalSymbol('var_r30', Type.s32()), '*', Literal(4))
+        expr = handle_add_real(base, index, support.TestPointerArithmetic._args(valid_syntax=True))
+        self.assertIsInstance(expr, DeferredPointerOffset)
+        self.assertEqual(expr.format(Formatter(valid_syntax=True)),
+                         '(M621Effect *) ((u8 *) lbl_1_bss_20 + ((s32) var_r30 * 4))')
+        self.assertEqual(record.fields, [])
+
+    def test_indexed_memory_address_bypassing_add_handler_is_typed(self):
+        for width, scale, typename in ((2, 2, 'u16'), (4, 4, 'u32')):
+            with self.subTest(width=width):
+                base = GlobalSymbol('buffer', Type.ptr(Type.void()))
+                index = BinaryOp.sint(GlobalSymbol('index', Type.s32()), '*', Literal(scale))
+                raw_address = BinaryOp.intptr(base, '+', index)
+                args = support.TestPointerArithmetic._args(valid_syntax=True)
+                access = deref(raw_address, {}, args.stack_info, size=width, store=True)
+                access.type.unify(Type.u16() if width == 2 else Type.u32())
+                self.assertEqual(access.format(Formatter(valid_syntax=True)),
+                                 f'*({typename} *) ((u8 *) buffer + ((s32) index * {scale}))')
+
+    def test_indexed_offsets_and_commuted_operands_keep_byte_scale(self):
+        incomplete = Type.struct(StructDeclaration(
+            size=None, align=4, new_field_prefix='unk', typedef_name='M621Effect'))
+        for type, scale in ((Type.ptr(Type.void()), 2), (Type.ptr(incomplete), 4)):
+            for commuted in (False, True):
+                base = GlobalSymbol('buffer', type)
+                index = BinaryOp.sint(GlobalSymbol('index', Type.s32()), '*', Literal(scale))
+                lhs, rhs = (index, base) if commuted else (base, index)
+                expr = handle_add_real(lhs, rhs, support.TestPointerArithmetic._args(valid_syntax=True))
+                self.assertIsInstance(expr, DeferredPointerOffset)
+                text = expr.format(Formatter(valid_syntax=True))
+                self.assertIn('(u8 *) buffer', text)
+                self.assertIn(f'index * {scale}', text)
+                self.assertEqual(expr.format(Formatter()), expr.legacy_expr.format(Formatter()))
+
+    def test_default_skip_casts_partial_and_known_stride_unchanged(self):
+        base = GlobalSymbol('buffer', Type.ptr(Type.void()))
+        for options in ({'valid_syntax': False}, {'valid_syntax': True, 'skip_casts': True},
+                        {'valid_syntax': True, 'partial': True}):
+            expr = add_imm(Register('r3'), base, Literal(28), support.TestPointerArithmetic._args(**options))
+            self.assertNotIsInstance(expr, DeferredPointerOffset)
+            self.assertEqual(expr.format(Formatter()), '(buffer + 0x1C)')
+        expr = add_imm(Register('r3'), GlobalSymbol('words', Type.ptr(Type.u32())),
+                       Literal(16), support.TestPointerArithmetic._args(valid_syntax=True))
+        self.assertEqual(expr.format(Formatter(valid_syntax=True)), '(words + 4)')
