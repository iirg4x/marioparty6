+import subprocess
+import re
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+class StackBookkeepingTests(unittest.TestCase):
+    def translate(self, body, context='void sample(void);', profile='legacy'):
+        root = Path(__file__).resolve().parents[2]
+        assembly = '''.section .text
+.global sample
+sample:
+    stwu r1, -0x40(r1)
+    mflr r0
+    stw r0, 0x44(r1)
+'''+body+'''
+    lwz r0, 0x44(r1)
+    mtlr r0
+    addi r1, r1, 0x40
+    blr
+'''
+        with tempfile.TemporaryDirectory() as tmp:
+            asm, ctx = Path(tmp)/'sample.s', Path(tmp)/'ctx.c'
+            asm.write_text(assembly); ctx.write_text(context)
+            result = subprocess.run([sys.executable, str(root/'m2c.py'), '-t', 'ppc-mwcc-c',
+                '--ppc-abi', profile, '--no-cache', '--context', str(ctx), str(asm)],
+                capture_output=True, text=True)
+        self.assertEqual(result.returncode, 0, result.stdout+result.stderr)
+        return result.stdout
+
+    def test_unused_save_helper_address_does_not_add_argument(self):
+        for profile in ('legacy', 'gekko-eabi'):
+            for frame in (0x30, 0x40, 0x50):
+                # Offset 0x40 matches this synthetic frame; the other offsets
+                # cover an unused local and a genuinely above-frame address.
+                text = self.translate(f'    addi r11, r1, {frame}\n    bl _savegpr_27', profile=profile)
+                self.assertIn('void sample(void)', text)
+                self.assertNotIn('arg_sp', text)
+
+    def test_used_above_frame_load_is_preserved(self):
+        for profile in ('legacy', 'gekko-eabi'):
+            text = self.translate('    addi r4, r1, 0x48\n    lwz r3, 0(r4)',
+                                  'int sample();', profile)
+            self.assertIn('arg_sp8', text)
+            self.assertIn('return arg_sp8;', text)
+
+    def test_used_above_frame_address_passed_to_callee_is_preserved(self):
+        for profile in ('legacy', 'gekko-eabi'):
+            text = self.translate('    addi r3, r1, 0x48\n    bl consume',
+                                  'void consume(int *p); void sample();', profile)
+            self.assertIn('consume(&arg_sp8);', text)
+            self.assertIn('s32 arg_sp8', text)
+
+
+if __name__ == '__main__':
+    if len(sys.argv) == 3 and sys.argv[1] == '--live-root':
+        project = Path(sys.argv[2])
+        translator = Path(__file__).resolve().parents[2]/'m2c.py'
+        context = project/'build/rel-gap-fixes/m657-compiler-acceptance/provider-calls.i'
+        target = project/'build/minigame-recovery-20260913/m657/target.s'
+        command = [sys.executable, str(translator), '-t', 'ppc-mwcc-c', '--ppc-abi', 'gekko-eabi',
+                   '--no-cache', '--context', str(context)]
+        names = ('fn_1_438', 'fn_1_D28', 'fn_1_23F4')
+        for name in names:
+            command += ['-f', name]
+        result = subprocess.run(command+[str(target)], capture_output=True, text=True)
+        assert result.returncode == 0, result.stdout+result.stderr
+        for name in names:
+            signatures = re.findall(r'^void '+name+r'\([^\n]*\)', result.stdout, re.M)
+            assert len(signatures) == 1 and 'arg_sp' not in signatures[0], signatures
+            print(signatures[0])
+        print('saved_reg_r24 remains:', 'saved_reg_r24' in result.stdout)
+    else:
+        unittest.main()
