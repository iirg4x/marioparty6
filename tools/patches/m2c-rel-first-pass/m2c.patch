--- /dev/null
+++ b/tests/unit/test_ppc_extsh_call_only.py
@@ -0,0 +1,79 @@
+"""Outgoing PPC narrow copies must not narrow independent full-width uses."""
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+TRANSLATOR = Path(__file__).resolve().parents[2] / "m2c.py"
+CONTEXT = "short next_short(void); void consumer(int, void *, short);"
+ASSEMBLY = """.section .text
+.global fn_short_call
+fn_short_call:
+    stwu r1, -0x18(r1)
+    mflr r0
+    stw r0, 0x1c(r1)
+    stw r29, 0x14(r1)
+    bl next_short
+    subi r29, r3, 1
+    b .Lshort_test
+.Lshort_body:
+    mulli r3, r29, 36
+    li r4, 0
+    extsh r5, r29
+    bl consumer
+    subi r29, r29, 1
+.Lshort_test:
+    cmpwi r29, 0
+    bge .Lshort_body
+    li r3, 0
+    lwz r29, 0x14(r1)
+    lwz r0, 0x1c(r1)
+    mtlr r0
+    addi r1, r1, 0x18
+    blr
+"""
+
+
+class PpcExtshCallOnlyTests(unittest.TestCase):
+    def generate(self, assembly=ASSEMBLY, context=CONTEXT):
+        with tempfile.TemporaryDirectory() as tmp:
+            asm, ctx = Path(tmp)/"sample.s", Path(tmp)/"context.c"
+            asm.write_text(assembly, encoding="utf-8")
+            ctx.write_text(context, encoding="utf-8")
+            proc = subprocess.run([sys.executable, "-B", str(TRANSLATOR),
+                "-t", "ppc-mwcc-c", "--ppc-abi", "gekko-eabi", "--valid-syntax",
+                "--no-cache", "--context", str(ctx), "-f", "fn_short_call", str(asm)],
+                capture_output=True, text=True, timeout=30)
+        self.assertEqual(proc.returncode, 0, proc.stdout+proc.stderr)
+        self.assertNotIn("Error occurred", proc.stdout)
+        return proc.stdout
+
+    def test_outgoing_copy_does_not_narrow_loop_counter(self):
+        out = self.generate()
+        self.assertRegex(out, r"(?:s32|int) var_r29\b")
+        self.assertNotRegex(out, r"(?:s16|short) var_r29\b")
+        self.assertRegex(out, r"\((?:s16|short)\) var_r29\b")
+        self.assertIn("consumer", out)
+
+    def test_narrow_arithmetic_and_comparison_stay_narrow(self):
+        asm = ASSEMBLY.replace("mulli r3, r29, 36", "extsh r0, r29\n    mulli r3, r0, 36")
+        asm = asm.replace("cmpwi r29, 0", "extsh r0, r29\n    cmpwi r0, 0")
+        self.assertRegex(self.generate(asm), r"(?:s16|short) var_r29\b")
+
+    def test_byte_call_conversion_preserves_full_width_counter(self):
+        asm = ASSEMBLY.replace("extsh r5, r29", "extsb r5, r29")
+        out = self.generate(asm, CONTEXT.replace("void *, short", "void *, signed char"))
+        self.assertRegex(out, r"(?:s32|int) var_r29\b")
+        self.assertRegex(out, r"\((?:s8|signed char)\) var_r29\b")
+
+    def test_context_short_storage_stays_short(self):
+        asm = ASSEMBLY.replace("li r3, 0\n    lwz r29", "lis r3, result@ha\n    sth r29, result@l(r3)\n    li r3, 0\n    lwz r29")
+        out = self.generate(asm, CONTEXT+"\nextern short result;")
+        self.assertIn("result =", out)
+        self.assertNotIn("extern s32 result", out)
+        self.assertNotIn("extern int result", out)
+
+
+if __name__ == "__main__":
+    unittest.main()
