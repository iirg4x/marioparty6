+        if mode == 'before':
+            from m2c.arch_ppc import PpcArch
+            PpcArch.filter_variadic_registers = lambda *args: None
+        sys.argv = ['m2c']+sys.argv[3:]
+        from m2c.main import main
+        main()
+    elif len(sys.argv) == 3 and sys.argv[1] == '--live-root':
+        project = Path(sys.argv[2])
+        context = project/'build/rel-gap-fixes/m657-compiler-acceptance-final/provider-calls.i'
+        target = project/'build/rel-first-compile-20260913/inputs/m657Dll.s'
+        outputs = {}
+        for mode in ('before', 'after'):
+            result = subprocess.run([sys.executable, __file__, '--decompile', mode,
+                '-t', 'ppc-mwcc-c', '--ppc-abi', 'gekko-eabi', '--valid-syntax', '--no-cache',
+                '--context', str(context), '-f', 'fn_1_D28', '-f', 'fn_1_47EC', str(target)],
+                capture_output=True, text=True)
