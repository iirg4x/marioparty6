+++ b/tests/unit/test_stack_array_extent.py
@@ -0,0 +1,251 @@
+"""Bounded stack-array inference; no retail input is needed by the unit tests."""
+
+import argparse
+import hashlib
+import json
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+TRANSLATOR = Path(__file__).resolve().parents[2] / "m2c.py"
+CONTEXT = "int produce(short); int sample(int); void consume(int *);"
+ASSEMBLY = """.section .text
+.global sample
+sample:
+    stwu r1, -0x30(r1)
+    mflr r0
+    stw r0, 0x34(r1)
+    stw r30, 0x28(r1)
+    stw r29, 0x24(r1)
+    mr r29, r3
+    li r0, 77
+    stw r0, 0x18(r1)
+    li r30, 0
+    b .Ltest
+.Lbody:
+    extsh r3, r30
+    bl produce
+    extsh r0, r30
+    slwi r0, r0, 2
+    addi r4, r1, 0x10
+    stwx r3, r4, r0
+    addi r30, r30, 1
+.Ltest:
+    extsh r0, r30
+    cmpwi r0, 2
+    blt .Lbody
+    lwz r3, 0x10(r1)
+    lwz r0, 0x14(r1)
+    add r3, r3, r0
+    lwz r0, 0x18(r1)
+    add r3, r3, r0
+    lwz r29, 0x24(r1)
+    lwz r30, 0x28(r1)
+    lwz r0, 0x34(r1)
+    mtlr r0
+    addi r1, r1, 0x30
+    blr
+"""
+
+
+def decompile(
+    asm_path, context_path, *, translator=TRANSLATOR, extra=(), function="sample"
+):
+    argv = [
+        sys.executable,
+        "-B",
+        str(translator),
+        "-t",
+        "ppc-mwcc-c",
+        "--ppc-abi",
+        "gekko-eabi",
+        "--valid-syntax",
+        "--no-cache",
+        "--context",
+        str(context_path),
+        "-f",
+        function,
+        *extra,
+        str(asm_path),
+    ]
+    proc = subprocess.run(argv, capture_output=True, text=True, timeout=30)
+    return argv, proc
+
+
+class StackArrayExtentTests(unittest.TestCase):
+    def generate(self, assembly=ASSEMBLY, context=CONTEXT, extra=()):
+        with tempfile.TemporaryDirectory() as directory:
+            asm_path, ctx_path = (
+                Path(directory) / "sample.s",
+                Path(directory) / "context.c",
+            )
+            asm_path.write_text(assembly, encoding="utf-8")
+            ctx_path.write_text(context, encoding="utf-8")
+            _, proc = decompile(asm_path, ctx_path, extra=extra)
+        self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
+        return proc.stdout
+
+    def test_bounded_write_coalesces_fixed_load_and_preserves_neighbor(self):
+        output = self.generate()
+        self.assertIn("s32 sp10[2];", output)
+        self.assertIn("sp10[1]", output)
+        self.assertNotIn("sp14", output)
+        self.assertIn("s32 sp18;", output)
+        self.assertIn("sp18 = 0x4D;", output)
+
+    def test_extent_is_taken_from_the_bound_not_hardcoded(self):
+        output = self.generate(ASSEMBLY.replace("cmpwi r0, 2", "cmpwi r0, 3"))
+        self.assertIn("s32 sp10[3];", output)
+        self.assertIn("sp10[2]", output)
+        self.assertNotIn("sp18", output)
+
+    def test_adjacency_without_indexed_store_does_not_make_array(self):
+        output = self.generate(ASSEMBLY.replace("stwx r3, r4, r0", "stw r3, 0x10(r1)"))
+        self.assertNotIn("sp10[", output)
+        self.assertIn("s32 sp14;", output)
+
+    def test_unknown_start_is_not_a_zero_based_range(self):
+        output = self.generate(ASSEMBLY.replace("li r30, 0", "mr r30, r29"))
+        self.assertIn("sp10[];", output)
+        self.assertIn("sp14;", output)
+
+    def test_nonunit_step_is_not_a_complete_range(self):
+        output = self.generate(ASSEMBLY.replace("addi r30, r30, 1", "addi r30, r30, 2"))
+        self.assertIn("sp10[];", output)
+
+    def test_index_must_be_the_tested_induction_value(self):
+        output = self.generate(
+            ASSEMBLY.replace("extsh r0, r30\n    slwi", "extsh r0, r29\n    slwi")
+        )
+        self.assertIn("sp10[];", output)
+
+    def test_overflowing_narrow_counter_is_not_a_bounded_range(self):
+        output = self.generate(ASSEMBLY.replace("cmpwi r0, 2", "cmplwi r0, 32768"))
+        self.assertIn("sp10[];", output)
+
+    def test_byte_overlap_is_not_absorbed(self):
+        output = self.generate(
+            ASSEMBLY.replace("li r30, 0", "stb r0, 0x15(r1)\n    li r30, 0")
+        )
+        self.assertIn("sp10[];", output)
+
+    def test_escaped_base_and_neighbor_block_inference(self):
+        for offset in ("0x8", "0x10", "0x14"):
+            with self.subTest(offset=offset):
+                output = self.generate(
+                    ASSEMBLY.replace(
+                        "li r30, 0",
+                        f"addi r3, r1, {offset}\n    bl consume\n    li r30, 0",
+                    )
+                )
+                self.assertNotIn("sp10[2];", output)
+
+    def test_another_unbounded_indexed_use_blocks_extent(self):
+        output = self.generate(
+            ASSEMBLY.replace(
+                "    lwz r3, 0x10(r1)",
+                "    slwi r0, r29, 2\n    addi r4, r1, 0x10\n    stwx r3, r4, r0\n    lwz r3, 0x10(r1)",
+            )
+        )
+        self.assertIn("sp10[];", output)
+
+    def test_indexed_element_address_escape_blocks_extent(self):
+        output = self.generate(
+            ASSEMBLY.replace(
+                "stwx r3, r4, r0",
+                "stwx r3, r4, r0\n    add r3, r4, r0\n    bl consume",
+            )
+        )
+        self.assertNotIn("sp10[2];", output)
+
+    def test_raw_stack_pointer_escape_blocks_inference(self):
+        output = self.generate(
+            ASSEMBLY.replace("li r30, 0", "mr r3, r1\n    bl consume\n    li r30, 0")
+        )
+        self.assertIn("sp10[];", output)
+
+    def test_context_array_and_neighbor_are_not_overwritten(self):
+        context = (
+            CONTEXT
+            + """
+struct _m2c_stack_sample {
+    char reserved[16];
+    int entries[1];
+    int neighbor;
+    int tail;
+    char end[20];
+};
+"""
+        )
+        output = self.generate(context=context)
+        self.assertIn("s32 entries[1];", output)
+        self.assertNotIn("entries[2];", output)
+        self.assertIn("s32 neighbor;", output)
+
+    def test_single_pass_does_not_change_cached_field_paths(self):
+        output = self.generate(extra=("--passes", "1"))
+        self.assertIn("sp10[];", output)
+        self.assertIn("sp14;", output)
+
+
+def replay(root, baseline):
+    """Optional real target replay. Artifacts stay in this scratch checkout."""
+    asm_path = root / "build/minigame-recovery-20260913/m657/fn_1_D28.s"
+    ctx_path = root / "build/minigame-recovery-20260913/m657/context.i"
+    destination = TRANSLATOR.parent / "stack-array-replay"
+    destination.mkdir(exist_ok=True)
+    record = {
+        "inputs": {
+            str(path): hashlib.sha256(path.read_bytes()).hexdigest()
+            for path in (asm_path, ctx_path)
+        },
+        "runs": {},
+    }
+    for label, translator in (("before", baseline), ("after", TRANSLATOR)):
+        argv, proc = decompile(
+            asm_path, ctx_path, translator=translator, function="fn_1_D28"
+        )
+        path = destination / (label + ".c")
+        path.write_text(proc.stdout, encoding="utf-8")
+        record["runs"][label] = {
+            "argv": argv,
+            "exit": proc.returncode,
+            "stderr": proc.stderr,
+            "source": str(path),
+            "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+            "translator_sha256": {
+                str(source): hashlib.sha256(source.read_bytes()).hexdigest()
+                for source in (
+                    translator,
+                    translator.parent / "m2c/main.py",
+                    translator.parent / "m2c/translate.py",
+                )
+            },
+        }
+        if proc.returncode:
+            raise RuntimeError(proc.stdout + proc.stderr)
+        if label == "after":
+            assert "s32 sp10[2];" in proc.stdout and "sp14" not in proc.stdout
+            assert "sp10[1]" in proc.stdout
+    assert record["inputs"] == {
+        str(path): hashlib.sha256(path.read_bytes()).hexdigest()
+        for path in (asm_path, ctx_path)
+    }, "Live inputs changed during replay"
+    (destination / "replay.json").write_text(
+        json.dumps(record, indent=2), encoding="utf-8"
+    )
+    print(json.dumps(record, indent=2))
+
+
+if __name__ == "__main__":
+    if "--live-root" in sys.argv:
+        parser = argparse.ArgumentParser()
+        parser.add_argument("--live-root", type=Path, required=True)
+        parser.add_argument("--baseline", type=Path, required=True)
+        args = parser.parse_args()
+        replay(args.live_root, args.baseline)
+    else:
+        unittest.main()
