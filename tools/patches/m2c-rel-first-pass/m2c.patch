+def ppc_float_compare(left: Expression, op: str, right: Expression) -> BinaryOp:
+    # Unlike MIPS c.*.s/c.*.d, PPC fcmp[u/o] does not select an operand
+    # precision. Both lfs- and lfd-produced values are compared as held in
+    # the FPRs. Constrain floatness separately, without narrowing a known
+    # double or making an unknown-width producer inherit its peer's width.
+    return BinaryOp(
+        left=as_type(left, Type.floatish(), True),
+        op=op,
+        right=as_type(right, Type.floatish(), True),
+        type=Type.boolean(),
+    )
