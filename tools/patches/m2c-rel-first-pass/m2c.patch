diff --git a/tests/unit/test_empty_switch_tail.py b/tests/unit/test_empty_switch_tail.py
new file mode 100644
--- /dev/null
+++ b/tests/unit/test_empty_switch_tail.py
@@ -0,0 +1,136 @@
+"""Portable regression coverage for MWCC's dead switch-tail comparison."""
+
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+TRANSLATOR = Path(__file__).resolve().parents[2] / "m2c.py"
+ASSEMBLY = """.section .text
+.global sample
+sample:
+    stwu r1, -0x10(r1)
+    mflr r0
+    stw r0, 0x14(r1)
+    stw r31, 0xc(r1)
+    mr r31, r3
+    lha r0, 0(r31)
+    cmpwi r0, 2
+    beq .Lcase2
+    bge .Ltail
+    cmpwi r0, 0
+    beq .Lcase0
+    bge .Lcase1
+    b .Lend
+.Ltail:
+    cmpwi r0, 4
+    b .Lend
+.Lcase0:
+    lha r3, 0(r31)
+    addi r0, r3, 1
+    sth r0, 0(r31)
+    b .Lend
+.Lcase1:
+    lha r3, 0(r31)
+    addi r0, r3, 1
+    sth r0, 0(r31)
+    b .Lend
+.Lcase2:
+    bl action
+.Lend:
+    lwz r31, 0xc(r1)
+    lwz r0, 0x14(r1)
+    mtlr r0
+    addi r1, r1, 0x10
+    blr
+"""
+
+
+class EmptySwitchTailTests(unittest.TestCase):
+    def generate(self, asm=ASSEMBLY, target="ppc-mwcc-c"):
+        with tempfile.TemporaryDirectory() as directory:
+            assembly, context = (
+                Path(directory) / "sample.s",
+                Path(directory) / "context.c",
+            )
+            assembly.write_text(asm, encoding="utf-8")
+            context.write_text(
+                "void sample(short *); void action(void);", encoding="utf-8"
+            )
+            proc = subprocess.run(
+                [
+                    sys.executable,
+                    "-B",
+                    str(TRANSLATOR),
+                    "-t",
+                    target,
+                    "--no-cache",
+                    "--valid-syntax",
+                    "--context",
+                    str(context),
+                    str(assembly),
+                ],
+                capture_output=True,
+                text=True,
+                timeout=30,
+            )
+        self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
+        return proc.stdout
+
+    def test_exact_dispatch_retains_empty_case_three(self):
+        output = self.generate()
+        self.assertIn("case 3:\n        break;", output)
+        self.assertIn("case 0:", output)
+        self.assertIn("case 1:", output)
+        self.assertIn("case 2:", output)
+
+    def test_explicit_noncontiguous_case_four_is_not_changed_to_three(self):
+        output = self.generate(
+            ASSEMBLY.replace(
+                "cmpwi r0, 4\n    b .Lend", "cmpwi r0, 4\n    beq .Lend\n    b .Lend"
+            )
+        )
+        self.assertIn("case 4:", output)
+        self.assertNotIn("case 3:", output)
+
+    def test_dead_tail_without_compare_has_no_inferred_case(self):
+        output = self.generate(ASSEMBLY.replace("    cmpwi r0, 4\n", ""))
+        self.assertNotIn("case 3:", output)
+
+    def test_nonsingleton_tail_range_is_left_unresolved(self):
+        output = self.generate(ASSEMBLY.replace("cmpwi r0, 4", "cmpwi r0, 5"))
+        self.assertNotIn("case 3:", output)
+        self.assertNotIn("case 4:", output)
+
+    def test_other_selector_is_not_a_bound(self):
+        output = self.generate(ASSEMBLY.replace("cmpwi r0, 4", "cmpwi r31, 4"))
+        self.assertNotIn("case 3:", output)
+
+    def test_noncontiguous_recovered_cases_do_not_imply_a_terminal_label(self):
+        assembly = ASSEMBLY.replace("cmpwi r0, 2", "cmpwi r0, 5").replace(
+            "cmpwi r0, 4", "cmpwi r0, 7"
+        )
+        assembly = assembly.replace(
+            "    bge .Lcase1", "    cmpwi r0, 2\n    beq .Lcase1"
+        )
+        output = self.generate(assembly)
+        self.assertIn("case 5:", output)
+        self.assertNotIn("case 6:", output)
+
+    def test_tail_effect_is_preserved_not_turned_into_break(self):
+        output = self.generate(
+            ASSEMBLY.replace("cmpwi r0, 4", "sth r0, 2(r31)\n    cmpwi r0, 4")
+        )
+        self.assertNotIn("case 3:", output)
+        self.assertIn("M2C_FIELD(arg0, s16 *, 2) = temp_r0;", output)
+
+    def test_other_compiler_does_not_inherit_mwcc_rule(self):
+        output = self.generate(target="ppc-gcc-c")
+        self.assertNotIn("case 3:", output)
+
+
+if __name__ == "__main__":
+    unittest.main()
+
diff --git a/tests/unit/test_incomplete_pointer_offsets.py b/tests/unit/test_incomplete_pointer_offsets.py
