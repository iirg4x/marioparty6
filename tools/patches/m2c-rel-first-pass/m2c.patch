+import unittest
+
+from m2c.c_types import TypeMap, basic_type
+from m2c.options import Formatter
+from m2c.types import Type, TypePool
+
+
+class PlainCharTests(unittest.TestCase):
+    def ctype(self, *names):
+        return Type.ctype(basic_type(list(names)), TypeMap('', 4), TypePool('unk', False))
+
+    def test_context_char_pointer_and_array_survive(self):
+        char = self.ctype('char')
+        self.assertEqual(Type.ptr(char).to_decl('p', Formatter()), 'char *p')
+        self.assertEqual(Type.array(char, 18).to_decl('s', Formatter()), 'char s[0x12]')
+
+    def test_explicit_signed_and_unsigned_remain_distinct(self):
+        self.assertEqual(self.ctype('signed', 'char').format(Formatter()), 's8')
+        self.assertEqual(self.ctype('unsigned', 'char').format(Formatter()), 'u8')
+        self.assertFalse(Type.s8().unify(Type.u8()))
+
+    def test_plain_char_survives_union_find_in_both_orders(self):
+        for reverse in (False, True):
+            char, inferred = self.ctype('char'), Type.int_of_size(8)
+            self.assertTrue(char.unify(inferred) if reverse else inferred.unify(char))
+            self.assertEqual(char.format(Formatter()), 'char')
+            self.assertEqual(inferred.format(Formatter()), 'char')
+
+    def test_not_a_universal_byte_rewrite(self):
+        self.assertEqual(Type.int_of_size(8).format(Formatter()), 's8')
+        self.assertFalse(self.ctype('char').unify(Type.s32()))
+
+
+if __name__ == '__main__':
+    unittest.main()
