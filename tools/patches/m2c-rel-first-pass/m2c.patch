+def needs_byte_pointer_offset(type: Type) -> bool:
+    """Object pointers without a C element size still have machine byte offsets."""
+    if not type.is_pointer():
+        return False
+    target = type.get_pointer_target()
+    return target is None or target.is_void() or (
+        target.is_struct() and not target.get_size_bytes()
+    )
