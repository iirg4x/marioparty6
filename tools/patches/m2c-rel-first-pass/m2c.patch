+import contextlib
+import io
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from m2c.arch_ppc import PpcArch, PpcGekkoArch
+from m2c.asm_instruction import Register
+from m2c.error import DecompFailure
+from m2c.main import parse_flags
+from m2c.options import Options
+from m2c.types import FunctionParam, FunctionSignature, Type
+
+
+def signature(types, variadic=False):
+    return FunctionSignature(return_type=Type.void(), params_known=True,
+                             params=[FunctionParam(type=t) for t in types],
+                             is_variadic=variadic)
+
+
+def locations(arch, types, for_call=True):
+    slots = arch.function_abi(signature(types), {}, for_call=for_call).arg_slots
+    return [slot.loc.reg.register_name if slot.loc.reg else slot.loc.offset
+            for slot in slots]
+
+
+class PpcGekkoAbiTests(unittest.TestCase):
+    def test_ninth_float_is_stack8_for_call_and_callee(self):
+        for for_call in (False, True):
+            types = [Type.s32()] + [Type.f32() for _ in range(10)]
+            self.assertEqual(locations(PpcGekkoArch, types, for_call),
+                             ['r3'] + [f'f{i}' for i in range(1, 9)] + [8, 12])
+            self.assertEqual(locations(PpcArch, types, for_call),
+                             ['r3'] + [f'f{i}' for i in range(1, 11)])
+
+    def test_no_gpr_shadow_for_float_register_arguments(self):
+        types = [Type.f32(), Type.s32(), Type.f64(), Type.s32()]
+        self.assertEqual(locations(PpcGekkoArch, types), ['f1', 'r3', 'f2', 'r4'])
+        self.assertEqual(locations(PpcArch, types), ['f1', 'r3', 'f2', 'r4'])
+        types = [Type.s32() for _ in range(9)] + [Type.f32() for _ in range(9)]
+        self.assertEqual(locations(PpcGekkoArch, types),
+                         [f'r{i}' for i in range(3, 11)] + [8] +
+                         [f'f{i}' for i in range(1, 9)] + [12])
+
+    def test_unimplemented_nonword_overflow_fails_closed(self):
+        types = [Type.f64() for _ in range(9)]
+        with self.assertRaisesRegex(DecompFailure, 'word-sized stack argument'):
+            locations(PpcGekkoArch, types)
+        self.assertEqual(locations(PpcArch, types), [f'f{i}' for i in range(1, 10)])
+
+    def test_f9_f13_not_arguments_but_still_clobbered(self):
+        likely = {reg: True for reg in PpcArch.argument_regs}
+        for sig in (FunctionSignature(), signature([], variadic=True)):
+            abi = PpcGekkoArch.function_abi(sig, likely, for_call=True)
+            regs = [slot.loc.reg for slot in abi.possible_slots]
+            self.assertNotIn(Register('f9'), regs)
+            self.assertIn(Register('f8'), regs)
+        for i in range(9, 14):
+            self.assertIn(Register(f'f{i}'), PpcGekkoArch.temp_regs)
+            self.assertNotIn(Register(f'f{i}'), PpcGekkoArch.saved_regs)
+
+    def test_option_is_explicit_and_rejects_non_ppc(self):
+        options = parse_flags(['-t', 'ppc-mwcc-c', 'dummy.s'])
+        self.assertEqual(options.ppc_abi, Options.PpcAbiEnum.LEGACY)
+        options = parse_flags(['-t', 'ppc-mwcc-c', '--ppc-abi', 'gekko-eabi', 'dummy.s'])
+        self.assertEqual(options.ppc_abi, Options.PpcAbiEnum.GEKKO_EABI)
+        with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit):
+            parse_flags(['--ppc-abi', 'gekko-eabi', 'dummy.s'])
+
+    def decompile_call(self, store='stfs f0, 8(r1)', profile='gekko-eabi', count=9,
+                       after='', extra_context=''):
+        root = Path(__file__).resolve().parents[2]
+        params = ', '.join(['int'] + ['float'] * count)
+        context = (f'void sink({params});\nvoid barrier(void);\n'
+                   'int scalar(void);\nvoid caller(void);\n' + extra_context)
+        asm = '''.section .text
+.global caller
+caller:
+    stwu r1, -32(r1)
+    mflr r0
+    stw r0, 36(r1)
+    lis r4, values@ha
+    addi r4, r4, values@l
+    lfs f0, 0(r4)
+    STORE
+    li r3, 1
+    lis r4, values@ha
+    addi r4, r4, values@l
+    LOADS
+    bl sink
+    AFTER
+    lwz r0, 36(r1)
+    mtlr r0
+    addi r1, r1, 32
+    blr
+.section .rodata
+.global values
+values:
+    .float 9.0
+    .float 2.0
+'''
+        loads = '\n    '.join(f'lfs f{i}, 0(r4)' for i in range(1, 9))
+        asm = asm.replace('STORE', store).replace('LOADS', loads).replace('AFTER', after)
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory)
+            (path / 'input.s').write_text(asm)
+            (path / 'context.h').write_text(context)
+            cmd = [sys.executable, str(root / 'm2c.py'), '-t', 'ppc-mwcc-c',
+                   '--no-cache', '--valid-syntax', '--context', str(path / 'context.h'),
+                   '--ppc-abi', profile, str(path / 'input.s')]
+            proc = subprocess.run(cmd, capture_output=True, text=True)
+            self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
+            return proc.stdout
+
+    def test_outgoing_ninth_float_consumes_existing_stack_store(self):
+        result = self.decompile_call()
+        self.assertNotIn('M2C_ERROR', result)
+        self.assertNotIn('sp8', result)
+        self.assertIn('9.0f, 9.0f);', result)
+        legacy = self.decompile_call(profile='legacy')
+        self.assertIn('Read from unset register $f9', legacy)
+
+    def test_incoming_ninth_float_maps_to_named_stack_parameter(self):
+        root = Path(__file__).resolve().parents[2]
+        context = 'float incoming(int mask, ' + ', '.join(
+            f'float a{i}' for i in range(1, 10)) + ');\n'
+        asm = '.section .text\n.global incoming\nincoming:\n    lfs f1, 8(r1)\n    blr\n'
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory)
+            (path / 'input.s').write_text(asm)
+            (path / 'context.h').write_text(context)
+            proc = subprocess.run(
+                [sys.executable, str(root / 'm2c.py'), '-t', 'ppc-mwcc-c',
+                 '--no-cache', '--valid-syntax', '--ppc-abi', 'gekko-eabi',
+                 '--context', str(path / 'context.h'), str(path / 'input.s')],
+                capture_output=True, text=True)
+            self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
+            self.assertNotIn('M2C_ERROR', proc.stdout)
+            self.assertIn('return a9;', proc.stdout)
+
+    def test_missing_or_stale_stack_store_retains_diagnostic(self):
+        for store in ('', 'stfs f0, 12(r1)', 'stfs f0, 8(r1)\n    bl barrier',
+                      'stfd f0, 8(r1)'):
+            with self.subTest(store=store):
+                result = self.decompile_call(store=store)
+                self.assertIn('Unable to find stack arg 0x8 in block', result)
+
+    def test_stored_integer_bits_are_reinterpreted_not_numeric_conversion(self):
+        result = self.decompile_call(store='bl scalar\n    stw r3, 8(r1)')
+        self.assertNotIn('M2C_ERROR', result)
+        self.assertIn('M2C_BITWISE(f32, sp8)', result)
+        self.assertNotIn('(f32) sp8', result)
+
+    def test_stable_local_copy_is_consumed_without_second_stack_owner(self):
+        store = ('lwz r5, 0(r4)\n    stw r5, 16(r1)\n'
+                 '    lfs f0, 16(r1)\n    stfs f0, 8(r1)')
+        result = self.decompile_call(store=store)
+        self.assertNotIn('M2C_ERROR', result)
+        self.assertNotIn('sp8', result)
+        self.assertIn('9.0f, sp10);', result)
+
+    def test_mutation_and_alias_ambiguity_keep_explicit_snapshot(self):
+        copy = ('lwz r5, 0(r4)\n    stw r5, 16(r1)\n'
+                '    lfs f0, 16(r1)\n    stfs f0, 8(r1)')
+        cases = [
+            (copy + '\n    lfs f0, 4(r4)\n    stfs f0, 16(r1)', ''),
+            (copy + '\n    stw r5, 20(r1)', ''),
+            (copy + '\n    addi r5, r1, 8', ''),
+            (copy + '\n    addi r5, r1, 16', ''),
+            (copy + '\n    addi r5, r1, 17', ''),
+            (copy + '\n    mr r5, r1', ''),
+            (copy, 'lfs f0, 8(r1)'),
+        ]
+        for store, after in cases:
+            with self.subTest(store=store, after=after):
+                result = self.decompile_call(store=store, after=after)
+                self.assertNotIn('M2C_ERROR', result)
+                self.assertIn('sp8 = sp10;', result)
+                self.assertIn('9.0f, sp8);', result)
+
+    def test_partial_mutation_before_outgoing_copy_preserves_original_load(self):
+        setup = ('lwz r5, 0(r4)\n    stw r5, 16(r1)\n'
+                 '    lfs f0, 16(r1)\n    li r5, 0\n    ')
+        for mutation in ('stb r5, 17(r1)',
+                         'addi r6, r1, 17\n    stb r5, 0(r6)'):
+            with self.subTest(mutation=mutation):
+                result = self.decompile_call(
+                    store=setup + mutation + '\n    stfs f0, 8(r1)')
+                self.assertNotIn('M2C_ERROR', result)
+                self.assertIn('temp_f0 = sp10;', result)
+                self.assertIn('sp8 = temp_f0;', result)
+                self.assertIn('9.0f, sp8);', result)
+                self.assertLess(result.index('temp_f0 = sp10;'),
+                                result.index('sp8 = temp_f0;'))
+                self.assertLess(result.index('temp_f0 = sp10;'),
+                                result.index('M2C_FIELD(&sp10'))
+
+    def test_call_between_load_and_copy_keeps_the_original_capture(self):
+        store = ('lwz r5, 0(r4)\n    stw r5, 16(r1)\n'
+                 '    stfd f14, 24(r1)\n    lfs f14, 16(r1)\n'
+                 '    bl barrier\n    stfs f14, 8(r1)')
+        result = self.decompile_call(store=store, after='lfd f14, 24(r1)')
+        self.assertNotIn('M2C_ERROR', result)
+        self.assertIn('temp_f14 = sp10;', result)
+        self.assertIn('sp8 = temp_f14;', result)
+        self.assertIn('9.0f, sp8);', result)
+        self.assertLess(result.index('temp_f14 = sp10;'), result.index('barrier();'))
+
+    def test_unconsumed_store_keeps_its_existing_declaration(self):
+        result = self.decompile_call(store='stfs f0, 8(r1)\n    stfs f0, 8(r1)')
+        self.assertNotIn('M2C_ERROR', result)
+        self.assertIn('f32 sp8;', result)
+        self.assertEqual(result.count('sp8 = 9.0f;'), 1)
+        self.assertIn('9.0f, 9.0f);', result)
+
+    def test_named_stack_aggregate_is_not_replaced_by_an_outgoing_scalar(self):
+        context = ('struct _m2c_stack_caller { char reserved[8]; '
+                   'float outgoing[2]; char padding[16]; };')
+        result = self.decompile_call(extra_context=context)
+        self.assertNotIn('M2C_ERROR', result)
+        self.assertIn('f32 outgoing[2];', result)
+        self.assertIn('outgoing[0] = 9.0f;', result)
+        self.assertIn('9.0f, outgoing[0]);', result)
+
+    def test_eight_float_control_is_identical_between_profiles(self):
+        self.assertEqual(self.decompile_call(store='', count=8),
+                         self.decompile_call(store='', count=8, profile='legacy'))
+
+
+if __name__ == '__main__':
+    unittest.main()
