+++ b/tests/unit/test_ppc_float_compare_precision.py
@@ -0,0 +1,145 @@
+import struct
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+from m2c.arch_ppc import PpcArch, ppc_float_compare
+from m2c.options import Formatter
+from m2c.translate import BinaryOp, Cast, GlobalSymbol, Literal
+from m2c.types import Type
+
+
+class PpcFloatComparePrecisionTests(unittest.TestCase):
+    def test_known_operand_precisions_are_independent(self) -> None:
+        for left_bits, right_bits in ((32, 32), (64, 64), (32, 64), (64, 32)):
+            with self.subTest(left=left_bits, right=right_bits):
+                left = GlobalSymbol("left", Type.f32() if left_bits == 32 else Type.f64())
+                right = GlobalSymbol("right", Type.f32() if right_bits == 32 else Type.f64())
+                result = ppc_float_compare(left, "<", right)
+                self.assertIs(result.left, left)
+                self.assertIs(result.right, right)
+                self.assertEqual(left.type.get_size_bits(), left_bits)
+                self.assertEqual(right.type.get_size_bits(), right_bits)
+                self.assertEqual(result.format(Formatter()), "(left < right)")
+                self.assertTrue(result.is_floating())
+
+    def test_double_literal_bits_and_width_are_preserved(self) -> None:
+        for value in (0.001, 0.000001, 1.0):
+            with self.subTest(value=value):
+                bits = int.from_bytes(struct.pack(">d", value), "big")
+                literal = Literal(bits, Type.f64())
+                result = ppc_float_compare(GlobalSymbol("value", Type.f32()), "==", literal)
+                self.assertIsInstance(result.right, Literal)
+                self.assertEqual(result.right.value, bits)
+                self.assertEqual(result.right.type.get_size_bits(), 64)
+                self.assertNotIn("bitwise", result.format(Formatter()).lower())
+                self.assertNotIsInstance(result.right, Cast)
+
+    def test_unknown_precision_is_not_inferred_from_peer(self) -> None:
+        unknown = GlobalSymbol("unknown", Type.any_reg())
+        known = GlobalSymbol("known", Type.f64())
+        result = ppc_float_compare(unknown, "<", known)
+        self.assertTrue(unknown.type.is_float())
+        self.assertIsNone(unknown.type.get_size_bits())
+        self.assertEqual(known.type.get_size_bits(), 64)
+        self.assertTrue(unknown.type.unify(Type.f32()))
+        self.assertEqual(result.left.type.get_size_bits(), 32)
+        self.assertEqual(result.right.type.get_size_bits(), 64)
+
+    def test_mixed_literal_comparisons_keep_bits_for_both_operand_orders(self) -> None:
+        for value_bits, literal_bits in ((32, 64), (64, 32)):
+            for op in ("==", "!=", "<", ">", "<=", ">="):
+                for reverse in (False, True):
+                    with self.subTest(value=value_bits, literal=literal_bits, op=op, reverse=reverse):
+                        value = GlobalSymbol("value", Type.f32() if value_bits == 32 else Type.f64())
+                        bits = int.from_bytes(struct.pack(">f" if literal_bits == 32 else ">d", 0.001), "big")
+                        literal = Literal(bits, Type.f32() if literal_bits == 32 else Type.f64())
+                        left, right = (literal, value) if reverse else (value, literal)
+                        result = ppc_float_compare(left, op, right)
+                        formatted_op = op.translate(str.maketrans("<>", "><")) if reverse else op
+                        expected = "0.001f" if literal_bits == 32 else "0.001"
+                        self.assertEqual(result.format(Formatter()), f"(value {formatted_op} {expected})")
+                        self.assertEqual(literal.value, bits)
+                        self.assertEqual(literal.type.get_size_bits(), literal_bits)
+                        self.assertEqual(value.type.get_size_bits(), value_bits)
+
+    def test_ordered_negation_keeps_unordered_semantics(self) -> None:
+        result = ppc_float_compare(GlobalSymbol("left", Type.f32()), "<",
+                                   GlobalSymbol("right", Type.f64()))
+        self.assertEqual(result.negated().format(Formatter()), "!(left < right)")
+
+    def test_ppc_compare_emitters_preserve_precision_and_ordered_predicates(self) -> None:
+        class Args:
+            def __init__(self):
+                self.values = {1: GlobalSymbol("left", Type.f64()),
+                               2: GlobalSymbol("right", Type.f32())}
+
+            def reg(self, index):
+                return self.values[index]
+
+        for mnemonic, equality in (("fcmpu", "=="), ("fcmpo", "=="),
+                                   ("fcmpo.lte.fictive", "<="),
+                                   ("fcmpo.gte.fictive", ">=")):
+            with self.subTest(mnemonic=mnemonic):
+                result = PpcArch.instrs_ppc_compare[mnemonic](Args(), "==")
+                self.assertEqual(result.op, equality)
+                self.assertEqual(result.left.type.get_size_bits(), 64)
+                self.assertEqual(result.right.type.get_size_bits(), 32)
+                self.assertNotIn("M2C_BITWISE", result.format(Formatter()))
+
+    def test_shared_single_precision_compare_still_enforces_its_width(self) -> None:
+        result = BinaryOp.fcmp(GlobalSymbol("left", Type.f32()), "==",
+                               GlobalSymbol("right", Type.f32()))
+        self.assertEqual(result.left.type.get_size_bits(), 32)
+        self.assertEqual(result.right.type.get_size_bits(), 32)
+
+    def test_assembly_float_double_and_mixed_loads_keep_literal_precision(self) -> None:
+        root = Path(__file__).resolve().parents[2]
+        template = """.section .text
+.global compare
+compare:
+    {load} f0, constant@sda21(r2)
+    fcmpu cr0, {left}, {right}
+    {branch} .Lyes
+    li r3, 0
+    blr
+.Lyes:
+    li r3, 1
+    blr
+.section .sdata2
+.balign 8
+constant:
+    {constant}
+"""
+        with tempfile.TemporaryDirectory() as directory:
+            asm = Path(directory) / "compare.s"
+            context = Path(directory) / "context.h"
+            for argument, load, constant, expected in (
+                ("float", "lfs", ".float 0.001", "0.001f"),
+                ("double", "lfd", ".double 0.001", "0.001"),
+                ("float", "lfd", ".double 0.001", "0.001"),
+                ("double", "lfs", ".float 0.001", "0.001f"),
+            ):
+                for reverse in (False, True):
+                    for branch in ("beq", "bgt"):
+                        with self.subTest(argument=argument, load=load, reverse=reverse, branch=branch):
+                            left, right = ("f0", "f1") if reverse else ("f1", "f0")
+                            asm.write_text(template.format(load=load, constant=constant, left=left,
+                                                           right=right, branch=branch), encoding="utf-8")
+                            context.write_text(f"int compare({argument} value);\n", encoding="utf-8")
+                            process = subprocess.run(
+                                [sys.executable, str(root / "m2c.py"), "-t", "ppc-mwcc-c",
+                                 "--no-cache", "--valid-syntax", "--context", str(context), str(asm)],
+                                capture_output=True, text=True,
+                            )
+                            self.assertEqual(process.returncode, 0, process.stdout + process.stderr)
+                            self.assertNotIn("M2C_BITWISE", process.stdout)
+                            self.assertNotIn("M2C_ERROR", process.stdout)
+                            op = "!=" if branch == "beq" else "<" if reverse else ">"
+                            self.assertIn(f"value {op} {expected})", process.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
