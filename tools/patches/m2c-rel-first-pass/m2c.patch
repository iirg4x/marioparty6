+class PpcGekkoArch(PpcArch):
+    """Opt-in Gekko hard-float scalar argument profile.
+
+    GPR and FPR arguments use independent cursors: floats do not reserve GPR
+    shadow slots. Overflow begins after the 8-byte linkage area. In particular,
+    an int plus nine float parameters uses r3, f1-f8, then a float at sp+8.
+    The base class's aggregate/64-bit and variadic inference limitations remain;
+    selecting this profile is not a claim of complete EABI support.
+    """
+
+    argument_regs = [Register(f"r{i}") for i in range(3, 11)] + [
+        Register(f"f{i}") for i in range(1, 9)
+    ]
+    first_stack_arg_offset = 8
+    stack_args_from_locals = True
+    # Inherit temp_regs: f9-f13 are still caller-saved, not preserved registers.
+
+    @classmethod
+    def function_abi(
+        cls,
+        fn_sig: FunctionSignature,
+        likely_regs: Dict[Register, bool],
+        *,
+        for_call: bool,
+    ) -> Abi:
+        abi = super().function_abi(fn_sig, likely_regs, for_call=for_call)
+        # The inherited allocator advances overflow slots by one word. Do not
+        # silently use that layout for a double, aggregate, or unknown extent,
+        # or assume the byte placement of a smaller scalar inside a stack word.
+        if any(
+            slot.loc.offset is not None
+            and slot.type.get_size_bytes() != 4
+            for slot in abi.arg_slots
+        ):
+            raise DecompFailure(
+                "gekko-eabi currently supports only word-sized stack argument slots"
+            )
+        return abi
