+            self.assertTrue(char.unify(inferred) if reverse else inferred.unify(char))
+            self.assertEqual(char.format(Formatter()), 'char')
+            self.assertEqual(inferred.format(Formatter()), 'char')
+
+    def test_not_a_universal_byte_rewrite(self):
+        self.assertEqual(Type.int_of_size(8).format(Formatter()), 's8')
+        self.assertFalse(self.ctype('char').unify(Type.s32()))
+
+
+if __name__ == '__main__':
+    unittest.main()
