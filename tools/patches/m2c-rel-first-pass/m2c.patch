+def defer_incomplete_pointer_add(
+    expr: BinaryOp, stack_info: StackInfo, result_type: Type
+) -> Optional[Expression]:
+    global_info = stack_info.global_info
+    if not getattr(global_info, "valid_syntax", False) or getattr(global_info, "skip_casts", False):
+        return None
+    for base, offset in ((expr.left, expr.right), (expr.right, expr.left)):
+        if needs_byte_pointer_offset(base.type) and not offset.type.is_pointer_or_array():
+            if isinstance(offset, Literal) and global_info.arch.is_likely_partial_offset(offset.value):
+                continue
+            return DeferredPointerOffset(
+                base,
+                offset.value if isinstance(offset, Literal) else offset,
+                stack_info,
+                type=result_type,
+                legacy_expr=expr,
+            )
+    return None
 
 
