@@ -0,0 +1,36 @@
+import unittest
+from types import SimpleNamespace
+
+from m2c.options import Formatter
+from m2c.translate import GlobalSymbol, StructAccess
+from m2c.types import Type
+
+
+class ZeroOffsetAccessTests(unittest.TestCase):
+    def access(self, base, value):
+        return StructAccess(
+            struct_var=GlobalSymbol('buffer', base), offset=0,
+            target_size=value.get_size_bytes(), field_path=None,
+            stack_info=SimpleNamespace(has_nonzero_access=lambda _var: False),
+            type=value,
+        )
+
+    def test_void_pointer_uses_instruction_access_type(self):
+        for base in (Type.ptr(), Type.ptr(Type.void())):
+            for value, expected in ((Type.s16(), 's16 *'), (Type.f32(), 'f32 *'),
+                                    (Type.ptr(), 'void **')):
+                access = self.access(base, value)
+                self.assertEqual(access.format(Formatter(valid_syntax=True)),
+                                 f'M2C_FIELD(buffer, {expected}, 0)')
+                self.assertEqual(base.format(Formatter()), 'void *')
+
+    def test_known_typed_pointer_stays_direct(self):
+        self.assertEqual(self.access(Type.ptr(Type.s32()), Type.s32()).format(
+            Formatter(valid_syntax=True)), '*buffer')
+
+    def test_diagnostic_mode_remains_unchanged(self):
+        self.assertEqual(self.access(Type.ptr(), Type.s32()).format(Formatter()), '*buffer')
+
+
+if __name__ == '__main__':
+    unittest.main()
