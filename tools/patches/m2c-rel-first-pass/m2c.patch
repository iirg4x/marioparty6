+import unittest
+import sys
+import json
+import hashlib
+import subprocess
+from pathlib import Path
+if __package__ in {None, ''}:
+    sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+from tests.unit import test_ppc_stack_bookkeeping as support
+
+
+class VariadicCR1Tests(unittest.TestCase):
+    def translate(self, marker, context='void report(int tag, int value, ...); void sample(void);'):
+        return support.StackBookkeepingTests().translate(
+            '    bl unknown\n'+marker+'\n    li r3, 7\n    li r4, 8\n    bl report', context)
+
+    def test_clear_removes_only_variadic_fpr_candidate(self):
+        for marker in ('crclr 6', 'crclr cr1eq'):
+            text = self.translate('    '+marker)
+            self.assertIn('report(7, 8);', text)
+
+    def test_set_and_unknown_keep_float_candidate(self):
+        for marker in ('', '    crset 6', '    crclr 5'):
+            text = self.translate(marker)
+            self.assertIn('report(7, 8,', text)
+
+    def test_intervening_call_or_join_discards_clear(self):
+        for marker in ('    crclr 6\n    bl unknown2',
+                       '    crclr 6\n    cmpwi r3, 0\n    beq .Lend\n.Lend:'):
+            text = self.translate(marker)
+            self.assertIn('report(7, 8,', text)
+
+    def test_fixed_float_parameter_survives_clear(self):
+        text = self.translate('    crclr 6', 'void report(int tag, int value, float fp, ...); void sample(void);')
+        self.assertIn('report(7, 8,', text)
+
+
+if __name__ == '__main__':
+    if len(sys.argv) > 2 and sys.argv[1] == '--decompile':
