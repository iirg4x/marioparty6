@@ -0,0 +1,133 @@
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+from m2c.options import Formatter, Target
+from m2c.translate import LocalVar, StackInfo, as_type
+from m2c.types import StructDeclaration, Type
+
+
+class StackDeclarationTests(unittest.TestCase):
+    @staticmethod
+    def stack_info(field_type, *, valid_syntax=True):
+        layout = StructDeclaration(
+            size=0x40,
+            align=4,
+            new_field_prefix="sp",
+            is_stack=True,
+            fields=[StructDeclaration.StructField(field_type, 8, "sp8", True)],
+        )
+        return StackInfo(
+            function=None,
+            persistent_state=None,
+            global_info=SimpleNamespace(
+                arch=SimpleNamespace(arch=Target.ArchEnum.PPC),
+                valid_syntax=valid_syntax,
+            ),
+            flow_graph=None,
+            allocated_stack_size=0x40,
+            stack_pointer_type=Type.ptr(Type.struct(layout)),
+        )
+
+    def test_array_elements_register_the_whole_array_once(self):
+        info = self.stack_info(Type.array(Type.s32(), 4))
+        for offset in (12, 8, 16, 20, 8):
+            element = info.get_stack_var(offset, store=False)
+            self.assertIsInstance(element, LocalVar)
+            info.add_local_var(element)
+        self.assertEqual(len(info.local_vars), 1)
+        local = info.local_vars[0]
+        self.assertEqual(local.value, 8)
+        self.assertEqual(local.toplevel_decl(Formatter()), "s32 sp8[4]")
+
+    def test_nested_matrix_declares_full_extent(self):
+        info = self.stack_info(Type.array(Type.array(Type.f32(), 4), 3))
+        info.add_local_var(info.get_stack_var(8, store=False))
+        self.assertEqual(
+            info.local_vars[0].toplevel_decl(Formatter()), "f32 sp8[3][4]"
+        )
+
+    def test_partial_scalar_read_uses_existing_stack_object(self):
+        info = self.stack_info(Type.f64())
+        low_word = as_type(info.get_stack_var(12, store=False), Type.u32(), True)
+        self.assertEqual(
+            low_word.format(Formatter(valid_syntax=True)),
+            "M2C_FIELD(&sp8, u32 *, 4)",
+        )
+        self.assertEqual(len(info.local_vars), 1)
+        self.assertEqual(info.local_vars[0].toplevel_decl(Formatter()), "f64 sp8")
+
+    def test_legacy_partial_read_keeps_unknown_spelling(self):
+        info = self.stack_info(Type.f64(), valid_syntax=False)
+        low_word = as_type(info.get_stack_var(12, store=False), Type.u32(), True)
+        self.assertEqual(low_word.format(Formatter()), "unkspC")
+
+    def test_saved_register_slot_is_not_declared(self):
+        info = self.stack_info(Type.array(Type.s32(), 4))
+        info.callee_save_reg_region = (0x30, 0x40)
+        saved = info.get_stack_var(0x30, store=False)
+        self.assertIsNone(saved.path)
+        saved.use()
+        self.assertEqual(info.local_vars, [])
+
+    def test_only_live_read_only_stack_locals_are_declared(self):
+        info = self.stack_info(Type.u32())
+        used = info.get_stack_var(8, store=False)
+        unused = info.get_stack_var(0x20, store=False)
+        used.use()
+        self.assertEqual(len(info.local_vars), 1)
+        self.assertEqual(info.local_vars[0].toplevel_decl(Formatter()), "u32 sp8")
+        self.assertNotEqual(unused.value, info.local_vars[0].value)
+
+    def test_unknown_array_extent_is_not_fabricated(self):
+        info = self.stack_info(Type.array(Type.s16(), None))
+        info.get_stack_var(8, store=False).use()
+        self.assertEqual(info.local_vars[0].toplevel_decl(Formatter()), "s16 sp8[]")
+
+    def test_translation_with_array_only_element_references(self):
+        assembly = """.section .text
+.global sample
+sample:
+    stwu r1, -0x20(r1)
+    mflr r0
+    stw r0, 0x24(r1)
+    li r0, 3
+    stw r0, 0xc(r1)
+    addi r3, r1, 8
+    bl consume
+    lwz r0, 0x24(r1)
+    mtlr r0
+    addi r1, r1, 0x20
+    blr
+"""
+        context = """struct _m2c_stack_sample {
+    char pad[8];
+    int entries[4];
+    char end[8];
+};
+void consume(int *values);
+void sample(void);
+"""
+        root = Path(__file__).resolve().parents[2]
+        with tempfile.TemporaryDirectory() as directory:
+            asm_path = Path(directory) / "sample.s"
+            ctx_path = Path(directory) / "ctx.c"
+            asm_path.write_text(assembly, encoding="utf-8")
+            ctx_path.write_text(context, encoding="utf-8")
+            proc = subprocess.run(
+                [sys.executable, str(root / "m2c.py"), "-t", "ppc-mwcc-c",
+                 "--valid-syntax", "--no-cache", "--context", str(ctx_path),
+                 str(asm_path)],
+                capture_output=True, text=True,
+            )
+        self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
+        self.assertEqual(proc.stdout.count("s32 entries[4];"), 1, proc.stdout)
+        self.assertIn("entries[1] = 3;", proc.stdout)
+        self.assertNotIn("unksp", proc.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
