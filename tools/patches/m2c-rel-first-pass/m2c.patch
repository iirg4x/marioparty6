+def ppc_extend_integer(a: InstrArgs, target: Type) -> Expression:
+    # An outgoing extension is a conversion of a copy, not evidence that all
+    # uses of its full-width producer (including a loop phi) are narrow.
+    ref = a.instruction_ref
+    dst = a.reg_ref(0)
+    uses = a.stack_info.flow_graph.instr_uses[ref].get(dst)
+    call_only = bool(uses) and all(
+        isinstance(use, InstrRef)
+        and use.instruction.function_target is not None
+        and dst in use.instruction.inputs
+        for use in uses
+    )
+    if call_only:
+        base = as_type(a.reg(1), target, silent=False, unify=False)
+        if isinstance(base, Cast):
+            return NonUnifyingCast(expr=base.expr, type=base.type,
+                                  reinterpret=base.reinterpret, silent=base.silent)
+        return base
+    return as_type(a.reg(1), target, silent=False)
+
