{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CRACK_CURRENT_RESIDUAL_EVIDENCE_V1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner", "function", "base_commit", "unit", "base_sha256", "source_sha256", "target_sha256", "function_span", "toolchain_key", "base_object", "target_object", "focus_report", "physical_summary", "strict_report", "data_report", "physical_receipt", "producer", "residual_rows", "current_source_bound", "authority_advanced", "residual_sha256"],
  "properties": {
    "schema": {"const": "crack_current_residual_evidence/v1"},
    "owner": {"type": "string", "minLength": 1},
    "function": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "unit": {"type": "string", "minLength": 1},
    "base_sha256": {"$ref": "#/$defs/sha"},
    "source_sha256": {"$ref": "#/$defs/sha"},
    "target_sha256": {"$ref": "#/$defs/sha"},
    "function_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_line", "end_line", "base_span_sha256"],
      "properties": {
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "base_span_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "toolchain_key": {"$ref": "#/$defs/sha"},
    "base_object": {"$ref": "#/$defs/file"},
    "target_object": {"$ref": "#/$defs/file"},
    "focus_report": {"$ref": "#/$defs/file"},
    "physical_summary": {"$ref": "#/$defs/file"},
    "strict_report": {"$ref": "#/$defs/hashOnly"},
    "data_report": {"$ref": "#/$defs/hashOnly"},
    "physical_receipt": {"$ref": "#/$defs/hashOnly"},
    "producer": {"$ref": "#/$defs/file"},
    "residual_rows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "current_source_bound": {"const": true},
    "authority_advanced": {"const": false},
    "residual_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hashOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
