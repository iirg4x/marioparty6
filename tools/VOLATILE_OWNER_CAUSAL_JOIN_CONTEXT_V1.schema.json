{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VOLATILE_OWNER_CAUSAL_JOIN_CONTEXT_V1.schema.json",
  "title": "Volatile Owner Causal Join Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "session_id", "function", "strict_report_sha256",
    "data_report_sha256", "focus", "source_span_manifest", "target_object",
    "candidate_object", "physical_relocation_receipt",
    "ownership_failure_graph", "source_class_allowlist",
    "residual_row_bindings", "source_class_hypotheses", "context_sha256"
  ],
  "properties": {
    "schema": {"const": "volatile_owner_causal_join_context/v1"},
    "session_id": {"type": "string", "pattern": "^session-[0-9a-f]{16}$"},
    "function": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:+@/-]{0,191}$"},
    "strict_report_sha256": {"$ref": "#/$defs/sha256"},
    "data_report_sha256": {"$ref": "#/$defs/sha256"},
    "focus": {"$ref": "#/$defs/focusDescriptor"},
    "source_span_manifest": {"$ref": "#/$defs/spanDescriptor"},
    "target_object": {"$ref": "#/$defs/fileIdentity"},
    "candidate_object": {"$ref": "#/$defs/fileIdentity"},
    "physical_relocation_receipt": {"$ref": "#/$defs/physicalDescriptor"},
    "ownership_failure_graph": {"$ref": "#/$defs/graphDescriptor"},
    "source_class_allowlist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "residual_row_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rowBinding"}},
    "source_class_hypotheses": {"type": "array", "items": {"$ref": "#/$defs/hypothesis"}},
    "context_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "focusDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_sha256", "artifact_sha256"],
      "properties": {
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "spanDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_sha256", "manifest_sha256"],
      "properties": {
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "graphDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_sha256", "failure_graph_sha256"],
      "properties": {
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "failure_graph_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "physicalDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "file_sha256", "receipt_payload_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_payload_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rowBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "focus_row_index", "candidate_operand_index", "captured_role", "semantic_role"],
      "properties": {
        "row_id": {"type": "string", "pattern": "^residual-[0-9]{6}$"},
        "focus_row_index": {"type": "integer", "minimum": 0},
        "candidate_operand_index": {"type": "integer", "minimum": 0},
        "captured_role": {"type": "string"},
        "semantic_role": {"enum": ["index", "base", "result", "left", "right", "lhs", "rhs", "arithmetic_operand_0", "arithmetic_operand_1", "arithmetic_operand_2"]}
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_class", "row_ids"],
      "properties": {
        "source_class": {"type": "string"},
        "row_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^residual-[0-9]{6}$"}}
      }
    }
  }
}
