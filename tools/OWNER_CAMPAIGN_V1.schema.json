{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OWNER_CAMPAIGN_V1.schema.json",
  "title": "Autonomous owner cracking campaign",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "campaign_id", "owner", "unit", "source_relpath",
    "base_commit", "target_object", "toolchain", "measurement_producer", "functions",
    "protected_exact_functions", "allowed_source_paths",
    "allowed_build_paths", "forbidden_constructs", "commands",
    "cancellation_epoch", "limits", "manifest_sha256"
  ],
  "properties": {
    "schema": {"const": "owner_campaign/v1"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,96}$"},
    "owner": {"type": "string", "minLength": 1, "maxLength": 160},
    "unit": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+$"},
    "source_relpath": {"type": "string", "pattern": "^(?:src|include)/.+\\.(?:c|cp|cpp|h|hpp)$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "target_object": {"$ref": "#/$defs/file_binding"},
    "toolchain": {"$ref": "#/$defs/file_binding"},
    "measurement_producer": {"$ref": "#/$defs/file_binding"},
    "functions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "protected_exact_functions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_source_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_build_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "forbidden_constructs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "commands": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot", "candidate", "final_owner"],
      "properties": {
        "snapshot": {"$ref": "#/$defs/command"},
        "candidate": {"$ref": "#/$defs/command"},
        "final_owner": {"$ref": "#/$defs/command"}
      }
    },
    "cancellation_epoch": {"type": "integer", "minimum": 0},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["command_timeout_seconds", "scratch_soft_bytes", "scratch_hard_bytes", "cell_temporary_bytes", "focus_evidence_bytes", "frontier_bytes", "report_bytes", "dedupe_bytes", "owner_state_bytes"],
      "properties": {
        "command_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
        "scratch_soft_bytes": {"type": "integer", "minimum": 1, "maximum": 402653184},
        "scratch_hard_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
        "cell_temporary_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "focus_evidence_bytes": {"type": "integer", "minimum": 1, "maximum": 262144},
        "frontier_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "report_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "dedupe_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "owner_state_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "measurement_relpath"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "measurement_relpath": {"type": "string", "pattern": "^build/.+\\.json$"}
      }
    }
  }
}
