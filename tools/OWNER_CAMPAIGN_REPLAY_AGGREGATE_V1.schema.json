{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "owner_campaign_replay_aggregate/v1",
  "title": "Owner campaign replay aggregate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "mode", "fixtures", "results", "errors", "aggregate", "timing", "storage", "aggregate_sha256"],
  "properties": {
    "schema": {"const": "owner_campaign_replay_aggregate/v1"},
    "status": {"enum": ["exact", "failed"]},
    "mode": {"enum": ["sequential", "concurrent"]},
    "fixtures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture", "function", "status", "receipt_sha256", "report_sha256", "timing", "storage"],
        "properties": {
          "fixture": {"type": "string", "minLength": 1},
          "function": {"type": "string", "minLength": 1},
          "status": {"enum": ["exact", "failed"]},
          "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "timing": {"type": "object"},
          "storage": {"type": "object"}
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture", "error"],
        "properties": {
          "fixture": {"type": "string", "minLength": 1},
          "error": {"type": "string", "minLength": 1}
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "completed", "exact", "all_exact"],
      "properties": {
        "requested": {"type": "integer", "minimum": 1},
        "completed": {"type": "integer", "minimum": 0},
        "exact": {"type": "integer", "minimum": 0},
        "all_exact": {"type": "boolean"}
      }
    },
    "timing": {"type": "object"},
    "storage": {"type": "object"},
    "aggregate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
