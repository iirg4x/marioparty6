#ifndef MP6_LIBRARY_LIST
#define MP6_LIBRARY_LIST

#include <memory>
#include <iterator>
#include <new>
#include <functional>

namespace std {

// Empty argument trait distinguishes ranges from repeated-value insertion.
template <class T>
struct list_input_kind {
    enum { integral = 0 };
};
// Empty integral selector marks a count/value argument pair.
struct list_integral_kind {
    enum { integral = 1 };
};
// Integral arguments designate a count and a value rather than iterator positions.
template <> struct list_input_kind<bool> : list_integral_kind {};
template <> struct list_input_kind<char> : list_integral_kind {};
template <> struct list_input_kind<signed char> : list_integral_kind {};
template <> struct list_input_kind<unsigned char> : list_integral_kind {};
template <> struct list_input_kind<short> : list_integral_kind {};
template <> struct list_input_kind<unsigned short> : list_integral_kind {};
template <> struct list_input_kind<int> : list_integral_kind {};
template <> struct list_input_kind<unsigned int> : list_integral_kind {};
template <> struct list_input_kind<long> : list_integral_kind {};
template <> struct list_input_kind<unsigned long> : list_integral_kind {};

// Empty iterator trait supplies mutable element access types.
template <class T, int IsConst>
struct list_access_types {
    typedef T* pointer;
    typedef T& reference;
};
// Read-only traversal preserves the element type while adding const access.
template <class T>
struct list_access_types<T, 1> {
    typedef const T* pointer;
    typedef const T& reference;
};

// Ring owner stores a live-node count followed by a node allocator and embedded sentinel.
template <class T, class Allocator>
class __list_deleter {
public:
    typedef T value_type;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    typedef long difference_type;
    typedef T& reference;
    typedef const T& const_reference;

    // Links shared by the sentinel and value-bearing nodes.
    struct node_base {
        // Link toward the preceding node or circular sentinel.
        node_base* previous;
        // Link toward the following node or end sentinel.
        node_base* next;
    };
    // Stores one element after its two ring links.
    struct node : node_base {
        // Element constructed after the bidirectional ring links.
        T value;
    };
    typedef typename Allocator::template rebind<node>::other node_allocator;

    // Ring traversal retains one node-link pointer; constness is selected by a template argument.
    template <int IsConst>
    class generic_iterator {
    public:
        typedef bidirectional_iterator_tag iterator_category;
        typedef T value_type;
        typedef long difference_type;
        typedef typename list_access_types<T, IsConst>::pointer pointer;
        typedef typename list_access_types<T, IsConst>::reference reference;
        // Node link designated independently of element constness.
        typename list_access_types<node_base, IsConst>::pointer position;
        // Construct an iterator to a ring link.
        generic_iterator(typename list_access_types<node_base, IsConst>::pointer p = 0) :
            position(p) {}
        // Copy a mutable position, qualifying its link for read-only traversal.
        generic_iterator(const generic_iterator<0>& other) : position(other.position) {}
        reference operator*() const {
            typedef typename list_access_types<node, IsConst>::pointer node_pointer;
            return static_cast<node_pointer>(position)->value;
        }
        pointer operator->() const { return &operator*(); }
        generic_iterator& operator++() {
            position = position->next;
            return *this;
        }
        generic_iterator operator++(int) {
            generic_iterator old(*this);
            ++*this;
            return old;
        }
        generic_iterator& operator--() {
            position = position->previous;
            return *this;
        }
        generic_iterator operator--(int) {
            generic_iterator old(*this);
            --*this;
            return old;
        }
        bool operator==(const generic_iterator& other) const { return position == other.position; }
        bool operator!=(const generic_iterator& other) const { return position != other.position; }
    };
    typedef generic_iterator<0> iterator;
    typedef generic_iterator<1> const_iterator;

protected:
    // End the value lifetime before releasing its separately allocated node.
    static void destroy_value(T* value) { value->~T(); }
    // The element allocator and the count of live value nodes (the ring sentinel excluded).
    Metrowerks::compressed_pair<allocator_type, size_type> allocation_count_;
    // Node allocator sharing storage with the embedded circular sentinel.
    Metrowerks::compressed_pair<node_allocator, node_base> storage_;

    // Splice an initialized node into the circular chain.
    static void link_before(node_base* following, node_base* new_node) {
        following->previous->next = new_node;
        new_node->previous = following->previous;
        following->previous = new_node;
        new_node->next = following;
    }

    // Detach the inclusive node interval while preserving the surrounding ring.
    static void unlink_nodes(node_base* first, node_base* last) {
        first->previous->next = last->next;
        last->next->previous = first->previous;
    }

    // Update the live-node total after links are inserted or removed.
    size_type& count() { return allocation_count_.second(); }
    // Observe the number of value nodes without exposing a mutable count.
    const size_type& count() const { return allocation_count_.second(); }
    // Locate the link representing the end of the sequence.
    node_base* end_node() { return &storage_.second(); }
    // Locate the end link through a const list.
    const node_base* end_node() const { return &storage_.second(); }
    // Obtain the element allocator independently of its rebound node allocator.
    allocator_type& allocator_ref() { return allocation_count_.first(); }
    // Obtain the allocator for node storage.
    node_allocator& node_alloc() { return storage_.first(); }

public:
    // Initialize an empty ring.
    __list_deleter();
    // Start an empty ring using the supplied element allocator.
    explicit __list_deleter(const allocator_type& alloc);
    // Release every live element.
    ~__list_deleter() { erase(begin(), end()); }
    iterator begin() { return iterator(end_node()->next); }
    iterator end() { return iterator(end_node()); }
    const_iterator begin() const { return const_iterator(end_node()->next); }
    const_iterator end() const { return const_iterator(const_cast<node_base*>(end_node())); }
    bool empty() const { return count() == 0; }
    size_type size() const { return count(); }
    // Returns the first element.
    reference front() { return static_cast<node*>(end_node()->next)->value; }
    reference back() {
        iterator p = end();
        return *--p;
    }
    void clear() { erase(begin(), end()); }

    iterator insert(iterator where, const_reference element);
    // Transfer all nodes from the other ring before the insertion position.
    void splice(iterator where, __list_deleter& other);
    iterator erase(iterator where);
    iterator erase(iterator first, iterator last);
    void push_back(const_reference value) { insert(end(), value); }
    void push_front(const_reference value) { insert(begin(), value); }
    void pop_front() { erase(begin()); }
    void pop_back() {
        iterator p = end();
        erase(--p);
    }
};

template <class T, class Allocator>
typename __list_deleter<T, Allocator>::iterator
__list_deleter<T, Allocator>::insert(iterator where, const_reference element) {
    Metrowerks::alloc_ptr<node, node_allocator&, Metrowerks::number<unsigned long,
        1> > added(node_alloc().allocate(1), node_alloc());
    allocator_type().construct(&added->value, element);
    node* new_node = added.release();
    link_before(where.position, new_node);
    ++count();
    return iterator(new_node);
}

// Initialize a zero count and connect both sentinel links back to the sentinel.
template <class T, class Allocator>
__list_deleter<T, Allocator>::__list_deleter() : allocation_count_(0UL) {
    node_base& ring = storage_.second();
    ring.previous = ring.next = &ring;
}

// Initialize an empty ring using the supplied allocator.
template <class T, class Allocator>
__list_deleter<T, Allocator>::__list_deleter(const allocator_type& alloc)
    : allocation_count_(alloc, 0), storage_(node_allocator(alloc)) {
    node_base& ring = storage_.second();
    ring.previous = ring.next = &ring;
}

// Unlinks and destroys the node at where, returning the iterator after it.
template <class T, class Allocator>
typename __list_deleter<T, Allocator>::iterator
__list_deleter<T, Allocator>::erase(iterator where) {
    node* victim = static_cast<node*>(where.position);
    ++where;
    victim->previous->next = victim->next;
    victim->next->previous = victim->previous;
    allocator_type().destroy(&victim->value);
    node_alloc().deallocate(victim, 1);
    --count();
    return where;
}

// Unlinks and destroys the nodes in [first, last), returning last.
template <class T, class Allocator>
typename __list_deleter<T, Allocator>::iterator
__list_deleter<T, Allocator>::erase(iterator first, iterator last) {
    if (first == last)
        return last;
    unlink_nodes(first.position, last.position->previous);
    while (first != last) {
        destroy_value(&*first);
        node* victim = static_cast<node*>(first.position);
        ++first;
        node_alloc().deallocate(victim, 1);
        --count();
    }
    return last;
}

// List implementation inherits ring ownership without adding storage.
template <class T, class Allocator>
class __list_imp : public __list_deleter<T, Allocator> {
    typedef __list_deleter<T, Allocator> base;
    // Empty selectors choose between count/value and iterator-range insertion.
    template <int Integral> struct chooser {};
    // Build a detached range before committing its nodes to this ring.
    template <class Input>
    void choose_insert(typename base::iterator where, Input first, Input last, chooser<0>);
    // Select the range constructor without treating integral counts as iterators.
    template <class Input>
    void choose_init(Input first, Input last, chooser<0>) { init(first, last); }
    // Integral arguments initialize a count of copies of the converted value.
    template <class Integer>
    void choose_init(Integer count, Integer value, chooser<1>) {
        insert(this->end(), static_cast<typename base::size_type>(count), T(value));
    }
    // Initialize an empty ring by appending each input value.
    template <class Input>
    void init(Input first, Input last);
    // Repeated integral arguments select the count/value overload.
    template <class Integer>
    void choose_insert(typename base::iterator where, Integer count, Integer value, chooser<1>) {
        insert(where, static_cast<typename base::size_type>(count), T(value));
    }
public:
    typedef typename __list_deleter<T, Allocator>::iterator iterator;
    typedef typename base::allocator_type allocator_type;
    // Construct an empty list with the default allocator.
    __list_imp() : base() {}
    // Initialize with the supplied allocator, dispatching ranges or count/value pairs.
    template <class Input>
    __list_imp(Input first, Input last, const allocator_type& alloc) : base(alloc) {
        choose_init(first, last, chooser<list_input_kind<Input>::integral>());
    }
    using base::insert;
    // Insert the requested number of copies before the insertion position.
    void insert(iterator where, typename base::size_type count, const T& value) {
        while (count--) base::insert(where, value);
    }
    // Dispatch iterator ranges and integral count/value pairs to their insertion overloads.
    template <class Input>
    void insert(iterator where, Input first, Input last) {
        choose_insert(where, first, last, chooser<list_input_kind<Input>::integral>());
    }
    // Transfer the other list through the ring owner.
    void splice(iterator where, base& other) { base::splice(where, other); }
    template <class Predicate>
    void remove_if(Predicate predicate);
    void remove(const T& value) { remove_if(bind2nd(equal_to<T>(), value)); }
};

// Append each input value to initialize the list.
template <class T, class Allocator>
template <class Input>
void __list_imp<T, Allocator>::init(Input first, Input last) {
    for (; first != last; ++first)
        this->push_back(*first);
}

// Construct the input range in a temporary list, then transfer its nodes.
template <class T, class Allocator>
template <class Input>
void __list_imp<T, Allocator>::choose_insert(iterator where, Input first, Input last, chooser<0>) {
    __list_imp temporary(first, last, this->allocator_ref());
    splice(where, temporary);
}

// Move the other ring into this ring and transfer its node count.
template <class T, class Allocator>
void __list_deleter<T, Allocator>::splice(iterator where, __list_deleter& other) {
    if (other.empty()) return;
    node_base* sentinel = other.end_node();
    node_base* head = sentinel->next;
    node_base* tail = sentinel->previous;
    sentinel->previous = sentinel->next = sentinel;
    node_base* following = where.position;
    following->previous->next = head;
    head->previous = following->previous;
    following->previous = tail;
    tail->next = following;
    this->count() += other.count();
    other.count() = 0;
}

template <class T, class Allocator>
template <class Predicate>
void __list_imp<T, Allocator>::remove_if(Predicate predicate) {
    iterator last = this->end();
    iterator first = this->begin();
    while (first != last) {
        if (predicate(*first)) {
            iterator after = first;
            ++after;
            for (; after != last; ++after)
                if (!predicate(*after)) break;
            first = this->erase(first, after);
            if (first == last) break;
        }
        ++first;
    }
}

// Public list inherits its node-ring storage and adds no fields of its own.
template <class T, class Allocator = allocator<T> >
class list : public __list_imp<T, Allocator> {};

// Pointer list shares a const-void node ring and adds no storage to its owner.
template <class T, class Allocator>
class list<T*, Allocator> : public __list_imp<const void*,
    typename Allocator::template rebind<const void*>::other> {
    typedef __list_imp<const void*,
        typename Allocator::template rebind<const void*>::other> base;
public:
    typedef T* value_type;
    typedef Allocator allocator_type;
    typedef typename base::size_type size_type;
    typedef typename base::difference_type difference_type;
    typedef T*& reference;
    typedef T* const& const_reference;
    // Typed traversal inherits the qualified shared iterator without adding storage.
    template <int IsConst>
    class generic_iterator : public base::template generic_iterator<IsConst> {
        typedef typename base::template generic_iterator<IsConst> iterator_base;
    public:
        typedef bidirectional_iterator_tag iterator_category;
        typedef T* value_type;
        typedef long difference_type;
        typedef typename list_access_types<T*, IsConst>::pointer pointer;
        typedef typename list_access_types<T*, IsConst>::reference reference;
        // Wrap the stored link with the requested element qualification.
        generic_iterator(iterator_base p) : iterator_base(p) {}
        // Preserve the mutable traversal position while qualifying element access.
        generic_iterator(const generic_iterator<0>& p) : iterator_base(p) {}
        reference operator*() const { return (reference)iterator_base::operator*(); }
        pointer operator->() const { return &operator*(); }
        generic_iterator& operator++() {
            iterator_base::operator++();
            return *this;
        }
        generic_iterator operator++(int) {
            generic_iterator old(*this);
            ++*this;
            return old;
        }
        generic_iterator& operator--() {
            iterator_base::operator--();
            return *this;
        }
    };
    typedef generic_iterator<0> iterator;
    typedef generic_iterator<1> const_iterator;
    // Returns an iterator to the first element.
    iterator begin() { return base::begin(); }
    // Returns an iterator past the last element.
    iterator end() { return base::end(); }
    // Returns a read-only iterator to the first element.
    const_iterator begin() const { return base::begin(); }
    // Returns a read-only iterator past the last element.
    const_iterator end() const { return base::end(); }
    reference front() { return (reference)base::front(); }
    reference back() { return (reference)base::back(); }
    void push_back(const_reference value) { base::push_back((const void* const&)value); }
    void push_front(const_reference value) { base::push_front((const void* const&)value); }
    // Removes every element equal to value.
    void remove(const_reference value) { base::remove(value); }
};

}
#endif
