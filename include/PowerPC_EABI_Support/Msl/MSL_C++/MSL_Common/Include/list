// These private template names are present in the game's container symbols.
#ifndef MP6_RECONSTRUCTED_CONTAINER_STORAGE
#define MP6_RECONSTRUCTED_CONTAINER_STORAGE
namespace Metrowerks {
// Empty count tag publishes an allocation extent known at template instantiation.
template <class T, T Value>
struct number {
    operator T() const { return Value; }
};
namespace details {
// Stores the first value followed by the second when the first has instance state.
template <class First, class Second, int Empty>
class compressed_pair_imp {
    // First stored value when it cannot share an empty base.
    First first_;
    // Second value follows the separately stored first value.
    Second second_;
public:
    // Initialize both stored values.
    compressed_pair_imp() : first_(), second_() {}
    // Copy the first value without initializing scalar container state.
    explicit compressed_pair_imp(const First& a) : first_(a) {}
    // Copy both supplied values.
    compressed_pair_imp(const First& a, const Second& b) : first_(a), second_(b) {}
    // Expose the separately stored allocation or ordering object for updates.
    First& first() { return first_; }
    // Read the allocation or ordering object without changing the pair.
    const First& first() const { return first_; }
    // Expose the adjoining count, root or pointer state for container updates.
    Second& second() { return second_; }
    // Read the adjoining container state while keeping both pair components unchanged.
    const Second& second() const { return second_; }
};
// Shares storage with an empty allocator base.
template <class First, class Second>
class compressed_pair_imp<First, Second, 1> : private First {
    // State adjoining the empty allocator base.
    Second second_;
public:
    // Value-initialize the state beside the default empty allocator.
    compressed_pair_imp() : First(), second_() {}
    // Container constructors initialize their own count or root state.
    explicit compressed_pair_imp(const First& a) : First(a) {}
    // Build the empty base from the allocator and copy the associated state.
    compressed_pair_imp(const First& a, const Second& b) : First(a), second_(b) {}
    // Expose the empty allocator base for allocation operations.
    First& first() { return *this; }
    // Read the empty allocator base without modifying it.
    const First& first() const { return *this; }
    // Expose the state stored beside the empty allocator.
    Second& second() { return second_; }
    // Read the state adjoining the empty allocator base.
    const Second& second() const { return second_; }
};
// Stores value-initialized container state beside an empty allocator.
template <class T, class Second>
class compressed_pair_imp<std::allocator<T>, Second, 1> :
    private std::allocator<T> {
    typedef std::allocator<T> First;
    // Value-initialized state adjoining the scalar allocator.
    Second second_;
public:
    // Default-initialize the allocator base and the scalar-allocation state.
    compressed_pair_imp() : First(), second_() {}
    // Copy the allocator and initialize its associated state.
    explicit compressed_pair_imp(const First& a) : First(a), second_() {}
    // Preserve the supplied scalar allocator and its container state.
    compressed_pair_imp(const First& a, const Second& b) : First(a), second_(b) {}
    // Return the scalar allocator base for storage management.
    First& first() { return *this; }
    // Expose the scalar allocator through a read-only pair.
    const First& first() const { return *this; }
    // Return mutable state associated with the scalar allocator.
    Second& second() { return second_; }
    // Read container state from the scalar-allocator specialization.
    const Second& second() const { return second_; }
};
// An allocator reference occupies a pointer word rather than an empty base.
template <class First, class Second>
class compressed_pair_imp<First&, Second, 0> {
    // Allocator reference retained as a pointer-sized field.
    First& first_;
    // Container state paired with a referenced allocator.
    Second second_;
public:
    // Keep an allocator reference beside a copy of the supplied state.
    compressed_pair_imp(First& a, const Second& b) : first_(a), second_(b) {}
    // Expose the referenced allocator for storage operations.
    First& first() { return first_; }
    // Read the allocator reference without changing its binding.
    const First& first() const { return first_; }
    // Expose the container state retained beside the allocator reference.
    Second& second() { return second_; }
    // Read state from the allocator-reference pair.
    const Second& second() const { return second_; }
};
}
// Pair wrapper adds no fields to the base holding an allocator and its container state.
template <class First, class Second>
class compressed_pair : public details::compressed_pair_imp<First, Second, 1> {
    typedef details::compressed_pair_imp<First, Second, 1> base;
public:
    // Initialize the allocator and state.
    compressed_pair() : base() {}
    // Retain an allocator or ordering operation before initializing its state.
    explicit compressed_pair(const First& a) : base(a) {}
    // Initialize from an allocator and a state value.
    compressed_pair(const First& a, const Second& b) : base(a, b) {}
};
template <class First, class Second>
// Reference pair adds no fields to its base holding an allocator reference and state.
class compressed_pair<First&, Second> : public details::compressed_pair_imp<First&, Second, 0> {
    typedef details::compressed_pair_imp<First&, Second, 0> base;
public:
    // Forward the allocator reference and state into the reference-storage base.
    compressed_pair(First& a, const Second& b) : base(a, b) {}
};
// Allocation guard nests the allocator, element count and pointer in compressed pairs.
template <class T, class Allocator, class Count>
class alloc_ptr {
    // Allocator, allocation count and pointer retained until ownership commits.
    compressed_pair<Allocator, compressed_pair<Count, T*> > allocation_state;
public:
    // Retain newly allocated storage until value construction commits it.
    alloc_ptr(T* pointer, Allocator a, Count count = Count()) : allocation_state(a,
        compressed_pair<Count, T*>(count, pointer)) {}
    // Return any storage whose ownership has not been transferred.
    ~alloc_ptr() {
        if (get() != 0) allocation_state.first().deallocate(get(),
            allocation_state.second().first());
    }
    // Read the allocation without transferring its ownership.
    T* get() const { return allocation_state.second().second(); }
    T* operator->() const { return get(); }
    // Transfer responsibility for releasing the storage.
    T* release() {
        T* result = get();
        allocation_state.second().second() = 0;
        return result;
    }
};
}
#endif

namespace std {

// Ring owner stores a live-node count followed by a node allocator and embedded sentinel.
template <class T, class Allocator>
class __list_deleter {
public:
    typedef T value_type;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    typedef long difference_type;
    typedef T& reference;
    typedef const T& const_reference;

    // Links shared by the sentinel and value-bearing nodes.
    struct node_base {
        // Link toward the preceding node or circular sentinel.
        node_base* previous;
        // Link toward the following node or end sentinel.
        node_base* next;
    };
    // Stores one element after its two ring links.
    struct node : node_base {
        // Element constructed after the bidirectional ring links.
        T value;
    };
    typedef typename Allocator::template rebind<node>::other node_allocator;

    // Ring traversal retains one node-link pointer; constness is selected by a template argument.
    template <int IsConst>
    class generic_iterator {
    public:
        typedef bidirectional_iterator_tag iterator_category;
        typedef T value_type;
        typedef long difference_type;
        typedef T* pointer;
        typedef T& reference;
        // Node link designated independently of element constness.
        node_base* position;
        // Construct an iterator to a ring link.
        generic_iterator(node_base* p = 0) : position(p) {}
        // Copy the position without changing the node chain.
        generic_iterator(const generic_iterator& other) : position(other.position) {}
        reference operator*() const { return static_cast<node*>(position)->value; }
        pointer operator->() const { return &operator*(); }
        generic_iterator& operator++() {
            position = position->next;
            return *this;
        }
        generic_iterator operator++(int) {
            generic_iterator old(*this);
            ++*this;
            return old;
        }
        generic_iterator& operator--() {
            position = position->previous;
            return *this;
        }
        generic_iterator operator--(int) {
            generic_iterator old(*this);
            --*this;
            return old;
        }
        bool operator==(const generic_iterator& other) const { return position == other.position; }
        bool operator!=(const generic_iterator& other) const { return position != other.position; }
    };
    typedef generic_iterator<0> iterator;
    typedef generic_iterator<1> const_iterator;

protected:
    // End the value lifetime before releasing its separately allocated node.
    static void destroy_value(T* value) { value->~T(); }
    // Live value nodes, excluding the embedded ring sentinel.
    size_type count_;
    // Node allocator sharing storage with the embedded circular sentinel.
    Metrowerks::compressed_pair<node_allocator, node_base> storage_;

    // Splice an initialized node into the circular chain.
    static void link_before(node_base* following, node_base* new_node) {
        following->previous->next = new_node;
        new_node->previous = following->previous;
        following->previous = new_node;
        new_node->next = following;
    }

    // Update the live-node total after links are inserted or removed.
    size_type& count() { return count_; }
    // Observe the number of value nodes without exposing a mutable count.
    const size_type& count() const { return count_; }
    // Locate the link representing the end of the sequence.
    node_base* end_node() { return &storage_.second(); }
    // Locate the end link through a const list.
    const node_base* end_node() const { return &storage_.second(); }
    // Obtain the allocator for node storage.
    node_allocator& node_alloc() { return storage_.first(); }

public:
    // Initialize an empty ring.
    __list_deleter();
    // Release every live element.
    ~__list_deleter() { erase(begin(), end()); }
    iterator begin() { return iterator(end_node()->next); }
    iterator end() { return iterator(end_node()); }
    const_iterator begin() const { return const_iterator(end_node()->next); }
    const_iterator end() const { return const_iterator(const_cast<node_base*>(end_node())); }
    bool empty() const { return count() == 0; }
    size_type size() const { return count(); }
    reference front() { return *begin(); }
    reference back() {
        iterator p = end();
        return *--p;
    }
    void clear() { erase(begin(), end()); }

    iterator insert(iterator where, const_reference element);
    iterator erase(iterator where);
    iterator erase(iterator first, iterator last);
    void push_back(const_reference value) { insert(end(), value); }
    void push_front(const_reference value) { insert(begin(), value); }
    void pop_front() { erase(begin()); }
    void pop_back() {
        iterator p = end();
        erase(--p);
    }
};

template <class T, class Allocator>
typename __list_deleter<T, Allocator>::iterator
__list_deleter<T, Allocator>::insert(iterator where, const_reference element) {
    Metrowerks::alloc_ptr<node, node_allocator&, Metrowerks::number<unsigned long,
        1> > added(node_alloc().allocate(1), node_alloc());
    allocator_type().construct(&added->value, element);
    node* new_node = added.release();
    link_before(where.position, new_node);
    ++count();
    return iterator(new_node);
}

// Initialize a zero count and connect both sentinel links back to the sentinel.
template <class T, class Allocator>
__list_deleter<T, Allocator>::__list_deleter() : count_(0) {
    node_base& ring = storage_.second();
    ring.previous = ring.next = &ring;
}

template <class T, class Allocator>
typename __list_deleter<T, Allocator>::iterator
__list_deleter<T, Allocator>::erase(iterator where) {
    node* victim = static_cast<node*>(where.position);
    ++where;
    victim->previous->next = victim->next;
    victim->next->previous = victim->previous;
    delete victim;
    --count();
    return where;
}

template <class T, class Allocator>
typename __list_deleter<T, Allocator>::iterator
__list_deleter<T, Allocator>::erase(iterator first, iterator last) {
    if (first == last)
        return last;
    node_base* head;
    node_base* tail;
    tail = last.position->previous;
    head = first.position;
    head->previous->next = tail->next;
    tail->next->previous = head->previous;
    while (first != last) {
        destroy_value(&*first);
        node* victim = static_cast<node*>(first.position);
        ++first;
        ::operator delete(victim);
        --count();
    }
    return last;
}

// List implementation inherits ring ownership without adding storage.
template <class T, class Allocator>
class __list_imp : public __list_deleter<T, Allocator> {};

// Public list inherits its node-ring storage and adds no fields of its own.
template <class T, class Allocator = allocator<T> >
class list : public __list_imp<T, Allocator> {};

}
#endif
