namespace std {

// Apply the callable to each element and return its final state.
template <class InputIterator, class Function>
inline Function for_each(InputIterator first, InputIterator last, Function function) {
    for (; first != last; ++first) function(*first);
    return function;
}

template <class InputIterator, class T>
inline InputIterator find(InputIterator first, InputIterator last, const T& value) {
    for (; first != last && !(*first == value); ++first) {}
    return first;
}

// Find the first element accepted by the predicate.
template <class InputIterator, class Predicate>
inline InputIterator find_if(InputIterator first, InputIterator last, Predicate predicate) {
    for (; first != last && !predicate(*first); ++first) {}
    return first;
}

// Count the elements accepted by a predicate.
template <class InputIterator, class Predicate>
inline typename iterator_traits<InputIterator>::difference_type
count_if(InputIterator first, InputIterator last, Predicate predicate) {
    typename iterator_traits<InputIterator>::difference_type count = 0;
    for (; first != last; ++first) if (predicate(*first)) ++count;
    return count;
}

template <class ForwardIterator, class T>
inline void fill(ForwardIterator first, ForwardIterator last, const T& value) {
    for (; first != last; ++first) *first = value;
}

template <class OutputIterator, class Size, class T>
inline void fill_n(OutputIterator first, Size count, const T& value) {
    for (; count > 0; ++first, --count) *first = value;
}

template <class InputIterator, class OutputIterator>
inline OutputIterator copy(InputIterator first, InputIterator last, OutputIterator result) {
    for (; first != last; ++first, ++result) *result = *first;
    return result;
}

// Pointer ranges permit their contiguous range bound to drive the copy.
template <class T>
inline T* algorithm_pointer_copy(T* first, T* last, T* result) {
    while (first < last) {
        *result = *first;
        ++first;
        ++result;
    }
    return result;
}

template <class T>
inline T* copy(const T* first, const T* last, T* result) {
    return algorithm_pointer_copy(const_cast<T*>(first), const_cast<T*>(last), result);
}

// Two-byte scalar ranges can be copied as contiguous object representations.
template <>
inline unsigned short* algorithm_pointer_copy<unsigned short>(unsigned short* first,
    unsigned short* last, unsigned short* result) {
    ptrdiff_t count = last - first;
    memcpy(result, first, count * sizeof(unsigned short));
    return result + count;
}

template <class T>
inline T* copy(T* first, T* last, T* result) {
    return algorithm_pointer_copy(first, last, result);
}

template <class BidirectionalIterator1, class BidirectionalIterator2>
inline BidirectionalIterator2 copy_backward(BidirectionalIterator1 first,
    BidirectionalIterator1 last, BidirectionalIterator2 result) {
    while (last != first) *--result = *--last;
    return result;
}

// Pointer ranges copy backward until their start address is reached.
template <class T>
inline T* algorithm_pointer_copy_backward(T* first, T* last, T* result) {
    while (last > first) *--result = *--last;
    return result;
}

// Two-byte scalar ranges allow overlap while moving their object representations.
template <>
inline unsigned short* algorithm_pointer_copy_backward<unsigned short>(unsigned short* first,
    unsigned short* last, unsigned short* result) {
    ptrdiff_t count = last - first;
    result -= count;
    memmove(result, first, count * sizeof(unsigned short));
    return result;
}

template <class T>
inline T* copy_backward(T* first, T* last, T* result) {
    return algorithm_pointer_copy_backward(first, last, result);
}

template <class T>
inline void swap(T& first, T& second) {
    T saved = first;
    first = second;
    second = saved;
}

// Exchange the values designated by two iterators.
template <class ForwardIterator1, class ForwardIterator2>
inline void iter_swap(ForwardIterator1 first, ForwardIterator2 second) {
    std::swap(*first, *second);
}

template <class T>
inline const T& min(const T& first, const T& second) {
    return second < first ? second : first;
}

template <class T>
inline const T& max(const T& first, const T& second) {
    return first < second ? second : first;
}

template <class ForwardIterator, class Compare>
inline ForwardIterator min_element(ForwardIterator first, ForwardIterator last, Compare compare) {
    ForwardIterator result = first;
    if (first != last) {
        for (++first; first != last; ++first)
            if (compare(*first, *result)) result = first;
    }
    return result;
}

template <class ForwardIterator>
inline ForwardIterator min_element(ForwardIterator first, ForwardIterator last) {
    return std::min_element(first, last,
        std::less<typename iterator_traits<ForwardIterator>::value_type>());
}

template <class ForwardIterator, class T, class Compare>
inline ForwardIterator lower_bound(ForwardIterator first, ForwardIterator last, const T& value,
    Compare compare) {
    typedef typename iterator_traits<ForwardIterator>::difference_type difference_type;
    difference_type count = std::distance(first, last);
    while (count > 0) {
        ForwardIterator middle = first;
        difference_type half = count / 2;
        std::advance(middle, half);
        if (compare(*middle, value)) {
            first = ++middle;
            count -= half + 1;
        } else count = half;
    }
    return first;
}

template <class ForwardIterator, class T>
inline ForwardIterator lower_bound(ForwardIterator first, ForwardIterator last, const T& value) {
    typedef typename iterator_traits<ForwardIterator>::difference_type difference_type;
    difference_type count = std::distance(first, last);
    while (count > 0) {
        ForwardIterator middle = first;
        difference_type half = count / 2;
        std::advance(middle, half);
        if (*middle < value) {
            first = ++middle;
            count -= half + 1;
        } else count = half;
    }
    return first;
}

template <class ForwardIterator, class T, class Compare>
inline ForwardIterator upper_bound(ForwardIterator first, ForwardIterator last, const T& value,
    Compare compare) {
    typedef typename iterator_traits<ForwardIterator>::difference_type difference_type;
    difference_type count = std::distance(first, last);
    while (count > 0) {
        ForwardIterator middle = first;
        difference_type half = count / 2;
        std::advance(middle, half);
        if (!compare(value, *middle)) {
            first = ++middle;
            count -= half + 1;
        } else count = half;
    }
    return first;
}

template <class ForwardIterator, class T>
inline ForwardIterator upper_bound(ForwardIterator first, ForwardIterator last, const T& value) {
    return std::upper_bound(first, last, value, std::less<T>());
}

// Descend through the larger child until the saved element fits the heap.
template <class RandomAccessIterator, class Distance, class T, class Compare>
void __insert_heap_down(RandomAccessIterator first, Distance length, Distance hole, const T& value,
    Compare compare) {
    RandomAccessIterator position = first + hole;
    Distance child = 2 * (hole + 1);
    while (child <= length) {
        RandomAccessIterator candidate = first + child;
        if (child == length || compare(*candidate, *(candidate - 1))) {
            --child;
            --candidate;
        }
        if (!compare(value, *candidate)) break;
        *position = *candidate;
        position = candidate;
        ++child;
        child *= 2;
    }
    *position = value;
}

template <class RandomAccessIterator, class Compare>
void push_heap(RandomAccessIterator first, RandomAccessIterator last, Compare compare) {
    typedef typename iterator_traits<RandomAccessIterator>::difference_type difference_type;
    typedef typename iterator_traits<RandomAccessIterator>::value_type value_type;
    difference_type count = last - first;
    if (count < 2) return;
    --count;
    difference_type parent = (count - 1) / 2;
    RandomAccessIterator ancestor = first + parent;
    RandomAccessIterator position = first + count;
    if (compare(*ancestor, *position)) {
        value_type saved(*position);
        do {
            *position = *ancestor;
            position = ancestor;
            if (position == first) break;
            --parent;
            parent /= 2;
            ancestor = first + parent;
        } while (compare(*ancestor, saved));
        *position = saved;
    }
}

template <class RandomAccessIterator>
inline void push_heap(RandomAccessIterator first, RandomAccessIterator last) {
    std::push_heap(first, last,
        std::less<typename iterator_traits<RandomAccessIterator>::value_type>());
}

template <class RandomAccessIterator, class Compare>
void pop_heap(RandomAccessIterator first, RandomAccessIterator last, Compare compare) {
    typedef typename iterator_traits<RandomAccessIterator>::difference_type difference_type;
    typedef typename iterator_traits<RandomAccessIterator>::value_type value_type;
    difference_type count = last - first;
    if (count < 2) return;
    --last;
    if (count == 2) std::swap(*first, *last);
    else {
        --count;
        value_type saved(*last);
        *last = *first;
        std::__insert_heap_down(first, count, difference_type(0), saved, compare);
    }
}

template <class RandomAccessIterator>
inline void pop_heap(RandomAccessIterator first, RandomAccessIterator last) {
    std::pop_heap(first, last,
        std::less<typename iterator_traits<RandomAccessIterator>::value_type>());
}

template <class RandomAccessIterator, class Compare>
void make_heap(RandomAccessIterator first, RandomAccessIterator last, Compare compare) {
    typedef typename iterator_traits<RandomAccessIterator>::difference_type difference_type;
    typedef typename iterator_traits<RandomAccessIterator>::value_type value_type;
    difference_type count = last - first;
    if (count < 2) return;
    difference_type parent = (count - 2) / 2;
    RandomAccessIterator position = first + parent;
    difference_type rightIndex = 2 * (parent + 1);
    RandomAccessIterator right = first + rightIndex;
    RandomAccessIterator left = right - 1;
    difference_type child = rightIndex;
    RandomAccessIterator candidate = right;
    if (rightIndex == count || compare(*right, *left)) {
        --child;
        candidate = left;
    }
    for (;;) {
        if (compare(*position, *candidate)) {
            value_type saved(*position);
            *position = *candidate;
            std::__insert_heap_down(first, count, child, saved, compare);
        }
        if (parent-- == 0) break;
        --position;
        rightIndex -= 2;
        right -= 2;
        left -= 2;
        child = rightIndex;
        candidate = right;
        if (compare(*right, *left)) {
            --child;
            candidate = left;
        }
    }
}

template <class RandomAccessIterator>
inline void make_heap(RandomAccessIterator first, RandomAccessIterator last) {
    std::make_heap(first, last,
        std::less<typename iterator_traits<RandomAccessIterator>::value_type>());
}

// Order a small range by repeatedly selecting its least remaining element.
template <class RandomAccessIterator, class Compare>
void __selection_sort(RandomAccessIterator first, RandomAccessIterator last, Compare compare) {
    if (first != last) {
        RandomAccessIterator beforeLast = last - 1;
        for (; first < beforeLast; ++first) {
            RandomAccessIterator least = std::min_element(first, last, compare);
            if (least != first) std::iter_swap(least, first);
        }
    }
}

// Order three samples with the median stored in the third position.
template <class RandomAccessIterator, class Compare>
void __sort132(RandomAccessIterator first, RandomAccessIterator second, RandomAccessIterator third,
    Compare compare) {
    bool firstBeforeThird = !compare(*third, *first);
    bool thirdBeforeSecond = !compare(*second, *third);
    if (firstBeforeThird && thirdBeforeSecond) return;
    if (!firstBeforeThird && !thirdBeforeSecond) {
        std::iter_swap(first, second);
        return;
    }
    if (compare(*second, *first)) std::iter_swap(first, second);
    if (firstBeforeThird) std::iter_swap(second, third);
    else std::iter_swap(first, third);
}

template <class RandomAccessIterator, class Compare>
void sort(RandomAccessIterator first, RandomAccessIterator last, Compare compare) {
    typedef typename iterator_traits<RandomAccessIterator>::difference_type difference_type;
    for (;;) {
    difference_type length = last - first;
    if (length <= 1) return;
    if (length <= 20) {
        std::__selection_sort(first, last, compare);
        return;
    }
    const int sampleCycle = 5;
    static int shuffle = -4;
    RandomAccessIterator left = first + (length / 4 + shuffle % sampleCycle);
    if (++shuffle >= sampleCycle) shuffle = -4;
    RandomAccessIterator right = first + (length * 3 / 4 + shuffle % sampleCycle);
    if (++shuffle >= sampleCycle) shuffle = -4;
    RandomAccessIterator pivot = last - 1;
    std::__sort132(left, right, pivot, compare);
    left = first;
    right = pivot;
    while (compare(*left, *pivot)) ++left;
    while (left != --right && !compare(*right, *pivot)) {}
    if (left < right) {
        std::iter_swap(left, right);
        ++left;
        for (;;) {
            while (compare(*left, *pivot)) ++left;
            while (!compare(*--right, *pivot)) {}
            if (left >= right) break;
            std::iter_swap(left, right);
            ++left;
        }
    }
    if (left == first) {
        std::iter_swap(left, pivot);
        ++left;
        right = last;
        if (!compare(*first, *--right)) {
            while (left != last && !compare(*first, *left)) ++left;
            if (left < right) std::iter_swap(left, right);
        }
        if (left < right) {
            for (;;) {
                while (!compare(*first, *left)) ++left;
                while (compare(*first, *--right)) {}
                if (left >= right) break;
                std::iter_swap(left, right);
                ++left;
            }
        }
        first = left;
        continue;
    }
    if (left - first < last - left) {
        std::sort(first, left, compare);
        first = left;
    } else {
        std::sort(left, last, compare);
        last = left;
    }
    }
}

template <class RandomAccessIterator>
void sort(RandomAccessIterator first, RandomAccessIterator last) {
    std::sort(first, last, std::less<typename iterator_traits<RandomAccessIterator>::value_type>());
}

template <class RandomAccessIterator, class RandomNumberGenerator>
inline void random_shuffle(RandomAccessIterator first, RandomAccessIterator last,
    RandomNumberGenerator& random) {
    typedef typename iterator_traits<RandomAccessIterator>::difference_type difference_type;
    difference_type count = last - first;
    if (count > 1) {
        --last;
        for (; first < last; ++first, --count)
            std::iter_swap(first, first + random(count));
    }
}

