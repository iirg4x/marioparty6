#ifndef MP6_RECONSTRUCTED_QUEUE
#define MP6_RECONSTRUCTED_QUEUE
#include <deque>
#include <vector>
#include <functional>
#include <algorithm>

namespace std {
// Adapts the game's default deque to the standard FIFO interface.
template <class T, class Container = deque<T> > class queue {
public:
    typedef typename Container::value_type value_type;
    typedef Container container_type;
    typedef typename Container::size_type size_type;
protected:
    Container c;
public:
    explicit queue(const Container& source = Container()) : c(source) {}
    bool empty() const { return c.empty(); }
    size_type size() const { return c.size(); }
    value_type& front() { return c.front(); }
    const value_type& front() const { return c.front(); }
    value_type& back() { return c.back(); }
    const value_type& back() const { return c.back(); }
    void push(const value_type& value) { c.push_back(value); }
    void pop() { c.pop_front(); }
};

// The broadcaster oracle uses vector<EventEntry> and less<EventEntry>.
template <class T, class Container = vector<T>, class Compare =
    less<typename Container::value_type> > class priority_queue {
public:
    typedef typename Container::value_type value_type;
    typedef Container container_type;
    typedef typename Container::size_type size_type;
protected:
    Container c;
    Compare comp;
public:
    explicit priority_queue(const Compare& compare = Compare(), const Container& source =
        Container());
    bool empty() const { return c.empty(); }
    size_type size() const { return c.size(); }
    const value_type& top() const { return c.front(); }
    void push(const value_type& value);
    void pop();
};
template <class T, class C, class Compare> priority_queue<T, C,
    Compare>::priority_queue(const Compare& compare, const C& source)
    : c(source), comp(compare) { make_heap(c.begin(), c.end(), comp); }
template <class T, class C, class Compare> void priority_queue<T, C,
    Compare>::push(const value_type& value) {
    c.push_back(value); push_heap(c.begin(), c.end(), comp);
}
template <class T, class C, class Compare> void priority_queue<T, C, Compare>::pop() {
    pop_heap(c.begin(), c.end(), comp); c.pop_back();
}
}
#endif
