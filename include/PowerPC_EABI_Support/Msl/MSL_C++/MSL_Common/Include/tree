#ifndef MP6_RECONSTRUCTED_TREE
#define MP6_RECONSTRUCTED_TREE

#include <list>
#include <utility>
#include <functional>
#include <limits>

namespace std {
// An aligned node pointer retains the color in its low bit.
template <class T> class __pointer_plus_bit {
public:
    T* bits;
    // Read the pointer or apply the stored key ordering operation.
    operator T*() const {
        return reinterpret_cast<T*>(reinterpret_cast<unsigned long>(bits) & ~1UL);
    }
    T* operator->() const {
        return reinterpret_cast<T*>(reinterpret_cast<unsigned long>(bits) & ~1UL);
    }
    // Replace the pointer while preserving its stored low bit.
    __pointer_plus_bit& operator=(T* p) {
        bits = reinterpret_cast<T*>(reinterpret_cast<unsigned long>(p) |
            (reinterpret_cast<unsigned long>(bits) & 1UL));
        return *this;
    }
    // Replace the pointer while preserving its stored low bit.
    __pointer_plus_bit& operator=(const __pointer_plus_bit& p) {
        bits = reinterpret_cast<T*>((reinterpret_cast<unsigned long>(p.bits) & ~1UL) |
            (reinterpret_cast<unsigned long>(bits) & 1UL));
        return *this;
    }
    // Read or update the stored low pointer bit.
    bool bit() const { return reinterpret_cast<unsigned long>(bits) & 1UL; }
    // Read or update the stored low pointer bit.
    void bit(bool value) {
        if (value) bits = reinterpret_cast<T*>(reinterpret_cast<unsigned long>(bits) | 1UL);
        else bits = reinterpret_cast<T*>(reinterpret_cast<unsigned long>(bits) & ~1UL);
    }
};
// The template name, tag width and three node words are visible in the oracle.
template <int TagBits> class __red_black_tree {
public:
    // Under -enum int the objects pass and hold this enum as a byte; only this region reproduces
    // that.
#pragma enumsalwaysint off
    enum Color { black = 0, red = 1 };
#pragma enumsalwaysint reset
    struct node_base {
        node_base* left;
        node_base* right;
        __pointer_plus_bit<node_base> parent;
        // The low address bit stores the color; node addresses are aligned.
        Color color() const { return static_cast<Color>(parent.bit()); }
        // Set the color while preserving the parent address.
        void set_color(Color value) { parent.bit(value); }
    };
    // Holds the root link separately from allocated nodes.
    struct anchor {
        node_base* left;
        // Initialize an empty root link.
        anchor() : left(0) {}
    };
    // Find the first element below a branch.
    static node_base* leftmost(node_base* p) { while (p->left) p = p->left; return p; }
    // Advance a bidirectional tree iterator, including the root anchor.
    static void increment(const node_base*& p);
    // Advance to the preceding node in sorted order.
    static void decrement(const node_base*& p) {
        if (p->left) { p = p->left; while (p->right) p = p->right; }
        else { while (p != p->parent->right) p = p->parent; p = p->parent; }
    }
    // Restore red-black invariants after linking a newly allocated node.
    static void balance_insert(node_base* p, node_base* root);
    // Unlink the erased node, moving its successor when both children exist.
    static void balance_erase(node_base* removed, node_base* root);
    // Rotate the subtree while preserving its link to the root anchor.
    static void rotate_left(node_base* p, node_base*& root);
    // Rotate a branch right while preserving parent links.
    static void rotate_right(node_base* p, node_base*& root);
};

// Advance to the next node in sorted order.
template <int TagBits> void __red_black_tree<TagBits>::increment(const node_base*& p){
        if (p->right) p = leftmost(p->right);
        else { while (p != p->parent->left) p = p->parent; p = p->parent; }
    }

// Rotate a branch left while preserving parent links.
template <int TagBits> void __red_black_tree<TagBits>::rotate_left(node_base* p, node_base*& root){
        node_base* q = p->right;
        if (root == p) root = q;
        p->right = q->left;
        if (q->left) q->left->parent = p;
        q->parent = p->parent;
        if (p == p->parent->left) p->parent->left = q;
        else p->parent->right = q;
        q->left = p;
        p->parent = q;
    }

// Rotate a branch right while preserving parent links.
template <int TagBits> void __red_black_tree<TagBits>::rotate_right(node_base* p, node_base*& root){
        node_base* q = p->left;
        if (root == p) root = q;
        p->left = q->right;
        if (q->right) q->right->parent = p;
        q->parent = p->parent;
        if (p == p->parent->left) p->parent->left = q;
        else p->parent->right = q;
        q->right = p;
        p->parent = q;
    }

// Restore tree colors and links after insertion.
template <int TagBits> void __red_black_tree<TagBits>::balance_insert(node_base* p, node_base*
    root){
        // Set the color while preserving the parent address.
        p->set_color(red);
        while (p != root && p->parent->color() == red) {
            if (p->parent == p->parent->parent->left) {
                node_base* uncle = p->parent->parent->right;
                if (uncle && uncle->color() == red) {
                    p->parent->set_color(black); uncle->set_color(black);
                    p = p->parent->parent; p->set_color(red);
                } else {
                    if (p == p->parent->right) { p = p->parent; rotate_left(p, root); }
                    p->parent->set_color(black); p->parent->parent->set_color(red);
                    // Rotate a branch right while preserving parent links.
                    rotate_right(p->parent->parent, root);
                }
            } else {
                node_base* uncle = p->parent->parent->left;
                if (uncle && uncle->color() == red) {
                    p->parent->set_color(black); uncle->set_color(black);
                    p = p->parent->parent; p->set_color(red);
                } else {
                    if (p == p->parent->left) { p = p->parent; rotate_right(p, root); }
                    p->parent->set_color(black); p->parent->parent->set_color(red);
                    // Rotate a branch left while preserving parent links.
                    rotate_left(p->parent->parent, root);
                }
            }
        }
        // Set the color while preserving the parent address.
        root->set_color(black);
    }

// Unlink a node and restore tree colors and links.
template <int TagBits> void __red_black_tree<TagBits>::balance_erase(node_base* removed, node_base*
    root){
        node_base* moved = removed;
        if (removed->left && removed->right) increment(const_cast<const node_base*&>(moved));
        node_base* child = moved->left ? moved->left : moved->right;
        node_base* parent = moved->parent;
        if (child) child->parent = parent;
        bool left;
        if (moved == moved->parent->left) { moved->parent->left = child; left = true; }
        else { moved->parent->right = child; left = false; }
        // Read the color stored in the low pointer bit.
        bool repair = moved->color() == black;
        if (moved != removed) {
            moved->parent = removed->parent;
            if (removed == moved->parent->left) moved->parent->left = moved;
            else moved->parent->right = moved;
            moved->left = removed->left;
            if (moved->left) moved->left->parent = moved; else parent = moved;
            moved->right = removed->right;
            if (moved->right) moved->right->parent = moved; else parent = moved;
            // Set the color while preserving the parent address.
            moved->set_color(removed->color());
            if (root == removed) root = moved;
        } else if (!child && removed == root) repair = false;
        if (repair) {
            while (child != root && (!child || child->color() == black)) {
                if (left) {
                    node_base* sibling = parent->right;
                    if (sibling->color() == red) {
                        // Set the color while preserving the parent address.
                        sibling->set_color(black);
                        parent->set_color(red);
                        rotate_left(parent, root);
                        sibling = parent->right;
                    }
                    if ((!sibling->left || sibling->left->color() == black) && (!sibling->right ||
                        sibling->right->color() == black)) {
                        // Set the color while preserving the parent address.
                        sibling->set_color(red);
                        child = parent;
                        parent = child->parent;
                        left = child == parent->left;
                    } else {
                        if (!sibling->right || sibling->right->color() == black) {
                            // Set the color while preserving the parent address.
                            sibling->left->set_color(black);
                            sibling->set_color(red);
                            rotate_right(sibling, root);
                            sibling = parent->right;
                        }
                        // Set the color while preserving the parent address.
                        sibling->set_color(parent->color());
                        parent->set_color(black);
                        sibling->right->set_color(black);
                        // Rotate a branch left while preserving parent links.
                        rotate_left(parent, root); child = root;
                    }
                } else {
                    node_base* sibling = parent->left;
                    if (sibling->color() == red) {
                        // Set the color while preserving the parent address.
                        sibling->set_color(black);
                        parent->set_color(red);
                        rotate_right(parent, root);
                        sibling = parent->left;
                    }
                    if ((!sibling->left || sibling->left->color() == black) && (!sibling->right ||
                        sibling->right->color() == black)) {
                        // Set the color while preserving the parent address.
                        sibling->set_color(red);
                        child = parent;
                        parent = child->parent;
                        left = child == parent->left;
                    } else {
                        if (!sibling->left || sibling->left->color() == black) {
                            // Set the color while preserving the parent address.
                            sibling->right->set_color(black);
                            sibling->set_color(red);
                            rotate_left(sibling, root);
                            sibling = parent->left;
                        }
                        // Set the color while preserving the parent address.
                        sibling->set_color(parent->color());
                        parent->set_color(black);
                        sibling->left->set_color(black);
                        // Rotate a branch right while preserving parent links.
                        rotate_right(parent, root); child = root;
                    }
                }
            }
            if (child) child->set_color(black);
        }
    }

// The two allocator pairs, root anchor and cached first pointer follow oracle offsets.
template <class T, class Compare, class Allocator> class __tree {
    typedef __red_black_tree<1> links;
    typedef typename links::node_base node_base;
public:
    typedef T value_type;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    // Adds the stored value to the three node-link words.
    struct node : node_base { T value; };
    typedef typename Allocator::template rebind<node>::other node_allocator;
    // Traverses nodes and exposes mutable stored values.
    class iterator {
    public:
        typedef bidirectional_iterator_tag iterator_category;
        typedef T value_type;
        typedef long difference_type;
        typedef T* pointer;
        typedef T& reference;
        const node_base* position;
        // Initialize the mutable iterator from its node.
        iterator(const node_base* p = 0) : position(p) {}
        // Access the value at this iterator position.
        T& operator*() const { return static_cast<node*>(const_cast<node_base*>(position))->value; }
        // Access the value at this iterator position.
        T* operator->() const { return &operator*(); }
        // Advance the iterator in sorted order.
        iterator& operator++() { links::increment(position); return *this; }
        // Advance the iterator in sorted order.
        iterator operator++(int) { iterator old(*this); ++*this; return old; }
        // Move the iterator backward in sorted order.
        iterator& operator--() { links::decrement(position); return *this; }
        // Move the iterator backward in sorted order.
        iterator operator--(int) { iterator old(*this); --*this; return old; }
        // Compare the iterator positions.
        friend bool operator==(const iterator& a, const iterator& b) {
            return a.position == b.position;
        }
        // Compare the iterator positions.
        friend bool operator!=(const iterator& a, const iterator& b) {
            return a.position != b.position;
        }
    };
    // Reuses traversal while exposing immutable stored values.
    class const_iterator {
    public:
        typedef bidirectional_iterator_tag iterator_category;
        typedef T value_type;
        typedef long difference_type;
        typedef const T* pointer;
        typedef const T& reference;
        friend class __tree;
        const node_base* position;
        // Initialize the immutable iterator from its traversal state.
        const_iterator(const node_base* p = 0) : position(p) {}
        // Initialize the immutable iterator from its traversal state.
        const_iterator(const iterator& p) : position(p.position) {}
        // Access the value at this iterator position.
        const T& operator*() const { return static_cast<const node*>(position)->value; }
        // Access the value at this iterator position.
        const T* operator->() const { return &operator*(); }
        // Advance the iterator in sorted order.
        const_iterator& operator++() { links::increment(position); return *this; }
        // Advance the iterator in sorted order.
        const_iterator operator++(int) { const_iterator old(*this); ++*this; return old; }
        // Move the iterator backward in sorted order.
        const_iterator& operator--() { links::decrement(position); return *this; }
        // Move the iterator backward in sorted order.
        const_iterator operator--(int) { const_iterator old(*this); --*this; return old; }
        // Compare the iterator positions.
        friend bool operator==(const const_iterator& a, const const_iterator& b) {
            return a.position == b.position;
        }
        // Compare the iterator positions.
        friend bool operator!=(const const_iterator& a, const const_iterator& b) {
            return a.position != b.position;
        }
        // Compare the iterator positions.
        friend bool operator==(const iterator& a, const const_iterator& b) {
            return a.position == b.position;
        }
        // Compare the iterator positions.
        friend bool operator!=(const iterator& a, const const_iterator& b) {
            return a.position != b.position;
        }
    };
private:
    Metrowerks::compressed_pair<Allocator, size_type> allocation_count;
    Metrowerks::compressed_pair<node_allocator, typename links::anchor> node_root;
    Metrowerks::compressed_pair<Compare, node*> ordering_first;
    // Access the root anchor as the iterator sentinel.
    typename links::anchor& tail() { return node_root.second(); }
    const typename links::anchor& tail() const { return node_root.second(); }
    // Access the count.
    // Return the stored root link by reference.
    node*& root() { return reinterpret_cast<node*&>(tail().left); }
    // Read the root link through a const tree.
    const node* root() const { return static_cast<const node*>(tail().left); }
    // Return the cached first node link by reference.
    node*& front() { return ordering_first.second(); }
    size_type& sz() { return allocation_count.second(); }
    // Access the stored ordering operation.
    Compare& comp() { return ordering_first.first(); }
    // Access the stored ordering operation.
    const Compare& comp() const { return ordering_first.first(); }
public:
    // Remove the selected element or key.
    void erase(iterator p);
    // Remove the selected element or key.
    void erase(const_iterator p) { erase(iterator(p.position)); }
    // Initialize the allocator, ordering operation and tree state.
    __tree(const Compare& c = Compare(), const Allocator& a = Allocator());
    // Initialize the allocator, ordering operation and tree state.
    __tree(const __tree& other);
    // Destroy the allocated nodes when the tree is nonempty.
    ~__tree() { if (root()) destroy(static_cast<node*>(root())); }
    // Access the stored value allocator.
    Allocator& alloc() { return allocation_count.first(); }
    // Access the stored node allocator.
    node_allocator& node_alloc() { return node_root.first(); }
    // Return the first stored element.
    iterator begin() { return front(); }
    // Return the first stored element.
    const_iterator begin() const { return const_iterator(ordering_first.second()); }
    // Return the iterator past the last element.
    iterator end() { return reinterpret_cast<node_base*>(&node_root.second()); }
    // Return the iterator past the last element.
    const_iterator end() const {
        return reinterpret_cast<node_base*>(&const_cast<typename
            links::anchor&>(node_root.second()));
    }
    // Test whether the stored element count is zero.
    bool empty() const { return allocation_count.second() == 0; }
    // Return the stored element count.
    size_type size() const { return allocation_count.second(); }
    // Return the maximum representable element count.
    size_type max_size() const { return numeric_limits<size_type>::max(); }
    // Destroy and release a node and both of its subtrees.
    // Clone a branch and its stored values.
    node* copy(const node* p);
    // Search comparisons accept a key independently of the stored value type.
    template <class Key> iterator lower_bound(const Key& key);
    // Find the first element that follows the key.
    template <class Key> iterator upper_bound(const Key& key);
    template <class Key> size_type count_one(const Key& key) const { return !(find(key) == end()); }
    // Allocate, construct and link a node at the selected branch.
    node* insert_node_at(node* parent, bool left, bool first, const T& value);
    // Insert a value after traversing its ordering path.
    iterator insert_multi(const T& value);
    // Insert a value only when no equivalent key is present.
    pair<iterator, bool> insert_one(const T& value);
    // Destroy every stored element and reset the tree.
    void clear();
    // Destroy and release a node and both of its subtrees.
    void destroy(node* p);
    // Return the equivalent value, inserting a default mapped value when absent.
    template <class Key, class Mapped> T& find_or_insert(const Key& key);
    // Remove one equivalent key and return the removal count.
    template <class Key> size_type erase_one(const Key& key);
    // Find an element whose key compares equivalent.
    template <class Key> iterator find(const Key& key);
    template <class Key> const_iterator find(const Key& key) const {
        return const_cast<__tree*>(this)->find(key);
    }
};

template <class T, class Compare, class Allocator> __tree<T, Compare,
    Allocator>::__tree(const Compare& c, const Allocator& a)
        : allocation_count(a), node_root(node_allocator(a)), ordering_first(c) {
        ordering_first.second() = reinterpret_cast<node*>(&node_root.second());
    }

template <class T, class Compare, class Allocator> __tree<T, Compare,
    Allocator>::__tree(const __tree& other)
        : allocation_count(other.allocation_count), node_root(other.node_root),
            ordering_first(other.ordering_first) {
        if (other.root() != 0) {
            root() = copy(static_cast<const node*>(other.root()));
            root()->parent = reinterpret_cast<node_base*>(&tail());
            front() = static_cast<node*>(links::leftmost(root()));
        } else front() = reinterpret_cast<node*>(&tail());
    }

// Copy the branch and reconnect each child's parent before copying its value.
template <class T, class Compare, class Allocator> typename __tree<T, Compare, Allocator>::node*
    __tree<T, Compare, Allocator>::copy(const node* p) {
        node* added = node_alloc().allocate(1);
        added->left = added->right = 0;
        if (p->left) {
            added->left = copy(static_cast<const node*>(p->left));
            added->left->parent = added;
        }
        if (p->right) {
            added->right = copy(static_cast<const node*>(p->right));
            added->right->parent = added;
        }
        alloc().construct(&added->value, p->value);
        added->set_color(p->color());
        return added;
    }

// Destroy and release a node and both of its subtrees.
template <class T, class Compare, class Allocator> void __tree<T, Compare, Allocator>::destroy(node*
    p) {
        if (p->left) destroy(static_cast<node*>(p->left));
        if (p->right) destroy(static_cast<node*>(p->right));
        // Access the stored value allocator.
        alloc().destroy(&p->value); node_alloc().deallocate(p, 1);
    }

// Destroy every stored element and reset the tree.
template <class T, class Compare, class Allocator> void __tree<T, Compare, Allocator>::clear() {
        if (root()) {
            // Destroy and release a node and both of its subtrees.
            destroy(static_cast<node*>(root()));
            // Access the count.
            sz() = 0;
            // Access the root anchor as the iterator sentinel.
            root() = 0;
            ordering_first.second() = reinterpret_cast<node*>(&node_root.second());
        }
    }

// Find the first element that does not precede the key.
template <class T, class Compare, class Allocator> template <class Key> typename __tree<T, Compare,
    Allocator>::iterator __tree<T, Compare, Allocator>::lower_bound(const Key& key) {
        // Access the root anchor as the iterator sentinel.
        node_base* p = root();
        node_base* found =
            reinterpret_cast<node_base*>(&const_cast<typename links::anchor&>(node_root.second()));
        while (p) {
            if (!comp()(static_cast<node*>(p)->value, key)) { found = p; p = p->left; }
            else p = p->right;
        }
        return found;
    }

// Find the first element that follows the key.
template <class T, class Compare, class Allocator> template <class Key> typename __tree<T, Compare,
    Allocator>::iterator __tree<T, Compare, Allocator>::upper_bound(const Key& key) {
        // Access the root anchor as the iterator sentinel.
        node_base* p = root();
        node_base* found =
            reinterpret_cast<node_base*>(&const_cast<typename links::anchor&>(node_root.second()));
        while (p) {
            if (comp()(key, static_cast<node*>(p)->value)) { found = p; p = p->left; }
            else p = p->right;
        }
        return found;
    }

// Find an element whose key compares equivalent.
template <class T, class Compare, class Allocator> template <class Key> typename __tree<T, Compare,
    Allocator>::iterator __tree<T, Compare, Allocator>::find(const Key& key) {
        // Access the root anchor as the iterator sentinel.
        node_base* p = root();
        node_base* found = reinterpret_cast<node_base*>(&node_root.second());
        while (p) {
            if (!comp()(static_cast<node*>(p)->value, key)) { found = p; p = p->left; }
            else p = p->right;
        }
        if (found == reinterpret_cast<node_base*>(&node_root.second()) || comp()(key,
            static_cast<node*>(found)->value)) return end();
        return found;
    }

// Allocate, construct and link a node at the selected branch.
template <class T, class Compare, class Allocator> typename __tree<T, Compare, Allocator>::node*
    __tree<T, Compare, Allocator>::insert_node_at(node* parent, bool left, bool first, const T&
    value) {
        if (size() > max_size() - 1) __msl_error("tree::insert length error\n");
        // Access the stored node allocator.
        node* added = node_alloc().allocate(1);
        // Access the stored value allocator.
        alloc().construct(&added->value, value);
        added->left = added->right = 0;
        added->parent = parent;
        if (left) parent->left = added; else parent->right = added;
        // Access the count.
        ++sz(); links::balance_insert(added, root());
        if (first) ordering_first.second() = added;
        return added;
    }

// Insert a value after traversing its ordering path.
template <class T, class Compare, class Allocator> typename __tree<T, Compare,
    Allocator>::iterator __tree<T, Compare, Allocator>::insert_multi(const T& value) {
        node* parent = reinterpret_cast<node*>(&node_root.second());
        // Access the root anchor as the iterator sentinel.
        node* p = static_cast<node*>(root());
        bool left = true;
        bool first = true;
        while (p) {
            parent = p;
            if (comp()(value, p->value)) {
                p = static_cast<node*>(p->left);
                left = true;
            } else {
                p = static_cast<node*>(p->right);
                left = false;
                first = false;
            }
        }
        return insert_node_at(parent, left, first, value);
    }

// Insert a value only when no equivalent key is present.
template <class T, class Compare, class Allocator> pair<typename __tree<T, Compare,
    Allocator>::iterator, bool> __tree<T, Compare, Allocator>::insert_one(const T& value) {
        node_base* before = 0;
        node_base* parent = reinterpret_cast<node_base*>(&node_root.second());
        // Access the root anchor as the iterator sentinel.
        node_base* p = root();
        bool left = true;
        bool first = true;
        while (p) {
            parent = p;
            if (comp()(value, static_cast<node*>(p)->value)) {
                p = p->left; left = true;
            } else {
                before = parent;
                p = p->right; left = false; first = false;
            }
        }
        if (!before || comp()(static_cast<node*>(before)->value, value)) {
            // Allocate, construct and link a node at the selected branch.
            p = insert_node_at(static_cast<node*>(parent), left, first, value);
            return pair<iterator, bool>(iterator(p), true);
        }
        return pair<iterator, bool>(iterator(before), false);
    }

// Return the equivalent value, inserting a default mapped value when absent.
template <class T, class Compare, class Allocator> template <class Key, class Mapped> T& __tree<T,
    Compare, Allocator>::find_or_insert(const Key& key) {
        node* before = 0;
        node* parent = reinterpret_cast<node*>(&node_root.second());
        // Access the root anchor as the iterator sentinel.
        node* p = static_cast<node*>(root());
        bool left = true;
        bool first = true;
        while (p) {
            parent = p;
            if (comp()(key, p->value)) {
                p = static_cast<node*>(p->left); left = true;
            } else {
                before = parent;
                p = static_cast<node*>(p->right); left = false; first = false;
            }
        }
        if (!before || comp()(before->value, key))
            return insert_node_at(parent, left, first, T(key, Mapped()))->value;
        return before->value;
    }

// Remove the selected element or key.
template <class T, class Compare, class Allocator> void __tree<T, Compare,
    Allocator>::erase(iterator p) {
        node* victim = static_cast<node*>(const_cast<node_base*>(p.position));
        if (p == begin()) ordering_first.second() =
            static_cast<node*>(const_cast<node_base*>((++p).position));
        // Unlink a node and restore tree colors and links.
        links::balance_erase(victim, root());
        // Access the stored value allocator.
        alloc().destroy(&victim->value); node_alloc().deallocate(victim, 1); --sz();
    }

// Remove one equivalent key and return the removal count.
template <class T, class Compare, class Allocator> template <class Key> typename __tree<T, Compare,
    Allocator>::size_type __tree<T, Compare, Allocator>::erase_one(const Key& key) {
        // Find an element whose key compares equivalent.
        iterator p = find(key); if (p == end()) return 0; erase(p); return 1;
    }
}
