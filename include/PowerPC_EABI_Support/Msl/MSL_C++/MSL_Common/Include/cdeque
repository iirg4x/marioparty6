#ifndef MP6_RECONSTRUCTED_CDEQUE
#define MP6_RECONSTRUCTED_CDEQUE
#include <memory>
#include <algorithm>
#include <limits>

namespace Metrowerks {
// Pointer ring elements need no lifetime-ending operation.
template <class T> struct ring_pointer_element { enum { value = false }; };
template <class T> struct ring_pointer_element<T*> { enum { value = true }; };
// Keep the allocation extent beside its stateless allocator.
template <class Allocator, class Size> class ring_extent_storage : public Allocator {
public:
    Size extent_;
    explicit ring_extent_storage(const Allocator& a) : Allocator(a), extent_(0) {}
    ring_extent_storage(const Allocator& a, const Size& extent) : Allocator(a), extent_(extent) {}
    Allocator& allocator() { return *this; }
    const Allocator& allocator() const { return *this; }
    Size& extent() { return extent_; }
    const Size& extent() const { return extent_; }
};
// A circular allocation. The four state words follow the game's cdeque oracle.
template <class T, class Allocator = std::allocator<T> > class cdeque {
public:
    typedef T value_type;
    typedef unsigned long size_type;
    typedef long difference_type;
    typedef T& reference;
    typedef const T& const_reference;
private:
    ring_extent_storage<Allocator, size_type> allocation_extent;
    size_type size_;
    size_type first_;
    T* storage_;
    Allocator& alloc() { return allocation_extent; }
public:
    // Iterators retain the owner, logical index and current storage address.
    class iterator {
    public:
        typedef std::random_access_iterator_tag iterator_category;
        typedef T value_type;
        typedef long difference_type;
        typedef T* pointer;
        typedef T& reference;
        cdeque* owner;
        size_type index;
        T* current;
        iterator(cdeque* c = 0, size_type n = 0, T* p = 0) : owner(c), index(n), current(p) {}
        reference operator*() const { return *current; }
        pointer operator->() const { return current; }
        iterator& operator++() {
            ++index;
            if (++current == owner->storage_ + owner->allocation_extent.extent_) current =
                owner->storage_;
            return *this;
        }
        iterator operator++(int) { iterator old(*this); ++*this; return old; }
        iterator& operator--() {
            --index;
            if (current == owner->storage_) current = owner->storage_ +
                owner->allocation_extent.extent_;
            --current;
            return *this;
        }
        iterator operator--(int) { iterator old(*this); --*this; return old; }
        iterator& operator+=(difference_type n) {
            index += n;
            size_type capacity = owner->allocation_extent.extent_;
            size_type at = owner->first_ + index;
            if (at >= capacity) at -= capacity;
            current = owner->storage_ + at;
            return *this;
        }
        iterator& operator-=(difference_type n) { return *this += -n; }
        iterator operator+(difference_type n) const { return iterator(*this) += n; }
        iterator operator-(difference_type n) const { return iterator(*this) -= n; }
        friend difference_type operator-(const iterator& first, const iterator& last) {
            return first.index - last.index;
        }
        reference operator[](difference_type n) const { return *(*this + n); }
        bool operator==(const iterator& p) const { return index == p.index; }
        bool operator!=(const iterator& p) const { return index != p.index; }
        bool operator<(const iterator& p) const { return index < p.index; }
    };
    friend class iterator;
    typedef iterator const_iterator;
    cdeque(const Allocator& a = Allocator()) : allocation_extent(a), size_(0), first_(0),
        storage_(0) {}
    cdeque(const cdeque& other) :
        allocation_extent(static_cast<const Allocator&>(other.allocation_extent)), size_(0),
        first_(0), storage_(0) {
        reserve(other.size()); for (size_type i = 0; i != other.size(); ++i) push_back(other[i]);
    }
    ~cdeque() {
        if (!ring_pointer_element<T>::value) clear();
        tear_down();
    }
    void tear_down() { if (storage_) alloc().deallocate(storage_, allocation_extent.extent_); }
    size_type size() const { return size_; }
    size_type capacity() const { return allocation_extent.extent_; }
    bool empty() const { return size_ == 0; }
    size_type max_size() const;
    reference operator[](size_type n);
    const_reference operator[](size_type n) const {
        return const_cast<cdeque*>(this)->operator[](n);
    }
    reference front() { return storage_[first_]; }
    reference back() { return (*this)[size_ - 1]; }
    iterator begin() { return iterator(this, 0, storage_ + first_); }
    const_iterator begin() const {
        return iterator(const_cast<cdeque*>(this), 0, storage_ + first_);
    }
    iterator end() {
        size_type at = first_ + size_;
        if (at < allocation_extent.extent_) return iterator(this, size_, storage_ + at);
        return iterator(this, size_, storage_ + (at - allocation_extent.extent_));
    }
    void resize(size_type n, T value = T());
    template <class Input> void construct_range(Input first, Input last, T* output) {
        for (; first != last; ++first, ++output) {
            if (ring_pointer_element<T>::value) *output = *first;
            else alloc().construct(output, *first);
        }
    }
    // A type-only selector separates iterator ranges from count/value assignment.
    template <int Selection> struct chooser {};
    template <class Input> void assign(Input first, Input last) {
        choose_assign(first, last, chooser<0>());
    }
    template <class Input> void choose_assign(Input first, Input last, chooser<0>) {
        do_assign(first, last, typename std::iterator_traits<Input>::iterator_category());
    }
    template <class Input> void do_assign(Input first, Input last, std::forward_iterator_tag);
    void reserve(size_type n);
    void push_back(const T& value);
    void pop_front();
    void pop_back() {
        --size_;
        if (!ring_pointer_element<T>::value) alloc().destroy(&(*this)[size_]);
    }
    void clear() { while (!empty()) pop_back(); first_ = 0; }
    void insert(iterator where, size_type count, const T& value);
    iterator erase(iterator first, iterator last);
    void swap(cdeque& other);
};

// Both allocation extent and signed iterator differences bound the ring.
template <class T, class A> typename cdeque<T, A>::size_type cdeque<T, A>::max_size() const {
    size_type allocation_limit = static_cast<const A&>(allocation_extent).max_size();
    size_type difference_limit = std::numeric_limits<size_type>::max() >> 1;
    return std::min(allocation_limit, difference_limit);
}
template <class T, class A> T& cdeque<T, A>::operator[](size_type n) {
    n += first_;
    if (n >= allocation_extent.extent_) n -= allocation_extent.extent_;
    return storage_[n];
}
template <class T, class A> void cdeque<T, A>::reserve(size_type n) {
    if (n > max_size()) std::__msl_error("cdeque::reserve length error\n");
    if (n > capacity()) {
        T* allocation = allocation_extent.allocate(n);
        if (storage_) {
            if (ring_pointer_element<T>::value) std::copy(begin(), end(), allocation);
            else construct_range(begin(), end(), allocation);
            tear_down();
        }
        allocation_extent.extent_ = n; storage_ = allocation; first_ = 0;
    }
}
template <class T, class A> template <class Input> void cdeque<T, A>::do_assign(Input first,
    Input last, std::forward_iterator_tag) {
    size_type n = std::distance(first, last);
    if (n > max_size()) std::__msl_error("cdeque::assign length error\n");
    if (!ring_pointer_element<T>::value) clear();
    if (n <= capacity()) {
        construct_range(first, last, storage_);
        first_ = 0; size_ = n;
    } else {
        T* old_storage = storage_;
        storage_ = allocation_extent.allocate(n);
        construct_range(first, last, storage_);
        if (old_storage) alloc().deallocate(old_storage, allocation_extent.extent_);
        allocation_extent.extent_ = n; size_ = n; first_ = 0;
    }
}
template <class T, class A> void cdeque<T, A>::resize(size_type n, T value) {
    if (n > size()) insert(end(), n - size(), value);
    else if (n < size()) erase(begin() + n, end());
}
template <class T, class A> void cdeque<T, A>::push_back(const T& value) {
    if (size_ == max_size()) std::__msl_error("cdeque::push_back length error\n");
    if (size_ < capacity()) {
        (*this)[size_] = value;
        ++size_;
    } else {
        size_type required = size_ + 1;
        size_type extent = std::max(allocation_extent.extent_, size_type(1));
        if (required > extent) extent *= 2;
        // Stored and never read; the unoptimized objects keep the store.
        size_type previous_size = size_;
        T* allocation = allocation_extent.allocate(extent);
        allocation[size_] = value;
        if (size_) std::copy(begin(), end(), allocation);
        tear_down();
        storage_ = allocation; ++size_; allocation_extent.extent_ = extent; first_ = 0;
    }
}
template <class T, class A> void cdeque<T, A>::pop_front() {
    if (!ring_pointer_element<T>::value) alloc().destroy(storage_ + first_);
    --size_; ++first_; if (first_ >= allocation_extent.extent_) first_ -= allocation_extent.extent_;
}
// Insert elements using copy and fill assignment.
template <class T, class A> void cdeque<T, A>::insert(iterator where, size_type count, const T&
    value) {
    if (count) {
        size_type limit = max_size();
        if (count > limit || size_ > limit -
            count) std::__msl_error("cdeque::insert length error\n");
        if (size_ + count <= capacity()) {
            size_type before = where - begin();
            size_type after = end() - where;
            if (before < after) {
                if (first_ >= count) first_ -= count;
                else first_ = allocation_extent.extent_ - (count - first_);
                if (before == 0) std::fill_n(begin(), count, value);
                else {
                    iterator start = begin();
                    std::copy(start + count, start + (count + before), start);
                    std::fill_n(start + before, count, value);
                }
            } else {
                if (after == 0) std::fill_n(end(), count, value);
                else {
                    std::copy_backward(where, end(), end() + count);
                    std::fill_n(where, count, value);
                }
            }
            size_ += count;
        } else {
            size_type required = size_ + count;
            size_type extent = std::max(allocation_extent.extent_, size_type(1));
            while (required > extent) extent *= 2;
            size_type before = where - begin();
            T* allocation = allocation_extent.allocate(extent);
            if (before) std::copy(begin(), where, allocation);
            std::fill_n(allocation + before, count, value);
            if (before < size_) std::copy(where, end(), allocation + before + count);
            tear_down();
            storage_ = allocation; size_ = required; allocation_extent.extent_ = extent; first_ = 0;
        }
    }
}

template <class T, class A> typename cdeque<T, A>::iterator cdeque<T, A>::erase(iterator first,
    iterator last) {
    if (first == last) return first;
    size_type before = first - begin();
    size_type after = end() - last;
    size_type count = last - first;
    if (before < after) {
        if (before) std::copy_backward(begin(), first, last);
        if (!ring_pointer_element<T>::value) {
            iterator stop = begin() + count;
            for (iterator p = begin(); p != stop; ++p) alloc().destroy(&*p);
        }
        first_ += count;
        if (first_ >= allocation_extent.extent_) first_ -= allocation_extent.extent_;
    } else {
        if (after) std::copy(last, end(), first);
        if (!ring_pointer_element<T>::value) {
            iterator stop = end();
            for (iterator p = stop - count; p != stop; ++p) alloc().destroy(&*p);
        }
    }
    size_ -= count;
    return first;
}
template <class T, class A> void cdeque<T, A>::swap(cdeque& other) {
    if (this != &other) {
        std::swap(allocation_extent, other.allocation_extent);
        std::swap(size_, other.size_);
        std::swap(first_, other.first_); std::swap(storage_, other.storage_);
    }
}

// The bool deque oracle folds its buffer-pointer ring to const void pointers.
template <class Allocator> class cdeque<bool*, Allocator> : public cdeque<const void*,
    typename Allocator::template rebind<const void*>::other> {
    typedef cdeque<const void*, typename Allocator::template rebind<const void*>::other> base;
public:
    typedef base::size_type size_type;
    // Preserve typed pointer references while the ring stores const void pointers.
    class iterator : public base::iterator {
    public:
        typedef bool* value_type;
        typedef bool** pointer;
        typedef bool*& reference;
        iterator() : base::iterator() {}
        iterator(const base::iterator& p) : base::iterator(p) {}
        reference operator*() const { return (reference)base::iterator::operator*(); }
        iterator& operator++() { base::iterator::operator++(); return *this; }
        iterator& operator--() { base::iterator::operator--(); return *this; }
        iterator& operator+=(long n) { base::iterator::operator+=(n); return *this; }
        iterator operator+(long n) const { return iterator(*this) += n; }
    };
    // Constant buffer traversal exposes a constant reference to each bool pointer.
    class const_iterator : public base::const_iterator {
    public:
        typedef bool* value_type;
        typedef bool* const* pointer;
        typedef bool* const& reference;
        const_iterator(const base::const_iterator& p) : base::const_iterator(p) {}
        reference operator*() const { return (reference)base::const_iterator::operator*(); }
        const_iterator& operator++() { base::const_iterator::operator++(); return *this; }
        const_iterator& operator+=(long n) { base::const_iterator::operator+=(n); return *this; }
    };
    cdeque(const Allocator& a = Allocator()) :
        base(typename Allocator::template rebind<const void*>::other(a)) {}
    size_type size() const { return base::size(); }
    size_type capacity() const { return base::capacity(); }
    bool empty() const { return base::empty(); }
    void reserve(size_type n) { base::reserve(n); }
    iterator begin() { return iterator(base::begin()); }
    const_iterator begin() const { return const_iterator(base::begin()); }
    iterator end() { return iterator(base::end()); }
    template <class Input> void assign(Input first, Input last) {
        typedef std::__convert_iterator<std::__implicit_convert<bool**, Input> > converted_iterator;
        base::assign(converted_iterator(first), converted_iterator(last));
    }
    bool*& operator[](size_type n) { return (bool*&)base::operator[](n); }
    bool* const& operator[](size_type n) const { return (bool* const&)base::operator[](n); }
    bool*& front() { return (bool*&)base::front(); }
    bool*& back() { return (bool*&)base::back(); }
    void push_back(bool* const& value);
    void resize(size_type n, bool* value = 0) { base::resize(n, value); }
    void swap(cdeque& other) { base::swap(other); }
};
template <class Allocator> inline void cdeque<bool*, Allocator>::push_back(bool* const& value) {
    base::push_back((const void* const&)value);
}
}
#endif
