#ifndef MP6_RECONSTRUCTED_UTILITY
#define MP6_RECONSTRUCTED_UTILITY
#include <msl_utility>

namespace std {
// Stores the two values returned together by container operations.
template <class T1, class T2> struct pair {
    typedef T1 first_type;
    typedef T2 second_type;
    T1 first;
    T2 second;

    // Value-initialize both members.
    pair() : first(T1()), second(T2()) {}
    // Copy the supplied member values.
    pair(const T1& a, const T2& b) : first(a), second(b) {}
    // Permit conversion between compatible pair types.
    template <class U1, class U2>
    pair(const pair<U1, U2>& p) : first(p.first), second(p.second) {}
};

// Deduce a pair's member types from its arguments.
template <class T1, class T2>
inline pair<T1, T2> make_pair(T1 a, T2 b) { return pair<T1, T2>(a, b); }

// Compare both members for equality.
template <class T1, class T2>
inline bool operator==(const pair<T1, T2>& a, const pair<T1, T2>& b) {
    return a.first == b.first && a.second == b.second;
}
// Order pairs lexicographically.
template <class T1, class T2>
inline bool operator<(const pair<T1, T2>& a, const pair<T1, T2>& b) {
    return a.first < b.first || (!(b.first < a.first) && a.second < b.second);
}
}
#endif
