#ifndef MP6_RECONSTRUCTED_SET
#define MP6_RECONSTRUCTED_SET
#include <tree>

namespace std {
// Stores unique keys in the shared red-black tree.
template <class Key, class Compare = less<Key>, class Allocator = allocator<Key> > class set {
    typedef __tree<Key, Compare, Allocator> tree_type;
    tree_type entries;
public:
    typedef Key key_type;
    typedef Key value_type;
    typedef Compare key_compare;
    typedef Compare value_compare;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    class iterator {
        typename tree_type::iterator cursor;
        friend class set;
    public:
        typedef bidirectional_iterator_tag iterator_category;
        typedef Key value_type;
        typedef long difference_type;
        typedef const Key* pointer;
        typedef const Key& reference;
        iterator() : cursor() {}
        iterator(const typename tree_type::iterator& p) : cursor(p) {}
        const Key& operator*() const { return *cursor; }
        const Key* operator->() const { return &operator*(); }
        iterator& operator++() { ++cursor; return *this; }
        iterator operator++(int) { iterator old(*this); ++*this; return old; }
        iterator& operator--() { --cursor; return *this; }
        iterator operator--(int) { iterator old(*this); --*this; return old; }
        bool operator==(const iterator& p) const { return cursor == p.cursor; }
        bool operator!=(const iterator& p) const { return cursor != p.cursor; }
    };
    typedef iterator const_iterator;
    // Initialize the tree of unique keys.
    set() : entries() {}
    explicit set(const Compare& c, const Allocator& a = Allocator()) : entries(c, a) {}
    // Return the first stored element.
    iterator begin() { return entries.begin(); }
    // Return the first stored element.
    const_iterator begin() const { return const_cast<tree_type&>(entries).begin(); }
    // Return the iterator past the last element.
    iterator end() { return entries.end(); }
    // Return the iterator past the last element.
    const_iterator end() const { return const_cast<tree_type&>(entries).end(); }
    // Test whether the stored element count is zero.
    bool empty() const { return entries.empty(); }
    // Return the stored element count.
    size_type size() const { return entries.size(); }
    // Count the elements whose keys compare equivalent.
    size_type count(const Key& key) const {
        return const_cast<tree_type&>(entries).find(key) != entries.end();
    }
    // Destroy every stored element and reset the tree.
    void clear() { entries.clear(); }
    // Insert the supplied value and report its position.
    pair<iterator, bool> insert(const Key& key) {
        // Insert a value only when no equivalent key is present.
        pair<typename tree_type::iterator, bool> result = entries.insert_one(key);
        return pair<iterator, bool>(result.first, result.second);
    }
    // Find an element whose key compares equivalent.
    iterator find(const Key& key) { return entries.find(key); }
    // Find an element whose key compares equivalent.
    const_iterator find(const Key& key) const { return const_cast<tree_type&>(entries).find(key); }
    // Find the first element that does not precede the key.
    iterator lower_bound(const Key& key) { return entries.lower_bound(key); }
    // Find the first element that follows the key.
    iterator upper_bound(const Key& key) { return entries.upper_bound(key); }
    // Remove the selected element or key.
    void erase(iterator p) { entries.erase(p.cursor); }
    // Remove the selected element or key.
    size_type erase(const Key& key) { return entries.erase_one(key); }
};

// Stores equivalent keys without discarding repeated entries.
template <class Key, class Compare = less<Key>, class Allocator = allocator<Key> > class multiset {
    typedef __tree<Key, Compare, Allocator> tree_type;
    tree_type entries;
public:
    typedef Key key_type;
    typedef Key value_type;
    typedef Compare key_compare;
    typedef Compare value_compare;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    typedef typename tree_type::const_iterator iterator;
    typedef typename tree_type::const_iterator const_iterator;
    // Initialize the tree that permits equivalent keys.
    multiset(const Compare& c = Compare(), const Allocator& a = Allocator()) : entries(c, a) {}
    // Return the first stored element.
    iterator begin() { return entries.begin(); }
    // Return the first stored element.
    const_iterator begin() const { return entries.begin(); }
    // Return the iterator past the last element.
    iterator end() { return entries.end(); }
    // Return the iterator past the last element.
    const_iterator end() const { return entries.end(); }
    // Test whether the stored element count is zero.
    bool empty() const { return entries.empty(); }
    // Return the stored element count.
    size_type size() const { return entries.size(); }
    // Count the elements whose keys compare equivalent.
    size_type count(const Key& key) const {
        tree_type& tree = const_cast<tree_type&>(entries);
        // Find the first element that does not precede the key.
        const_iterator first = tree.lower_bound(key), last = tree.upper_bound(key);
        size_type total = 0;
        while (first != last) { ++first; ++total; }
        return total;
    }
    // Destroy every stored element and reset the tree.
    void clear() { entries.clear(); }
    // Insert the supplied value and report its position.
    iterator insert(const Key& key) { return entries.insert_multi(key); }
    // Find an element whose key compares equivalent.
    iterator find(const Key& key) { return entries.find(key); }
    // Find an element whose key compares equivalent.
    const_iterator find(const Key& key) const { return const_cast<tree_type&>(entries).find(key); }
    // Find the first element that does not precede the key.
    iterator lower_bound(const Key& key) { return entries.lower_bound(key); }
    // Find the first element that follows the key.
    iterator upper_bound(const Key& key) { return entries.upper_bound(key); }
    // Remove the selected element or key.
    void erase(iterator p) { entries.erase(p); }
    // Remove the selected element or key.
    size_type erase(const Key& key) {
        // Find the first element that does not precede the key.
        iterator first = lower_bound(key), last = upper_bound(key); size_type count = 0;
        while (first != last) { iterator p = first++; entries.erase(p); ++count; }
        return count;
    }
};
}
#endif
