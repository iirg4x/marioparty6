#ifndef MP6_RECONSTRUCTED_FUNCTIONAL
#define MP6_RECONSTRUCTED_FUNCTIONAL

namespace std {

// Empty trait supplies a const-reference argument type for binary-function binding.
template <class T>
struct bound_argument_reference {
    typedef const T& type;
};
// Empty reference specialization preserves an already referenced argument type.
template <class T>
struct bound_argument_reference<T&> {
    typedef T& type;
};

// Empty unary-operation base publishes argument and result types.
template <class Argument, class Result>
struct unary_function {
    typedef Argument argument_type;
    typedef Result result_type;
};

// Empty binary-operation base publishes both argument types and the result type.
template <class First, class Second, class Result>
struct binary_function {
    typedef First first_argument_type;
    typedef Second second_argument_type;
    typedef Result result_type;
};

// Empty comparison object tests equality through its binary-operation base.
template <class T>
struct equal_to : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return bool(a == b); }
};
// Empty inequality object supplies no state beyond its operation-type base.
template <class T>
struct not_equal_to : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return bool(a != b); }
};
// Empty ordering object applies less-than to its two arguments.
template <class T>
struct less : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return bool(a < b); }
};
// Empty reverse-order object compares its two arguments with greater-than.
template <class T>
struct greater : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return bool(a > b); }
};
// Empty inclusive-order object evaluates less-than-or-equal.
template <class T>
struct less_equal : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return bool(a <= b); }
};
// Empty inclusive reverse-order object evaluates greater-than-or-equal.
template <class T>
struct greater_equal : binary_function<T, T, bool> {
    bool operator()(const T& a, const T& b) const { return bool(a >= b); }
};

// Stores a unary free function as an adaptable operation.
template <class Argument, class Result>
class pointer_to_unary_function : public unary_function<Argument, Result> {
    // Free-function address called with the supplied unary argument.
    Result (*call_target_)(Argument);
public:
    pointer_to_unary_function() {}
    explicit pointer_to_unary_function(Result (*function)(Argument)) : call_target_(function) {}
    Result operator()(Argument argument) const { return call_target_(argument); }
};

// Stores a binary free function as an adaptable operation.
template <class First, class Second, class Result>
class pointer_to_binary_function : public binary_function<First, Second, Result> {
    // Free-function address receiving both arguments from the caller.
    Result (*call_target_)(First, Second);
public:
    pointer_to_binary_function() {}
    explicit pointer_to_binary_function(Result (*function)(First, Second)) :
        call_target_(function) {}
    Result operator()(First first, Second second) const { return call_target_(first, second); }
};

template <class Argument, class Result>
inline pointer_to_unary_function<Argument, Result> ptr_fun(Result (*function)(Argument)) {
    return pointer_to_unary_function<Argument, Result>(function);
}
// Deduces a binary free-function adapter's types.
template <class First, class Second, class Result>
inline pointer_to_binary_function<First, Second,
    Result> ptr_fun(Result (*function)(First, Second)) {
    return pointer_to_binary_function<First, Second, Result>(function);
}

// Nullary member adapter stores one member-function pointer after its empty base.
template <class Result, class Owner>
class mem_fun_t : public unary_function<Owner*, Result> {
    // Nullary member target applied to the object supplied at invocation.
    Result (Owner::*call_target_)();
public:
    explicit mem_fun_t(Result (Owner::*function)()) : call_target_(function) {}
    Result operator()(Owner* object) const { return (object->*call_target_)(); }
};

// Unary member adapter retains one member-function pointer with no object instance.
template <class Result, class Owner, class Argument>
class mem_fun1_t : public binary_function<Owner*, Argument, Result> {
    // Member target called with an object pointer and one argument.
    Result (Owner::*call_target_)(Argument);
public:
    explicit mem_fun1_t(Result (Owner::*function)(Argument)) : call_target_(function) {}
    Result operator()(Owner* object, Argument argument) const {
        return (object->*call_target_)(argument);
    }
};

template <class Result, class Owner>
inline mem_fun_t<Result, Owner> mem_fun(Result (Owner::*function)()) {
    return mem_fun_t<Result, Owner>(function);
}
template <class Result, class Owner, class Argument>
inline mem_fun1_t<Result, Owner, Argument> mem_fun(Result (Owner::*function)(Argument)) {
    return mem_fun1_t<Result, Owner, Argument>(function);
}

// First-argument adapter stores the binary operation before its bound value.
template <class Operation, class Bound = typename Operation::first_argument_type>
class binder1st : public unary_function<typename Operation::second_argument_type,
    typename Operation::result_type> {
protected:
    // Binary operation invoked with the retained first argument.
    Operation op;
    // First argument supplied before the caller provides the second.
    Bound value;
public:
    binder1st(const Operation& operation, const Bound first)
        : op(operation), value(first) {}
    // The unbound second argument retains the reference form required by the operation.
    // Reference type accepted after the first argument has been bound.
    typedef typename bound_argument_reference<typename Operation::second_argument_type>::type
        argument_reference;
    typename Operation::result_type operator()(argument_reference second) const {
        return op(value, second);
    }
};

// Second-argument adapter retains an operation followed by the saved second value.
template <class Operation, class Bound = typename Operation::second_argument_type>
class binder2nd : public unary_function<typename Operation::first_argument_type,
    typename Operation::result_type> {
protected:
    // Binary operation invoked after the caller supplies its first argument.
    Operation op;
    // Second argument kept for each adapted invocation.
    Bound value;
public:
    binder2nd(const Operation& operation, const Bound second)
        : op(operation), value(second) {}
    // The unbound first argument keeps its original reference qualification.
    // Reference type accepted after the second argument has been bound.
    typedef typename bound_argument_reference<typename Operation::first_argument_type>::type
        argument_reference;
    typename Operation::result_type operator()(argument_reference first) const {
        return op(first, value);
    }
};

template <class Operation, class T>
inline binder1st<Operation> bind1st(const Operation& operation, const T& first) {
    return binder1st<Operation>(operation, first);
}
template <class Operation, class T>
inline binder2nd<Operation> bind2nd(const Operation& operation, const T& second) {
    return binder2nd<Operation>(operation, second);
}

}
#endif
