#ifndef MP6_RECONSTRUCTED_MEMORY
#define MP6_RECONSTRUCTED_MEMORY

#include <stddef.h>
#include <new>
#include <iterator>
#include <limits>
#include <utility>

namespace std {

// The utility layer reports library errors in this exception-free build.
void __msl_error(const char* message);

// Stores a value with a stateless allocator base; its type name is oracle-backed.
template <class Empty, class Value> class _EmptyMemberOpt : private Empty {
    Value stored_value_;
public:
    // Starts with a default allocator and value.
    _EmptyMemberOpt() : Empty(), stored_value_() {}
    // Copies the allocator and value-initializes the adjoining value.
    explicit _EmptyMemberOpt(const Empty& empty) : Empty(empty), stored_value_() {}
    // Copies the allocator and the value kept beside it.
    _EmptyMemberOpt(const Empty& empty, const Value& value) : Empty(empty), stored_value_(value) {}
};

// Allocates storage and constructs elements for the standard containers.
template <class T> class allocator {
public:
    typedef T value_type;
    typedef T* pointer;
    typedef const T* const_pointer;
    typedef T& reference;
    typedef const T& const_reference;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    template <class U> struct rebind { typedef allocator<U> other; };

    // Allocators carry no per-instance state.
    allocator() throw() {}
    // Copies the stateless allocator.
    allocator(const allocator&) throw() {}
    // Accepts an allocator for another element type.
    template <class U> allocator(const allocator<U>&) throw() {}
    // Returns the address of a mutable element.
    pointer address(reference element) const { return &element; }
    // Returns the address of a constant element.
    const_pointer address(const_reference element) const { return &element; }
    // Obtains storage for the requested number of elements.
    pointer allocate(size_type count, const void* = 0) {
        pointer storage = static_cast<pointer>(::operator new(count * sizeof(T)));
        if (!storage)
            __msl_error("Memory allocation failure");
        return storage;
    }
    // Returns storage previously obtained from allocate.
    void deallocate(pointer storage, size_type) { ::operator delete(storage); }
    // Reports the largest element count representable in the address space.
    size_type max_size() const throw() {
        return numeric_limits<size_type>::max() / sizeof(T);
    }
    // Copy-constructs one element in allocated storage.
    void construct(pointer storage, const_reference value) {
        ::new (static_cast<void*>(storage)) T(value);
    }
    // Ends the lifetime of one constructed element.
    void destroy(pointer element) { element->~T(); }
};

// Supplies the type-only allocator interface for untyped storage.
template <> class allocator<void> {
public:
    typedef void value_type;
    typedef void* pointer;
    typedef const void* const_pointer;
    template <class U> struct rebind { typedef allocator<U> other; };
};

// Stateless allocators can release each other's storage.
template <class T, class U>
inline bool operator==(const allocator<T>&, const allocator<U>&) throw() { return true; }
// No two instances of this allocator have distinct allocation domains.
template <class T, class U>
inline bool operator!=(const allocator<T>&, const allocator<U>&) throw() { return false; }

// Carries ownership through the C++98 auto_ptr conversion interface.
template <class T> struct auto_ptr_ref {
    T* pointer;
    // Records a pointer whose ownership is being transferred.
    explicit auto_ptr_ref(T* value) : pointer(value) {}
};

// Owns one object and transfers ownership on non-constant copies.
template <class T> class auto_ptr {
    T* owned_address_;
public:
    typedef T element_type;

    // Takes ownership of the supplied pointer.
    explicit auto_ptr(T* pointer = 0) throw() : owned_address_(pointer) {}
    // Transfers ownership from another pointer of the same type.
    auto_ptr(auto_ptr& other) throw() : owned_address_(other.release()) {}
    // Transfers ownership from a pointer to a compatible type.
    template <class U> auto_ptr(auto_ptr<U>& other) throw() : owned_address_(other.release()) {}
    // Accepts ownership carried by a conversion temporary.
    auto_ptr(auto_ptr_ref<T> other) throw() : owned_address_(other.pointer) {}
    // Destroys the owned object when this owner leaves scope.
    ~auto_ptr() throw() { delete owned_address_; }
    // Releases this object and takes ownership from the other owner.
    auto_ptr& operator=(auto_ptr& other) throw() { reset(other.release()); return *this; }
    // Transfers ownership from a compatible owner.
    template <class U> auto_ptr& operator=(auto_ptr<U>& other) throw() {
        reset(other.release());
        return *this;
    }
    // Takes ownership carried by a conversion temporary.
    auto_ptr& operator=(auto_ptr_ref<T> other) throw() { reset(other.pointer); return *this; }
    // Returns the owned object.
    T& operator*() const throw() { return *owned_address_; }
    // Accesses members of the owned object.
    T* operator->() const throw() { return owned_address_; }
    // Observes the stored pointer without transferring it.
    T* get() const throw() { return owned_address_; }
    // Transfers the stored pointer to the caller.
    T* release() throw() { T* result = owned_address_; owned_address_ = 0; return result; }
    // Replaces the owned object, preserving an unchanged pointer.
    void reset(T* pointer = 0) throw() {
        if (owned_address_ != pointer) {
            delete owned_address_;
            owned_address_ = pointer;
        }
    }
    // Transfers ownership through the conversion carrier.
    template <class U> operator auto_ptr_ref<U>() throw() { return auto_ptr_ref<U>(release()); }
    // Transfers ownership directly to a compatible owner.
    template <class U> operator auto_ptr<U>() throw() { return auto_ptr<U>(release()); }
};

// Owns untyped allocations used by the game's resource holders.
template <> class auto_ptr<void> {
    void* owned_address_;
public:
    typedef void element_type;
    // Takes ownership of a raw allocation without an object destructor.
    explicit auto_ptr(void* address = 0) throw() : owned_address_(address) {}
    // Transfers an untyped allocation between owners.
    auto_ptr(auto_ptr& other) throw() : owned_address_(other.release()) {}
    // Accepts ownership from a compatible typed owner.
    template <class U> auto_ptr(auto_ptr<U>& other) throw() : owned_address_(other.release()) {}
    // Receives ownership through the conversion carrier.
    auto_ptr(auto_ptr_ref<void> other) throw() : owned_address_(other.pointer) {}
    // Releases the owned allocation.
    ~auto_ptr() throw() { ::operator delete(owned_address_); }
    // Replaces the allocation with ownership released by another owner.
    auto_ptr& operator=(auto_ptr& other) throw() { reset(other.release()); return *this; }
    // Receives a compatible allocation from a typed owner.
    template <class U> auto_ptr& operator=(auto_ptr<U>& other) throw() {
        reset(other.release());
        return *this;
    }
    // Takes the allocation carried by a conversion temporary.
    auto_ptr& operator=(auto_ptr_ref<void> other) throw() { reset(other.pointer); return *this; }
    // Observes the owned allocation.
    void* get() const throw() { return owned_address_; }
    // Transfers the allocation to the caller.
    void* release() throw() { void* result = owned_address_; owned_address_ = 0; return result; }
    // Releases the old allocation unless the address is unchanged.
    void reset(void* address = 0) throw() {
        if (owned_address_ != address) {
            ::operator delete(owned_address_);
            owned_address_ = address;
        }
    }
    // Transfers ownership through a conversion temporary.
    operator auto_ptr_ref<void>() throw() { return auto_ptr_ref<void>(release()); }
};

// Constructs each element and advances both iterators through the copied range.
template <class Input, class Forward>
inline Forward __uninitialized_copy(Input first, Input last, Forward output) {
    typedef typename iterator_traits<Forward>::value_type T;
    // Stored and never read; the unoptimized objects keep the store.
    Forward starting_output = output;
    for (; first != last; ++output, ++first)
        ::new (static_cast<void*>(&*output)) T(*first);
    return output;
}

// Copy-constructs a range in uninitialized output storage; this build has no exceptions.
template <class Input, class Forward>
inline Forward uninitialized_copy(Input first, Input last, Forward output) {
    return __uninitialized_copy(first, last, output);
}

// Ends one object's lifetime without releasing its storage.
template <class T> inline void __destroy(T* element) { element->~T(); }

// Random-access destruction uses the ordered range comparison seen in the oracle.
template <class Random> inline void __destroy(Random first, Random last,
    random_access_iterator_tag) {
    for (; first < last; ++first) __destroy(&*first);
}

// Selects the destruction traversal from the iterator's category.
template <class Input> inline void __destroy(Input first, Input last) {
    __destroy(first, last, typename iterator_traits<Input>::iterator_category());
}

// Constructs a range with repeated copies of one value.
template <class Forward, class T>
void uninitialized_fill(Forward first, Forward last, const T& value) {
    typedef typename iterator_traits<Forward>::value_type Element;
    for (; first != last; ++first)
        ::new (static_cast<void*>(&*first)) Element(value);
}

// Constructs a specified number of repeated values.
template <class Forward, class Size, class T>
void uninitialized_fill_n(Forward first, Size count, const T& value) {
    typedef typename iterator_traits<Forward>::value_type Element;
    for (; count > 0; --count, ++first)
        ::new (static_cast<void*>(&*first)) Element(value);
}

// Adapts an output iterator to construct values in uninitialized storage.
template <class Output, class T>
class raw_storage_iterator : public iterator<output_iterator_tag, void, void, void, void> {
    Output output_;
public:
    // Starts at the caller's uninitialized storage position.
    explicit raw_storage_iterator(Output output) : output_(output) {}
    // Dereferencing retains the construction adapter.
    raw_storage_iterator& operator*() { return *this; }
    // Copy-constructs a value at the current storage position.
    raw_storage_iterator& operator=(const T& value) {
        ::new (static_cast<void*>(&*output_)) T(value);
        return *this;
    }
    // Advances to the next storage position.
    raw_storage_iterator& operator++() { ++output_; return *this; }
    // Returns the previous position and advances this adapter.
    raw_storage_iterator operator++(int) {
        raw_storage_iterator previous(*this);
        ++output_;
        return previous;
    }
};

}
#endif
