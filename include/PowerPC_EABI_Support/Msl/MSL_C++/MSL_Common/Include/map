#ifndef MP6_RECONSTRUCTED_MAP
#define MP6_RECONSTRUCTED_MAP
#include <tree>

namespace std {
// Unique-key map stores one owning tree containing key/value nodes and their comparator.
template <class Key, class Mapped, class Compare = less<Key>,
    class Allocator = allocator<pair<const Key, Mapped> > >
class map {
public:
    typedef Key key_type;
    typedef Mapped mapped_type;
    typedef pair<const Key, Mapped> value_type;
    typedef Compare key_compare;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    // Entry comparison stores one key-ordering object used for distinct-key nodes.
    class value_compare {
        // Key comparison object used when ordering unique-key entries.
        Compare ordering;
    public:
        // Default-initialize the comparator used for distinct-key entries.
        value_compare() {}
        // Copy the caller's ordering operation for the unique-key tree.
        value_compare(const Compare& c) : ordering(c) {}
        bool operator()(const value_type& a, const value_type& b) const {
            return ordering(a.first, b.first);
        }
        bool operator()(const Key& a, const value_type& b) const { return ordering(a, b.first); }
        bool operator()(const value_type& a, const Key& b) const { return ordering(a.first, b); }
    };
private:
    typedef __tree<value_type, value_compare, Allocator> tree_type;
    // Tree owning unique key/value nodes and their ordering state.
    tree_type entries;
public:
    typedef typename tree_type::iterator iterator;
    typedef typename tree_type::const_iterator const_iterator;
    map() : entries() {}
    explicit map(const Compare& c, const Allocator& a = Allocator()) : entries(value_compare(c),
        a) {}
    iterator begin() { return entries.begin(); }
    const_iterator begin() const { return entries.begin(); }
    iterator end() { return entries.end(); }
    const_iterator end() const { return entries.end(); }
    bool empty() const { return entries.empty(); }
    size_type size() const { return entries.size(); }
    size_type count(const Key& key) const { return entries.count_one(key); }
    void clear() { entries.clear(); }
    pair<iterator, bool> insert(const value_type& value) { return entries.insert_one(value); }
    iterator find(const Key& key) { return entries.find(key); }
    const_iterator find(const Key& key) const { return const_cast<tree_type&>(entries).find(key); }
    iterator lower_bound(const Key& key) { return entries.lower_bound(key); }
    iterator upper_bound(const Key& key) { return entries.upper_bound(key); }
    void erase(iterator p) { entries.erase(p); }
    size_type erase(const Key& key) { return entries.erase_one(key); }
    Mapped& operator[](const Key& key) {
        return entries.template find_or_insert<Key, Mapped>(key).second;
    }
};

template <class Key, class Mapped, class Compare = less<Key>,
    class Allocator = allocator<pair<const Key, Mapped> > >
// Repeated-key map retains one owning tree that permits equivalent key/value nodes.
class multimap {
public:
    typedef Key key_type;
    typedef Mapped mapped_type;
    typedef pair<const Key, Mapped> value_type;
    typedef Compare key_compare;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    // Equivalent-key entries share one stored key-ordering operation.
    class value_compare {
        // Comparison object shared by entries with possibly equivalent keys.
        Compare ordering;
    public:
        // Default-initialize the ordering for a tree that retains equivalent keys.
        value_compare() {}
        // Keep the caller's comparator for repeated-key insertion and lookup.
        value_compare(const Compare& c) : ordering(c) {}
        bool operator()(const value_type& a, const value_type& b) const {
            return ordering(a.first, b.first);
        }
        bool operator()(const Key& a, const value_type& b) const { return ordering(a, b.first); }
        bool operator()(const value_type& a, const Key& b) const { return ordering(a.first, b); }
    };
private:
    typedef __tree<value_type, value_compare, Allocator> tree_type;
    // Tree retaining every key/value node, including equivalent keys.
    tree_type entries;
public:
    typedef typename tree_type::iterator iterator;
    typedef typename tree_type::const_iterator const_iterator;
    multimap() : entries() {}
    explicit multimap(const Compare& c, const Allocator& a = Allocator()) :
        entries(value_compare(c), a) {}
    iterator begin() { return entries.begin(); }
    const_iterator begin() const { return entries.begin(); }
    iterator end() { return entries.end(); }
    const_iterator end() const { return entries.end(); }
    bool empty() const { return entries.empty(); }
    size_type size() const { return entries.size(); }
    size_type count(const Key& key) const {
        tree_type& tree = const_cast<tree_type&>(entries);
        const_iterator first = tree.lower_bound(key), last = tree.upper_bound(key);
        size_type total = 0;
        while (first != last) {
            ++first;
            ++total;
        }
        return total;
    }
    void clear() { entries.clear(); }
    iterator insert(const value_type& value) { return entries.insert_multi(value); }
    iterator find(const Key& key) { return entries.find(key); }
    const_iterator find(const Key& key) const { return const_cast<tree_type&>(entries).find(key); }
    iterator lower_bound(const Key& key) { return entries.lower_bound(key); }
    iterator upper_bound(const Key& key) { return entries.upper_bound(key); }
    void erase(iterator p) { entries.erase(p); }
    size_type erase(const Key& key) {
        iterator first = lower_bound(key), last = upper_bound(key);
        size_type count = 0;
        while (first != last) {
            iterator p = first++;
            entries.erase(p);
            ++count;
        }
        return count;
    }
};
}
#endif
