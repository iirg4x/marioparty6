#ifndef MP6_RECONSTRUCTED_DEQUE
#define MP6_RECONSTRUCTED_DEQUE
#include <cdeque>
#include <limits>

namespace std {
// Type-only block-extent declaration supplies no instance storage.
template <class T>
struct deque_block_extent;
// Empty bool specialization provides the initial 0x200-element block extent.
template <>
struct deque_block_extent<bool> {
    enum {
        value = 0x200
    };
};
// Block sequence stores allocator/extent, block-pointer ring, first index and live count.
template <class T, class Allocator = allocator<T> >
class deque {
public:
    typedef T value_type;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    typedef long difference_type;
    typedef T& reference;
    typedef const T& const_reference;
    typedef Metrowerks::cdeque<T*, typename Allocator::template rebind<T*>::other> buffer_ring;
    // Initial number of element slots allocated in each block.
    static const size_type default_bufsize_s = deque_block_extent<T>::value;
    // Mutable traversal stores a block-ring iterator, two element pointers and an absolute index.
    class iterator {
    public:
        typedef random_access_iterator_tag iterator_category;
        typedef T value_type;
        typedef long difference_type;
        typedef T* pointer;
        typedef T& reference;
        // Mutable ring position identifying the current block allocation.
        typename buffer_ring::iterator buffer;
        // Address dereferenced by mutable traversal.
        T* current;
        // One-past address at which mutable traversal changes blocks.
        T* buffer_end;
        // Absolute element index used to compute iterator differences.
        size_type absolute;
        // Start traversal without an associated block or element.
        iterator() : buffer(), current(0), buffer_end(0), absolute(0) {}
        // Retain the block-ring position, element bounds and absolute sequence index.
        iterator(const typename buffer_ring::iterator& b, T* p, T* end, size_type at)
            : buffer(b), current(p), buffer_end(end), absolute(at) {}
        reference operator*() const { return *current; }
        pointer operator->() const { return current; }
        iterator& operator++() {
            ++current;
            ++absolute;
            if (current == buffer_end) {
                size_type length = buffer_end - *buffer;
                ++buffer;
                current = *buffer;
                buffer_end = current + length;
            }
            return *this;
        }
        iterator operator++(int) {
            iterator old(*this);
            ++*this;
            return old;
        }
        bool operator==(const iterator& p) const { return current == p.current; }
        bool operator!=(const iterator& p) const { return current != p.current; }
        difference_type operator-(const iterator& p) const { return absolute - p.absolute; }
    };
    // Read-only traversal retains a ring iterator, two element pointers and an absolute index.
    class const_iterator {
    public:
        typedef random_access_iterator_tag iterator_category;
        typedef T value_type;
        typedef long difference_type;
        typedef const T* pointer;
        typedef const T& reference;
        // Ring position retained by read-only block traversal.
        typename buffer_ring::const_iterator buffer;
        // Element address exposed through a const reference.
        const T* current;
        // Block boundary used when advancing read-only traversal.
        const T* buffer_end;
        // Absolute position advanced with each const-iterator increment.
        size_type absolute;
        // Point at element at through its block, its address and the end of that block.
        const_iterator(const typename buffer_ring::const_iterator& b, const T* p, const T* end,
            size_type at)
            : buffer(b), current(p), buffer_end(end), absolute(at) {}
        reference operator*() const { return *current; }
        const_iterator& operator++() {
            ++absolute;
            if (++current == buffer_end) {
                size_type length = buffer_end - *buffer;
                ++buffer;
                const T* block_begin = *buffer;
                current = block_begin;
                buffer_end = block_begin + length;
            }
            return *this;
        }
        friend bool operator!=(const const_iterator& first, const const_iterator& last) {
            return first.current != last.current;
        }
    };
private:
    // Element allocator paired with the number of slots per block.
    Metrowerks::ring_extent_storage<Allocator, size_type> block_storage;
    // Circular sequence of block pointers, including a trailing null sentinel.
    buffer_ring buffers;
    // Absolute index of the first live element in the block sequence.
    size_type first;
    // Number of constructed elements following the first index.
    size_type count;
    // Use the retained allocation domain when obtaining or releasing element blocks.
    Allocator& alloc() { return block_storage; }
public:
    explicit deque(const Allocator& a = Allocator());
    deque(const deque& other);
    ~deque() { tear_down(); }
    // End element lifetimes in the selected block-spanning range.
    void destroy(iterator first, iterator last);
    // Form mutable or const traversal state from an absolute element position.
    iterator make_iterator(size_type at);
    // Form a const traversal position from the supplied absolute index.
    const_iterator make_iterator(size_type at) const;
    iterator begin() { return make_iterator(first); }
    const_iterator begin() const { return make_iterator(first); }
    iterator end() { return make_iterator(first + count); }
    const_iterator end() const { return make_iterator(first + count); }
    bool empty() const { return count == 0; }
    size_type size() const { return count; }
    size_type max_size() const { return alloc_limit(); }
    // Count usable slots across allocated blocks, excluding the trailing sentinel.
    size_type capacity() const { return block_storage.extent_ * (buffers.size() - 1); }
    reference operator[](size_type at) {
        at += first;
        return buffers[at / block_storage.extent_][at % block_storage.extent_];
    }
    const_reference operator[](size_type at) const {
        at += first;
        return buffers[at / block_storage.extent_][at % block_storage.extent_];
    }
    reference front() {
        return buffers[first / block_storage.extent_][first % block_storage.extent_];
    }
    const_reference front() const {
        return buffers[first / block_storage.extent_][first % block_storage.extent_];
    }
    reference back() { return (*this)[count - 1]; }
    const_reference back() const { return (*this)[count - 1]; }
    void push_back(const T& value);
    void pop_front();
    void pop_back() {
        alloc().destroy(&back());
        --count;
    }
    void clear() {
        destroy(begin(), end());
        count = 0;
    }
    // Release the retained storage after destroying any live elements.
    void tear_down();
    // Extend the block ring and report how many blocks were added to the caller.
    bool grow_buf_back(size_type offset, buffer_ring& old_buffers, size_type& added,
        size_type requested);
private:
    // Bound growth by the maximum element count accepted by the allocator.
    size_type alloc_limit() const { return Allocator().max_size(); }
    // Starts the buffer ring with its trailing null sentinel.
    void init_buf() {
        buffers.reserve(2);
        buffers.resize(1, 0);
    }
    // Release unused leading blocks and adjust the first index.
    void invalidate_iterators() {
        while (first >= block_storage.extent_ * 3 / 2) {
            alloc().deallocate(buffers.front(), block_storage.extent_);
            buffers.pop_front();
            first -= block_storage.extent_;
        }
    }
    // Copy-construct each input element into the block storage from output on.
    template <class Input>
    void construct_range(Input source, Input last, T* output) {
        for (; source != last; ++source, ++output) alloc().construct(output, *source);
    }
};

// Destroy the stored elements and release every allocated block.

template <class T, class A>
void
deque<T, A>::tear_down() {
    if (buffers.size()) {
        destroy(begin(), end());
        typename buffer_ring::iterator last = --buffers.end();
        for (typename buffer_ring::iterator i = buffers.begin(); i != last; ++i)
            alloc().deallocate(*i, block_storage.extent_);
    }
}
template <class T, class A>
deque<T, A>::deque(const A& a)
    : block_storage(a, default_bufsize_s), buffers(typename A::template rebind<T*>::other(a)),
        first(0), count(0) {}
template <class T, class A>
deque<T, A>::deque(const deque& other)
    : block_storage(other.block_storage, default_bufsize_s),
        buffers(typename A::template rebind<T*>::other(block_storage)), first(0),
            count(other.count) {
    if (count) {
        init_buf();
        if (block_storage.extent_ < count) block_storage.extent_ = count;
        T* storage = block_storage.allocate(block_storage.extent_);
        buffers.front() = storage;
        buffers.push_back(0);
        first = (block_storage.extent_ - count) / 2;
        std::uninitialized_copy(other.begin(), other.end(), storage + first);
    }
}
template <class T, class A>
void
deque<T, A>::destroy(iterator first, iterator last) {
    if (first != last) {
        size_type remaining = last - first;
        size_type offset = first.absolute;
        size_type block = offset / block_storage.extent_;
        offset %= block_storage.extent_;
        size_type limit = std::min(block_storage.extent_, offset + remaining);
        typename buffer_ring::iterator b = buffers.begin() + block;
        T* storage = *b;
        std::__destroy(storage + offset, storage + limit);
        remaining -= limit - offset;
        if (remaining) {
            ++b;
            while (remaining >= block_storage.extent_) {
                storage = *b;
                std::__destroy(storage, storage + block_storage.extent_);
                ++b;
                remaining -= block_storage.extent_;
            }
            if (remaining) {
                storage = *b;
                std::__destroy(storage, storage + remaining);
            }
        }
    }
}

// Resolve a mutable position, including the null block at the end sentinel.
template <class T, class A>
typename
deque<T, A>::iterator deque<T, A>::make_iterator(size_type at) {
    typename buffer_ring::iterator b = buffers.begin();
    T* start;
    T* current;
    if (at < block_storage.extent_) {
        if (!buffers.empty()) start = *b;
        else start = 0;
        current = start + at;
    }
    else {
        b += at / block_storage.extent_;
        start = *b;
        current = start + at % block_storage.extent_;
    }
    return iterator(b, current, start + block_storage.extent_, at);
}
// Resolve a read-only position without exposing mutable block contents.
template <class T, class A>
typename
deque<T, A>::const_iterator deque<T, A>::make_iterator(size_type at) const {
    typename buffer_ring::const_iterator b = buffers.begin();
    const T* start;
    const T* current;
    if (at < block_storage.extent_) {
        if (!buffers.empty()) start = *b;
        else start = 0;
        current = start + at;
    }
    else {
        b += at / block_storage.extent_;
        start = *b;
        current = start + at % block_storage.extent_;
    }
    return const_iterator(b, current, start + block_storage.extent_, at);
}
// Append blocks from the old ring or new allocations until the requested extent fits.
template <class T, class A>
bool
deque<T,
    A>::grow_buf_back(size_type offset, buffer_ring& old_buffers, size_type& added,
        size_type requested) {
    bool replaced = false;
    size_type remaining = requested;
    remaining -= offset;
    do {
        T* storage = block_storage.allocate(block_storage.extent_);
        if (!replaced && buffers.size() == buffers.capacity()) {
            buffers.swap(old_buffers);
            replaced = true;
            buffers.reserve(old_buffers.capacity() * 2);
            buffers.assign(old_buffers.begin(), old_buffers.end());
        }
        buffers.back() = storage;
        buffers.push_back(0);
        ++added;
        if (remaining <= block_storage.extent_) break;
        remaining -= block_storage.extent_;
    } while (true);
    return replaced;
}
template <class T, class A>
void
deque<T, A>::push_back(const T& value) {
    if (count > max_size() - 1) __msl_error("deque::push_back length error\n");
    if (buffers.empty()) init_buf();
    {
        size_type added = 0;
        buffer_ring old_buffers;
        // Stored and never read; the unoptimized objects keep the store.
        bool buffer_grew = false;
        if (first + count == capacity()) buffer_grew = grow_buf_back(0, old_buffers, added, 1);
        size_type at = first + count;
        if (at < block_storage.extent_) ::new(static_cast<void*>(buffers.front() + at)) T(value);
        else
            ::new(static_cast<void*>(
                buffers[at / block_storage.extent_] + at % block_storage.extent_)) T(value);
        ++count;
    }
    invalidate_iterators();
}
template <class T, class A>
void
deque<T, A>::pop_front() {
    alloc().destroy(&front());
    ++first;
    if (--count == 0) {
        size_type discarded = buffers.size() - 2;
        while (discarded) {
            buffers.pop_back();
            T*& storage = buffers.back();
            alloc().deallocate(storage, block_storage.extent_);
            storage = 0;
            --discarded;
        }
        first = block_storage.extent_ / 2;
    }
}
template <class T, class A>
const typename deque<T, A>::size_type deque<T, A>::default_bufsize_s;
}
#endif
