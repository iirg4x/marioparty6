// Compares element types when selecting representation-preserving range conversion.
template <class First, class Second> struct vector_same_type { enum { value = 0 }; };
template <class T> struct vector_same_type<T, T> { enum { value = 1 }; };

// Keeps an allocator alongside the reserved element count without allocator storage.
template <class T, class Allocator> class vector_allocation_storage : private Allocator {
    unsigned long capacity_;
public:
    // Starts with no reserved elements and the supplied allocation domain.
    explicit vector_allocation_storage(const Allocator& a, unsigned long count) : Allocator(a),
        capacity_(count) {}
    // Uses the default allocation domain for an explicit reserved count.
    explicit vector_allocation_storage(unsigned long count) : Allocator(), capacity_(count) {}
    // Accesses the allocation domain.
    Allocator& first() { return *this; }
    const Allocator& first() const { return *this; }
    // Accesses the reserved element count.
    unsigned long& second() { return capacity_; }
    const unsigned long& second() const { return capacity_; }
    // Exchanges the reserved count of stateless allocation domains.
    void swap(vector_allocation_storage& other) { std::swap(capacity_, other.capacity_); }
};

// Provides allocation-pair operations independently of its compressed storage.
template <class T, class Allocator> class vector_allocation_count
    : public vector_allocation_storage<T, Allocator> {
    typedef vector_allocation_storage<T, Allocator> base;
public:
    // Constructs the pair from its allocation domain and reserved count.
    explicit vector_allocation_count(const Allocator& a, unsigned long count = 0) : base(a,
        count) {}
    // Initializes a reserved count with the default allocator.
    explicit vector_allocation_count(unsigned long count) : base(count) {}
    // Exchanges the stored members through their storage implementation.
    void swap(vector_allocation_count& other) { base::swap(other); }
};

// Permits unqualified exchange of two allocation pairs.
template <class T, class Allocator>
inline void swap(vector_allocation_count<T, Allocator>& first, vector_allocation_count<T,
    Allocator>& second) {
    first.swap(second);
}

template <class T, class Allocator> class __vector_deleter;
// Exchanges complete allocation owners.
template <class T, class Allocator>
inline void swap(__vector_deleter<T, Allocator>& first, __vector_deleter<T, Allocator>& second);

// Owns the allocation and the live objects of a non-scalar vector.
template <class T, class Allocator> class __vector_deleter {
    friend class __vector_imp<T, Allocator, false>;
    friend void swap<T, Allocator>(__vector_deleter&, __vector_deleter&);
protected:
    vector_allocation_count<T, Allocator> allocation_count;
    unsigned long size_;
    T* data_;
    // Accessors preserve the allocator and count as a single storage component.
    Allocator& allocator_ref() { return allocation_count.first(); }
    const Allocator& allocator_ref() const { return allocation_count.first(); }
    unsigned long& capacity_ref() { return allocation_count.second(); }
    const unsigned long& capacity_ref() const { return allocation_count.second(); }
    T*& storage_ref() { return data_; }
    T* const& storage_ref() const { return data_; }
public:
    // Creates an empty allocation owner.
    explicit __vector_deleter(const Allocator& a) : allocation_count(a), size_(0), data_(0) {}
    // Creates an empty owner in the default allocation domain.
    __vector_deleter() : allocation_count(0UL), size_(0), data_(0) {}
    // Copies only the allocation domain; the new owner starts empty.
    __vector_deleter(const __vector_deleter& other)
        : allocation_count(other.allocator_ref()), size_(0), data_(0) {}
    // Destroys live objects before releasing their allocation.
    ~__vector_deleter();
    // Destroys live elements in reverse order while retaining the allocation.
    void clear();
    // Exchanges ownership of allocations and their live element counts.
    void swap(__vector_deleter& other);
};

// Implements storage operations shared by scalar and pointer vectors.
template <class T, class Allocator> class __vector_pod {
protected:
    vector_allocation_count<T, Allocator> allocation_count;
    unsigned long size_;
    T* data_;
    // Accesses the allocation domain and its reserved count.
    Allocator& allocator_ref() { return allocation_count.first(); }
    const Allocator& allocator_ref() const { return allocation_count.first(); }
    unsigned long& capacity_ref() { return allocation_count.second(); }
    const unsigned long& capacity_ref() const { return allocation_count.second(); }
    T*& storage_ref() { return data_; }
    T* const& storage_ref() const { return data_; }
public:
    // Creates empty scalar storage.
    __vector_pod() : allocation_count(0UL), size_(0), data_(0) {}
    // Creates empty scalar storage in a supplied allocation domain.
    explicit __vector_pod(const Allocator& a) : allocation_count(a), size_(0), data_(0) {}
    // Creates and value-initializes a count-only scalar allocation.
    explicit __vector_pod(unsigned long count) : allocation_count(Allocator(), 0), size_(0),
        data_(0) {
        init(count, T());
    }
    // Creates an initial scalar range from the supplied value.
    __vector_pod(unsigned long count, const T& value) : allocation_count(Allocator(), 0), size_(0),
        data_(0) {
        init(count, value);
    }
    // Scalar clearing retains the allocation while discarding the live count.
    void clear() { size_ = 0; }
    // Removes the final scalar without changing its allocation.
    void pop_back() { --size_; }
    // Returns the final live scalar representation.
    T& back() { return *(storage_ref() + size_ - 1); }
    const T& back() const { return *(storage_ref() + size_ - 1); }
    // Releases storage; scalar elements require no destruction.
    ~__vector_pod() {
        if (storage_ref()) allocator_ref().deallocate(storage_ref(), capacity_ref());
    }
    // Replaces the scalar range by a copy of another allocation owner.
    __vector_pod& operator=(const __vector_pod& other);
    // Assigns a multipass range, reusing sufficient reserved storage.
    template <class ForwardIterator> void do_assign(ForwardIterator first,
        ForwardIterator last, forward_iterator_tag);
    // Reports the allocator's element limit.
    unsigned long max_size() const { return allocator_ref().max_size(); }
    // Returns the reserved count by value.
    unsigned long capacity() const { return capacity_ref(); }
    // Returns the bounds of the live scalar range.
    T* begin() { return storage_ref(); }
    T* end() { return storage_ref() + size_; }
    const T* begin() const { return storage_ref(); }
    const T* end() const { return storage_ref() + size_; }
    // Returns an unchecked element in the scalar allocation.
    T& operator[](unsigned long index) { return storage_ref()[index]; }
    const T& operator[](unsigned long index) const { return storage_ref()[index]; }
    // Checks the subscript before returning the stored element.
    T& at(unsigned long index);
    const T& at(unsigned long index) const;
    // Allocates and fills the initial live range.
    void reserve(unsigned long count);
    void insert(T* position, unsigned long count, const T& value);
    void init(unsigned long count, const T& value);
    // Allocates an independent scalar copy of a contiguous source range.
    template <class InputIterator> void init(InputIterator first, InputIterator last) {
        unsigned long count = std::distance(first, last);
        if (count > max_size()) { fprintf(stderr, "vector length error\n"); abort(); }
        if (count != 0) {
            storage_ref() = allocator_ref().allocate(count);
            capacity_ref() = count;
            std::copy(first, last, storage_ref());
            size_ = count;
        }
    }
    // Forwards multipass scalar construction through its contiguous initializer.
    template <class ForwardIterator> void init(ForwardIterator first, ForwardIterator last,
        forward_iterator_tag) {
        init(first, last);
    }
    // Appends one scalar representation after the live range.
    void push_back(const T& value) { insert(end(), 1, value); }
    // Inserts repeated values, moving existing scalar elements by assignment.
    // Dispatches source ranges according to their traversal capability.
    template <class InputIterator> void insert(T* position, InputIterator first,
        InputIterator last) {
        do_insert(position, first, last,
            typename iterator_traits<InputIterator>::iterator_category());
    }
    // Single-pass ranges grow one element at a time.
    template <class InputIterator> void do_insert(T* position, InputIterator first,
        InputIterator last, input_iterator_tag) {
        unsigned long index = position - begin();
        for (; first != last; ++first, ++index) insert(begin() + index, 1, *first);
    }
    // Multipass ranges permit one allocation and a single shift.
    template <class ForwardIterator> void do_insert(T* position, ForwardIterator first,
        ForwardIterator last, forward_iterator_tag);
    // Erases one scalar and shifts the remaining live range.
    T* erase(T* position);
};

// Closes a one-element gap in the scalar sequence.
template <class T, class Allocator>
T* __vector_pod<T, Allocator>::erase(T* position) {
    T* last = end();
    unsigned long tail = last - position - 1;
    if (tail != 0) std::copy(position + 1, last, position);
    --size_;
    return position;
}

// Returns a checked scalar element.
template <class T, class Allocator>
T& __vector_pod<T, Allocator>::at(unsigned long index) {
        if (index >= size_) { fprintf(stderr, "vector::at index out of range"); abort(); }
        return storage_ref()[index];
    }
// Checks a subscript without modifying the storage.
template <class T, class Allocator>
const T& __vector_pod<T, Allocator>::at(unsigned long index) const {
        if (index >= size_) { fprintf(stderr, "vector::at index out of range"); abort(); }
        return storage_ref()[index];
    }

// Initializes the scalar range after construction of the empty owner.
template <class T, class Allocator>
void __vector_pod<T, Allocator>::init(unsigned long count, const T& value) {
        if (count) {
            if (count > max_size()) { fprintf(stderr, "vector length error\n"); abort(); }
            storage_ref() = allocator_ref().allocate(count);
            capacity_ref() = size_ = count;
            T* out;
            unsigned long remaining = count;
            out = storage_ref();
            for (; remaining != 0; ++out, --remaining) *out = value;
        }
    }

// Manages element lifetimes when copying the object's representation is insufficient.
template <class T, class Allocator> class __vector_imp<T, Allocator, false>
    : public __vector_deleter<T, Allocator> {
    typedef __vector_deleter<T, Allocator> base;
public:
    typedef T value_type;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    typedef ptrdiff_t difference_type;
    typedef T& reference;
    typedef const T& const_reference;
    typedef T* pointer;
    typedef const T* const_pointer;
    typedef T* iterator;
    typedef const T* const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;
    // Carries an integral dispatch choice without runtime state.
    template <int Choice> struct chooser {};
    // Creates an empty object vector.
    __vector_imp() : base() {}
    // Creates an empty object sequence with the supplied allocator.
    explicit __vector_imp(const Allocator& a) : base(a) {}
    // Copies objects into storage owned by this vector.
    __vector_imp(const __vector_imp& other) : base(other) {
        init(other.begin(), other.end(), forward_iterator_tag());
    }
    // Releases the object-storage owner.
    ~__vector_imp() {}
    // Replaces the live object sequence with independent copies.
    __vector_imp& operator=(const __vector_imp& other) {
        if (this != &other) {
            clear(); reserve(other.size());
            for (const_iterator i = other.begin(); i != other.end(); ++i) push_back(*i);
        }
        return *this;
    }
    // Constructs a count-only sequence from a default element value.
    explicit __vector_imp(size_type count) : base(Allocator()) { init(count, T()); }
    // Creates an initial object range from the supplied value.
    __vector_imp(size_type count, const T& value) : base(Allocator()) { init(count, value); }
    // Initializes a range of identical objects.
    const_reference at(size_type index) const;
    void reserve(size_type count);
    void insert(T* position, unsigned long count, const T& value);
    // Inserts copies while preserving the lifetimes of the existing elements.
    // Inserts an iterator range while retaining the position across allocations.
    template <class InputIterator> void insert(T* position, InputIterator first,
        InputIterator last) {
        difference_type index = position - begin();
        for (; first != last; ++first, ++index) insert(begin() + index, 1, *first);
    }
    // Integral arguments select repeated-value object insertion.
    template <class Integer> void choose_insert(T* position, Integer count, Integer value,
        chooser<1>) {
        insert(position, static_cast<unsigned long>(count), static_cast<T>(value));
    }
    // Integral constructor arguments select the initial repeated-value range.
    template <class Integer> void choose_init(Integer count, Integer value, chooser<1>) {
        init(static_cast<unsigned long>(count), static_cast<T>(value));
    }
    // Multipass constructor ranges are allocated and constructed directly.
    template <class InputIterator> void choose_init(InputIterator first, InputIterator last,
        chooser<0>) {
        init(first, last, typename iterator_traits<InputIterator>::iterator_category());
    }
    // Iterator arguments retain element construction through the object implementation.
    template <class InputIterator> void choose_insert(T* position, InputIterator first,
        InputIterator last, chooser<0>) { insert(position, first, last); }
    // Returns the allocator associated with this sequence.
    allocator_type get_allocator() const { return allocator_type(this->allocator_ref()); }
    // Returns positions bracketing the live elements.
    iterator begin() { return reinterpret_cast<iterator>(this->storage_ref()); }
    const_iterator begin() const { return reinterpret_cast<const_iterator>(this->storage_ref()); }
    iterator end() { return reinterpret_cast<iterator>(this->storage_ref()) + this->size_; }
    const_iterator end() const {
        return reinterpret_cast<const_iterator>(this->storage_ref()) + this->size_;
    }
    // Returns reverse traversal positions.
    reverse_iterator rbegin() { return reverse_iterator(end()); }
    const_reverse_iterator rbegin() const { return const_reverse_iterator(end()); }
    reverse_iterator rend() { return reverse_iterator(begin()); }
    const_reverse_iterator rend() const { return const_reverse_iterator(begin()); }
    // Reports the live and reserved element counts.
    size_type size() const { return this->size_; }
    size_type capacity() const { return this->capacity_ref(); }
    size_type max_size() const { return this->allocator_ref().max_size(); }
    bool empty() const { return this->size_ == 0; }
    // Accesses an element by its position.
    reference operator[](size_type index) { return this->storage_ref()[index]; }
    const_reference operator[](size_type index) const { return this->storage_ref()[index]; }
    // Checks the subscript before returning a live object.
    reference at(size_type index);
    reference front() { return *this->storage_ref(); }
    const_reference front() const { return *this->storage_ref(); }
    reference back() { return *(this->storage_ref() + this->size_ - 1); }
    const_reference back() const { return *(this->storage_ref() + this->size_ - 1); }
    // Adds one copy after the existing elements.
    void push_back(const T& value) { this->insert(end(), 1, value); }
    // Removes the last element.
    void pop_back() { this->allocator_ref().destroy(this->storage_ref() + --this->size_); }
    // Inserts one element and returns its new position.
    iterator insert(iterator position, const T& value) {
        difference_type index = position - begin();
        this->insert(position, 1, value);
        return this->storage_ref() + index;
    }
    // Inserts a specified number of copies.
    // Erases one element, shifting later elements toward the beginning.
    iterator erase(iterator position);
    // Erases a range and ends the lifetimes of vacated elements.
    iterator erase(iterator first, iterator last);
    // Allocates once and constructs the initial object range.
    void init(unsigned long count, const T& value);
    template <class ForwardIterator> void init(ForwardIterator first,
        ForwardIterator last, forward_iterator_tag);
    // Retains the allocation while removing every live element.
    using base::clear;
    // Requests storage without changing the element count.
    // Grows by copies or removes the surplus live elements.
    void resize(size_type count);
    void resize(size_type count, const T& value) {
        if (count < size()) erase(begin() + count, end());
        else if (count > size()) this->insert(end(), count - size(), value);
    }
    // Replaces the sequence by repeated copies of a value.
    void assign(size_type count, const T& value) { clear(); insert(begin(), count, value); }

};

// Reinterprets scalar elements through an unsigned representation of equal width.
template <class T, class Allocator> class __vector_imp<T, Allocator, true>
    : public __vector_pod<typename vector_element_representation<T>::type,
          allocator<typename vector_element_representation<T>::type> > {
    typedef typename vector_element_representation<T>::type storage_type;
    typedef __vector_pod<storage_type, allocator<storage_type> > base;
public:
    typedef T value_type;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    typedef ptrdiff_t difference_type;
    typedef T& reference;
    typedef const T& const_reference;
    typedef T* pointer;
    typedef const T* const_pointer;
    typedef T* iterator;
    typedef const T* const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;
    // Carries an integral dispatch choice without runtime state.
    template <int Choice> struct chooser {};
    // The scalar implementation uses the stateless rebound allocator.
    __vector_imp() : base() {}
    // Creates an empty scalar sequence with the rebound allocator.
    explicit __vector_imp(const Allocator& a) : base(allocator<storage_type>(a)) {}
    // Constructs a count-only scalar sequence from its value-initialized element.
    explicit __vector_imp(size_type count) : base(count) {}
    // Converts the initial scalar value to the shared storage representation.
    __vector_imp(size_type count, const T& value) : base(count,
        reinterpret_cast<const storage_type&>(value)) {}
    // Copies scalar elements into an independent allocation.
    __vector_imp(const __vector_imp& other) : base(allocator<storage_type>(other.get_allocator())) {
        base::init(other.begin(), other.end());
    }
    // Releases the scalar-storage owner.
    ~__vector_imp() {}
    // Delegates scalar assignment to its common storage representation.
    __vector_imp& operator=(const __vector_imp& other) { base::operator=(other); return *this; }
    // Converts the value representation for initialization.
    void init(unsigned long count, const T& value) {
        base::init(count, reinterpret_cast<const storage_type&>(value));
    }
    // Converts the insertion position and value to the shared representation.
    void insert(T* position, unsigned long count, const T& value) {
        base::insert(reinterpret_cast<storage_type*>(position), count,
            reinterpret_cast<const storage_type&>(value));
    }
    // Integral arguments select repeated-value insertion.
    template <class Integer> void choose_insert(T* position, Integer count, Integer value,
        chooser<1>) {
        insert(position, static_cast<unsigned long>(count), static_cast<T>(value));
    }
    // Iterator value types determine which representation conversion is required.
    template <class InputIterator> void choose_insert(T* position, InputIterator first,
        InputIterator last, chooser<0>) {
        choose_insert(position, first, last,
            chooser<vector_same_type<typename iterator_traits<InputIterator>::value_type,
                T>::value>(),
            chooser<vector_same_type<T, storage_type>::value>());
    }
    // Identical scalar representations can use the original input iterator.
    template <class InputIterator> void choose_insert(T* position, InputIterator first,
        InputIterator last, chooser<1>, chooser<1>) {
        base::do_insert(reinterpret_cast<storage_type*>(position), first, last,
            typename iterator_traits<InputIterator>::iterator_category());
    }
    // Equal element types only require reinterpretation to the shared storage width.
    template <class InputIterator> void choose_insert(T* position, InputIterator first,
        InputIterator last, chooser<1>, chooser<0>) {
        typedef __convert_iterator<__reinterpret_convert<storage_type*,
            InputIterator> > converted_iterator;
        base::do_insert(reinterpret_cast<storage_type*>(position), converted_iterator(first),
            converted_iterator(last),
            typename iterator_traits<InputIterator>::iterator_category());
    }
    // Different element types require value conversion before storage.
    template <class InputIterator> void choose_insert(T* position, InputIterator first,
        InputIterator last, chooser<0>, chooser<1>) {
        typedef __convert_iterator<__implicit_convert<T*, InputIterator> > converted_iterator;
        base::do_insert(reinterpret_cast<storage_type*>(position), converted_iterator(first),
            converted_iterator(last),
            typename iterator_traits<InputIterator>::iterator_category());
    }
    // Value conversion precedes reinterpretation when neither element representation agrees.
    template <class InputIterator> void choose_insert(T* position, InputIterator first,
        InputIterator last, chooser<0>, chooser<0>) {
        typedef __convert_iterator<__implicit_convert<T*, InputIterator> > value_iterator;
        typedef __convert_iterator<__reinterpret_convert<storage_type*,
            value_iterator> > converted_iterator;
        base::do_insert(reinterpret_cast<storage_type*>(position),
            converted_iterator(value_iterator(first)),
            converted_iterator(value_iterator(last)),
                typename iterator_traits<InputIterator>::iterator_category());
    }
    // Integral arguments select repeated-value initialization.
    template <class Integer> void choose_init( Integer count, Integer value, chooser<1>) {
        init(static_cast<unsigned long>(count), static_cast<T>(value));
    }
    // Iterator value types determine which representation conversion is required.
    template <class InputIterator> void choose_init( InputIterator first,
        InputIterator last, chooser<0>) {
        choose_init( first, last,
            chooser<vector_same_type<typename iterator_traits<InputIterator>::value_type,
                T>::value>(),
            chooser<vector_same_type<T, storage_type>::value>());
    }
    // Identical scalar representations can use the original input iterator.
    template <class InputIterator> void choose_init( InputIterator first,
        InputIterator last, chooser<1>, chooser<1>) {
        base::init( first, last,
            typename iterator_traits<InputIterator>::iterator_category());
    }
    // Equal element types only require reinterpretation to the shared storage width.
    template <class InputIterator> void choose_init( InputIterator first,
        InputIterator last, chooser<1>, chooser<0>) {
        typedef __convert_iterator<__reinterpret_convert<storage_type*,
            InputIterator> > converted_iterator;
        base::init( converted_iterator(first), converted_iterator(last),
            typename iterator_traits<InputIterator>::iterator_category());
    }
    // Different element types require value conversion before storage.
    template <class InputIterator> void choose_init( InputIterator first,
        InputIterator last, chooser<0>, chooser<1>) {
        typedef __convert_iterator<__implicit_convert<T*, InputIterator> > converted_iterator;
        base::init( converted_iterator(first), converted_iterator(last),
            typename iterator_traits<InputIterator>::iterator_category());
    }
    // Value conversion precedes reinterpretation when neither element representation agrees.
    template <class InputIterator> void choose_init( InputIterator first,
        InputIterator last, chooser<0>, chooser<0>) {
        typedef __convert_iterator<__implicit_convert<T*, InputIterator> > value_iterator;
        typedef __convert_iterator<__reinterpret_convert<storage_type*,
            value_iterator> > converted_iterator;
        base::init( converted_iterator(value_iterator(first)),
            converted_iterator(value_iterator(last)),
                typename iterator_traits<InputIterator>::iterator_category());
    }
    // Scalar clearing only changes the live count.
    void clear() { base::clear(); }
    // Returns the allocator associated with this sequence.
    allocator_type get_allocator() const { return allocator_type(this->allocator_ref()); }
    // Returns positions bracketing the live elements.
    iterator begin() { return reinterpret_cast<iterator>(base::begin()); }
    const_iterator begin() const { return reinterpret_cast<const_iterator>(base::begin()); }
    iterator end() { return reinterpret_cast<iterator>(base::end()); }
    const_iterator end() const { return reinterpret_cast<const_iterator>(base::end()); }
    // Returns reverse traversal positions.
    reverse_iterator rbegin() { return reverse_iterator(end()); }
    const_reverse_iterator rbegin() const { return const_reverse_iterator(end()); }
    reverse_iterator rend() { return reverse_iterator(begin()); }
    const_reverse_iterator rend() const { return const_reverse_iterator(begin()); }
    // Reports the live and reserved element counts.
    size_type size() const { return this->size_; }
    size_type capacity() const { return this->capacity_ref(); }
    size_type max_size() const { return this->allocator_ref().max_size(); }
    bool empty() const { return this->size_ == 0; }
    // Accesses an element by its position.
    reference operator[](size_type index) {
        return reinterpret_cast<reference>(base::operator[](index));
    }
    const_reference operator[](size_type index) const {
        return reinterpret_cast<const_reference>(base::operator[](index));
    }
    // Delegates the bounds check to the scalar storage owner.
    reference at(size_type index) { return reinterpret_cast<reference>(base::at(index)); }
    const_reference at(size_type index) const {
        return reinterpret_cast<const_reference>(base::at(index));
    }
    reference front() { return *begin(); }
    const_reference front() const { return *begin(); }
    reference back() { return reinterpret_cast<reference>(base::back()); }
    const_reference back() const { return reinterpret_cast<const_reference>(base::back()); }
    // Adds one copy after the existing elements.
    void push_back(const T& value) {
        base::push_back(reinterpret_cast<const storage_type&>(value));
    }
    // Removes the last element.
    void pop_back() { base::pop_back(); }
    // Inserts one element and returns its new position.
    iterator insert(iterator position, const T& value) {
        difference_type index = position - begin();
        this->insert(position, 1, value);
        return begin() + index;
    }
    // Inserts a specified number of copies.
    // Erases one element, shifting later elements toward the beginning.
    iterator erase(iterator position) {
        return reinterpret_cast<iterator>(base::erase(reinterpret_cast<storage_type*>(position)));
    }
    // Erases a range and ends the lifetimes of vacated elements.
    iterator erase(iterator first, iterator last) {
        iterator oldEnd = end();
        iterator newEnd = std::copy(last, oldEnd, first);
        for (iterator i = oldEnd; i > newEnd;) { --i; i->~T(); }
        this->size_ -= last - first;
        return first;
    }
    // Retains the allocation while removing every live element.
    // Requests storage without changing the element count.
    void reserve(size_type count) { base::reserve(count); }
    // Grows by copies or removes the surplus live elements.
    void resize(size_type count) { resize(count, T()); }
    void resize(size_type count, const T& value) {
        if (count < size()) erase(begin() + count, end());
        else if (count > size()) this->insert(end(), count - size(), value);
    }
    // Replaces the sequence by repeated copies of a value.
    void assign(size_type count, const T& value) { clear(); insert(begin(), count, value); }
    // Exchanges the allocation, live count and reserved count.
    void swap(__vector_imp& other) {
        std::swap(this->storage_ref(), other.storage_ref());
        std::swap(this->size_, other.size_);
        std::swap(this->capacity_ref(), other.capacity_ref());
    }
};

// Exposes the C++98 contiguous sequence interface used by the game.
template <class T, class Allocator = allocator<T> > class vector
    : public __vector_imp<T, Allocator, vector_element_representation<T>::plain> {
    typedef __vector_imp<T, Allocator, vector_element_representation<T>::plain> base;
public:
    typedef T value_type;
    typedef Allocator allocator_type;
    typedef unsigned long size_type;
    typedef ptrdiff_t difference_type;
    typedef T& reference;
    typedef const T& const_reference;
    typedef T* pointer;
    typedef const T* const_pointer;
    typedef T* iterator;
    typedef const T* const_iterator;
    typedef std::reverse_iterator<iterator> reverse_iterator;
    typedef std::reverse_iterator<const_iterator> const_reverse_iterator;
    // Constructs an empty sequence.
    vector() : base() {}
    // Constructs an empty sequence with the supplied allocator.
    explicit vector(const allocator_type& a) : base(a) {}
    // Constructs a sequence of default-initialized values.
    explicit vector(size_type count) : base(count) {}
    // Constructs a sequence of identical values.
    vector(size_type count, const T& value) : base(count, value) {}
    // Constructs repeated values in the supplied allocation domain.
    vector(size_type count, const T& value, const allocator_type& a) : base(a) {
        this->init(count, value);
    }
    // Copies the live elements of another vector.
    vector(const vector& other) : base(other) {}
    // Constructs from an iterator range.
    template <class InputIterator> vector(InputIterator first, InputIterator last,
        const allocator_type& a = allocator_type()) : base(a) {
        this->choose_init(first, last,
            typename base::template chooser<vector_input_kind<InputIterator>::integral>());
    }
    // Returns the public bounds of the contiguous element range.
    iterator begin() { return base::begin(); }
    const_iterator begin() const { return base::begin(); }
    iterator end() { return base::end(); }
    const_iterator end() const { return base::end(); }
    // Selects range or repeated-value insertion from the argument types.
    template <class InputIterator> void insert(iterator position, InputIterator first,
        InputIterator last) {
        this->choose_insert(position, first, last,
            typename base::template chooser<vector_input_kind<InputIterator>::integral>());
    }
    // Inserts repeated copies through the selected storage implementation.
    void insert(iterator position, size_type count, const T& value) {
        base::insert(position, count, value);
    }
    // Inserts one value and returns its position in the sequence.
    iterator insert(iterator position, const T& value) { return base::insert(position, value); }
    // Reports the public live count, reserved count, and element limit.
    size_type size() const { return base::size(); }
    size_type capacity() const { return base::capacity(); }
    size_type max_size() const { return base::max_size(); }
    bool empty() const { return base::empty(); }
    // Returns the allocation domain used by this sequence.
    allocator_type get_allocator() const { return base::get_allocator(); }
    // Returns public reverse traversal bounds.
    reverse_iterator rbegin() { return reverse_iterator(end()); }
    const_reverse_iterator rbegin() const { return const_reverse_iterator(end()); }
    reverse_iterator rend() { return reverse_iterator(begin()); }
    const_reverse_iterator rend() const { return const_reverse_iterator(begin()); }
    // Delegates element access to the selected storage implementation.
    reference operator[](size_type index) { return base::operator[](index); }
    const_reference operator[](size_type index) const { return base::operator[](index); }
    reference at(size_type index) { return base::at(index); }
    const_reference at(size_type index) const { return base::at(index); }
    reference front() { return base::front(); }
    const_reference front() const { return base::front(); }
    reference back() { return base::back(); }
    const_reference back() const { return base::back(); }
    // Forwards sequence mutation to the selected element implementation.
    void clear() { base::clear(); }
    void reserve(size_type count) { base::reserve(count); }
    void push_back(const T& value) { base::push_back(value); }
    void pop_back() { base::pop_back(); }
    iterator erase(iterator position) { return base::erase(position); }
    iterator erase(iterator first, iterator last) { return base::erase(first, last); }
    void resize(size_type count) { base::resize(count); }
    void resize(size_type count, const T& value) { base::resize(count, value); }
    void assign(size_type count, const T& value) { base::assign(count, value); }
    // Replaces the live sequence with a copy.
    vector& operator=(const vector& other) {
        base::operator=(other);
        return *this;
    }
    // Destroys the inherited live range and allocation.
    ~vector() {}
};

// Initializes object storage from a forward range.
template <class T, class Allocator>
template <class ForwardIterator>
void __vector_imp<T, Allocator, false>::init(ForwardIterator first,
    ForwardIterator last, forward_iterator_tag) {
    unsigned long count = std::distance(first, last);
    if (this->size_ > max_size()) { fprintf(stderr, "vector length error\n"); abort(); }
    if (count != 0) {
        this->storage_ref() = this->allocator_ref().allocate(count);
        this->capacity_ref() = count;
        T* out;
        out = begin();
        for (; first != last; ++first) {
            this->allocator_ref().construct(out, *first);
            ++out;
            ++this->size_;
        }
    }
}

// Inserts a multipass scalar range, preserving existing elements around it.
template <class T, class Allocator>
template <class ForwardIterator>
void __vector_pod<T, Allocator>::do_insert(T* position, ForwardIterator first,
    ForwardIterator last, forward_iterator_tag) {
    unsigned long count = std::distance(first, last);
    if (count == 0) return;
    unsigned long limit = max_size();
    if (count > limit || size_ > limit - count) {
        fprintf(stderr, "vector::insert length error\n"); abort();
    }
    if (size_ + count <= capacity()) {
        T* finish = end();
        unsigned long tail = finish - position;
        if (tail != 0) {
            std::copy_backward(position, finish, finish + count);
        }
        std::copy(first, last, position);
        size_ += count;
    } else {
        unsigned long index = position - begin();
        T* old = storage_ref();
        unsigned long newSize = size_ + count;
        unsigned long newCapacity = capacity_ref() != 0 ? capacity_ref() : 1;
        while (newSize > newCapacity) {
            if (newCapacity < limit / 2) newCapacity *= 2;
            else newCapacity = limit;
        }
        storage_ref() = allocator_ref().allocate(newCapacity);
        if (old) {
            std::copy(old, old + index, storage_ref());
            std::copy(old + index, old + size_, storage_ref() + index + count);
            allocator_ref().deallocate(old, capacity_ref());
        }
        std::copy(first, last, storage_ref() + index);
        size_ = newSize;
        capacity_ref() = newCapacity;
    }
}

// Exchanges the owned allocation after construction is complete.
template <class T, class Allocator>
inline void __vector_deleter<T, Allocator>::swap(__vector_deleter& other) {
    std::swap(*this, other);
}

// Exchanges allocation domains, then pointers and live counts.
template <class T, class Allocator>
inline void swap(__vector_deleter<T, Allocator>& first, __vector_deleter<T, Allocator>& second) {
    if (&first != &second) {
        std::swap(first.allocation_count, second.allocation_count);
        std::swap(first.data_, second.data_);
        std::swap(first.size_, second.size_);
    }
}

// Copies a scalar owner without replacing its allocation domain.
template <class T, class Allocator>
__vector_pod<T, Allocator>& __vector_pod<T, Allocator>::operator=(const __vector_pod& other) {
    if (this != &other) do_assign(other.begin(), other.end(), forward_iterator_tag());
    return *this;
}

// Reuses a scalar allocation when possible, otherwise replacing it before copying.
template <class T, class Allocator>
template <class ForwardIterator>
void __vector_pod<T, Allocator>::do_assign(ForwardIterator first,
    ForwardIterator last, forward_iterator_tag) {
    unsigned long count = std::distance(first, last);
    if (count > capacity()) {
        if (count > max_size()) { fprintf(stderr, "vector::assign length error\n"); abort(); }
        size_ = 0;
        if (storage_ref()) {
            allocator_ref().deallocate(storage_ref(), capacity_ref());
            storage_ref() = 0;
            capacity_ref() = 0;
        }
        storage_ref() = allocator_ref().allocate(count);
        capacity_ref() = count;
    }
    std::copy(first, last, storage_ref());
    size_ = count;
}

// Constructs the initial object range and records each completed lifetime.
template <class T, class Allocator>
void __vector_imp<T, Allocator, false>::init(unsigned long count, const T& value) {
    if (count != 0) {
        if (count > max_size()) { fprintf(stderr, "vector length error\n"); abort(); }
        this->storage_ref() = this->allocator_ref().allocate(count);
        this->capacity_ref() = count;
        T* last = this->storage_ref() + count;
        T* out = begin();
        while (out < last) {
            this->allocator_ref().construct(out, value);
            ++out;
            ++this->size_;
        }
    }
}

// Implements the separately emitted storage operation.
template <class T, class Allocator>
void __vector_pod<T, Allocator>::insert(T* position, unsigned long count, const T& value) {
        if (count != 0) {
            unsigned long limit = max_size();
            if (count > limit || size_ > limit - count) {
                fprintf(stderr, "vector::insert length error\n"); abort();
            }
            if (size_ + count <= capacity()) {
                T* last = end();
                unsigned long tail = last - position;
                const T* source = &value;
                if (last - (tail - count) <= source && source < last) source += count;
                if (tail != 0) {
                    std::copy_backward(position, last, last + count);
                }
                std::fill_n(position, count, *source);
                size_ += count;
            } else {
                unsigned long index = position - begin();
                T* old = storage_ref();
                unsigned long newSize = size_ + count;
                unsigned long newCapacity = capacity_ref() != 0 ? capacity_ref() : 1;
                while (newSize > newCapacity) {
                    if (newCapacity < limit / 2) newCapacity *= 2;
                    else newCapacity = limit;
                }
                storage_ref() = allocator_ref().allocate(newCapacity);
                std::fill_n(storage_ref() + index, count, value);
                if (old) {
                    std::copy(old, old + index, storage_ref());
                    std::copy(old + index, old + size_, storage_ref() + index + count);
                    allocator_ref().deallocate(old, capacity_ref());
                }
                size_ = newSize;
                capacity_ref() = newCapacity;
            }
        }
    }

// Replaces the scalar allocation while preserving its live range.
template <class T, class Allocator>
void __vector_pod<T, Allocator>::reserve(unsigned long count) {
        if (count <= capacity_ref()) return;
        if (count > max_size()) { fprintf(stderr, "vector::reserve length error\n"); abort(); }
        T* old = storage_ref();
        storage_ref() = allocator_ref().allocate(count);
        if (old) {
            std::copy(old, old + size_, storage_ref());
            allocator_ref().deallocate(old, capacity_ref());
        }
        capacity_ref() = count;
    }

// Implements the separately emitted storage operation.
template <class T, class Allocator>
void __vector_imp<T, Allocator, false>::insert(T* position, unsigned long count, const T& value) {
    if (count != 0) {
        unsigned long limit = max_size();
        if (count > limit || this->size_ > limit - count) {
            fprintf(stderr, "vector::insert length error\n"); abort();
        }
        if (this->size_ + count <= capacity()) {
            T* last = end();
            unsigned long tail = last - position;
            const T* source = &value;
            if (count > tail) {
                T* out = last;
                while (count > tail) {
                    this->allocator_ref().construct(out, value);
                    ++out;
                    --count;
                    ++this->size_;
                }
                T* in = position;
                while (in < last) {
                    this->allocator_ref().construct(out, *in);
                    ++in;
                    ++out;
                    ++this->size_;
                }
            } else {
                T* in = last - count;
                T* out = last;
                while (in < last) {
                    this->allocator_ref().construct(out, *in);
                    ++in;
                    ++out;
                    ++this->size_;
                }
                if (last - (tail - count) <= source && source < last) source += count;
                std::copy_backward(position, position + (tail - count), last);
            }
            std::fill_n(position, count, *source);
        } else {
            base temporary(this->allocator_ref());
            unsigned long newSize = this->size_ + count;
            unsigned long newCapacity = this->capacity_ref() != 0 ? this->capacity_ref() : 1;
            while (newSize > newCapacity) {
                if (newCapacity < limit / 2) newCapacity *= 2;
                else newCapacity = limit;
            }
            temporary.storage_ref() = temporary.allocator_ref().allocate(newCapacity);
            temporary.capacity_ref() = newCapacity;
            T* out = temporary.storage_ref();
            T* in = begin();
            T* last = end();
            while (in < position) {
                temporary.allocator_ref().construct(out, *in);
                ++in;
                ++out;
                ++temporary.size_;
            }
            while (count != 0) {
                temporary.allocator_ref().construct(out, value);
                ++out;
                --count;
                ++temporary.size_;
            }
            while (in < last) {
                temporary.allocator_ref().construct(out, *in);
                ++in;
                ++out;
                ++temporary.size_;
            }
            temporary.swap(*this);
        }
    }
}

// Reserves through a temporary owner so existing objects remain owned during copying.
template <class T, class Allocator>
void __vector_imp<T, Allocator, false>::reserve(size_type count) {
    if (count > capacity()) {
        if (count > max_size()) { fprintf(stderr, "vector::reserve length error\n"); abort(); }
        base temporary(this->allocator_ref());
        temporary.data_ = temporary.allocator_ref().allocate(count);
        temporary.capacity_ref() = count;
        T* out = temporary.storage_ref();
        T* first = begin();
        T* last = end();
        while (first < last) {
            temporary.allocator_ref().construct(out, *first);
            ++first;
            ++out;
            ++temporary.size_;
        }
        temporary.swap(*this);
    }
}

// Destroys the owned object range before releasing or reusing storage.
template <class T, class Allocator>
void __vector_deleter<T, Allocator>::clear() {
    T* first = storage_ref();
    T* last = first + size_;
    while (last > first) allocator_ref().destroy(--last);
    size_ = 0;
}

// Implements the separately emitted storage operation.
template <class T, class Allocator>
__vector_deleter<T, Allocator>::~__vector_deleter() {
    clear();
    if (storage_ref()) allocator_ref().deallocate(storage_ref(), capacity_ref());
}

// Checks an index before returning a mutable object reference.
template <class T, class Allocator>
T& __vector_imp<T, Allocator, false>::at(size_type index) {
        if (index >= this->size_) { fprintf(stderr, "vector::at index out of range"); abort(); }
        return this->storage_ref()[index];
    }

// Checks an index before returning a read-only object reference.
template <class T, class Allocator>
const T& __vector_imp<T, Allocator, false>::at(size_type index) const {
        if (index >= this->size_) { fprintf(stderr, "vector::at index out of range"); abort(); }
        return this->storage_ref()[index];
    }

// Closes one erased position and destroys the former final object.
template <class T, class Allocator>
T* __vector_imp<T, Allocator, false>::erase(iterator position) {
        iterator last = end();
        size_type tail = last - position - 1;
        if (tail != 0) std::copy(position + 1, last, position);
        this->allocator_ref().destroy(this->storage_ref() + --this->size_);
        return position;
    }

// Closes an erased range and destroys the objects beyond the new end.
template <class T, class Allocator>
T* __vector_imp<T, Allocator, false>::erase(iterator first, iterator last) {
    if (first == last) return first;
    iterator oldEnd = end();
    size_type tail = oldEnd - last;
    if (tail != 0) std::copy(last, oldEnd, first);
    iterator out = first + tail;
    while (out < oldEnd) {
        this->allocator_ref().destroy(out);
        ++out;
    }
    this->size_ -= last - first;
    return first;
}

// Grows with default values or erases objects beyond the requested size.
template <class T, class Allocator>
void __vector_imp<T, Allocator, false>::resize(size_type count) {
    if (count > size()) insert(end(), count - size(), T());
    else if (count < size()) erase(begin() + count, end());
}

