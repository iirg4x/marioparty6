#ifndef MP6_RECONSTRUCTED_ITERATOR
#define MP6_RECONSTRUCTED_ITERATOR
#include <stddef.h>

namespace std {
// Empty input tag selects traversal that reads values while advancing.
struct input_iterator_tag {};
// Empty tag permits output traversal without requiring input operations.
struct output_iterator_tag {};
// Empty derived tag adds multipass traversal to the input category.
struct forward_iterator_tag : input_iterator_tag {};
// Empty forward-category tag also permits decrementing traversal.
struct bidirectional_iterator_tag : forward_iterator_tag {};
// Empty bidirectional-category tag adds indexed displacement.
struct random_access_iterator_tag : bidirectional_iterator_tag {};

// Empty type record supplies the standard associated types for user-defined iterators.
template <class Category, class T, class Distance = ptrdiff_t, class Pointer = T*,
    class Reference = T&>
struct iterator {
    typedef Category iterator_category;
    typedef T value_type;
    typedef Distance difference_type;
    typedef Pointer pointer;
    typedef Reference reference;
};
// Empty trait extracts an iterator's associated types without retaining an instance.
template <class I>
struct iterator_traits {
    typedef typename I::iterator_category iterator_category;
    typedef typename I::value_type value_type;
    typedef typename I::difference_type difference_type;
    typedef typename I::pointer pointer;
    typedef typename I::reference reference;
};
// Empty pointer trait supplies the types for random-access traversal.
template <class T>
struct iterator_traits<T*> {
    typedef random_access_iterator_tag iterator_category;
    typedef T value_type;
    typedef ptrdiff_t difference_type;
    typedef T* pointer;
    typedef T& reference;
};
// Empty const-pointer trait exposes read-only random-access types.
template <class T>
struct iterator_traits<const T*> {
    typedef random_access_iterator_tag iterator_category;
    typedef T value_type;
    typedef ptrdiff_t difference_type;
    typedef const T* pointer;
    typedef const T& reference;
};

// Empty converter reinterprets pointers between storage and element representations.
template <class Result, class Input>
struct __reinterpret_convert {
    typedef Input argument_type;
    typedef Result result_type;
    typedef typename iterator_traits<Result>::value_type reference;
    typename iterator_traits<Result>::value_type operator()(Input position) const {
        return *reinterpret_cast<Result>(&*position);
    }
};

// Empty conversion object applies the implicit conversion between pointer representations.
template <class Result, class Input>
struct __implicit_convert {
    typedef Input argument_type;
    typedef Result result_type;
    typedef typename iterator_traits<Result>::value_type reference;
    reference operator()(const Input& position) const { return *position; }
};

// Representation adapter stores an input iterator followed by a conversion object.
template <class Converter>
class __convert_iterator {
    // Input position advanced before representation conversion.
    typename Converter::argument_type input_position;
    // Stateless operation that converts a dereferenced storage representation.
    Converter conversion;
public:
    typedef typename iterator_traits<typename Converter::argument_type>::iterator_category
        iterator_category;
    typedef typename iterator_traits<typename Converter::result_type>::value_type value_type;
    typedef typename iterator_traits<typename Converter::argument_type>::difference_type
        difference_type;
    typedef typename iterator_traits<typename Converter::result_type>::pointer pointer;
    typedef typename Converter::reference reference;
    // Keep the original position so advancing retains its traversal semantics.
    __convert_iterator() : input_position() {}
    // Retain the supplied input position for representation-adapted traversal.
    explicit __convert_iterator(const typename Converter::argument_type& position) :
        input_position(position) {}
    // Expose the unconverted traversal position.
    typename Converter::argument_type base() const { return input_position; }
    reference operator*() const {
        Converter convert = Converter();
        return value_type(convert(input_position));
    }
    __convert_iterator& operator++() {
        ++input_position;
        return *this;
    }
    __convert_iterator operator++(int) {
        __convert_iterator previous(*this);
        ++input_position;
        return previous;
    }
    bool operator==(const __convert_iterator& other) const {
        return input_position == other.input_position;
    }
    bool operator!=(const __convert_iterator& other) const { return !(*this == other); }
    difference_type operator-(const __convert_iterator& other) const {
        return input_position - other.input_position;
    }
};

// Value adapter keeps an input position and conversion object, returning converted elements.
template <class Result, class Input>
class __convert_iterator<__implicit_convert<Result, Input> > {
    // Original iterator retained while element values are implicitly converted.
    Input input_position;
    // Empty value-conversion operation applied when the iterator is dereferenced.
    __implicit_convert<Result, Input> conversion;
public:
    typedef typename iterator_traits<Input>::iterator_category iterator_category;
    typedef typename iterator_traits<Result>::value_type value_type;
    typedef typename iterator_traits<Input>::difference_type difference_type;
    typedef typename iterator_traits<Result>::pointer pointer;
    typedef value_type reference;
    // Preserve the input position and its traversal domain.
    __convert_iterator() : input_position() {}
    // Start value-converting traversal from the caller's original iterator.
    explicit __convert_iterator(const Input& position) : input_position(position) {}
    // Return the position in the original traversal domain.
    Input base() const { return input_position; }
    reference operator*() const { return conversion(input_position); }
    __convert_iterator& operator++() {
        ++input_position;
        return *this;
    }
    __convert_iterator operator++(int) {
        __convert_iterator previous(*this);
        ++input_position;
        return previous;
    }
    bool operator==(const __convert_iterator& other) const {
        return input_position == other.input_position;
    }
    bool operator!=(const __convert_iterator& other) const { return !(*this == other); }
    difference_type operator-(const __convert_iterator& other) const {
        return input_position - other.input_position;
    }
};

// Advance a single-pass iterator by a nonnegative count.
template <class I, class D>
inline void advance_by_category(I& i, D n, input_iterator_tag) {
    for (; n > 0; --n) ++i;
}
// A bidirectional iterator accepts either sign of displacement.
template <class I, class D>
inline void advance_by_category(I& i, D n, bidirectional_iterator_tag) {
    if (n >= 0) { for (; n > 0; --n) ++i; }
    else { for (; n < 0; ++n) --i; }
}
// Random-access iterators implement displacement directly.
template <class I, class D>
inline void advance_by_category(I& i, D n, random_access_iterator_tag) { i += n; }
template <class I, class D>
inline void advance(I& i, D n) {
    advance_by_category(i, n, typename iterator_traits<I>::iterator_category());
}
// Count increments between input iterators.
template <class I>
inline typename iterator_traits<I>::difference_type
distance_by_category(I first, I last, input_iterator_tag) {
    typename iterator_traits<I>::difference_type n = 0;
    for (; first != last; ++first) ++n;
    return n;
}
// Random-access distance is the difference of the positions.
template <class I>
inline typename iterator_traits<I>::difference_type
distance_by_category(I first, I last, random_access_iterator_tag) { return last - first; }
template <class I>
inline typename iterator_traits<I>::difference_type distance(I first, I last) {
    return distance_by_category(first, last, typename iterator_traits<I>::iterator_category());
}

// Reverse traversal stores one underlying iterator positioned after the selected element.
template <class I>
class reverse_iterator {
protected:
    // Underlying forward position immediately after the selected element.
    I current;
public:
    typedef I iterator_type;
    typedef typename iterator_traits<I>::iterator_category iterator_category;
    typedef typename iterator_traits<I>::value_type value_type;
    typedef typename iterator_traits<I>::difference_type difference_type;
    typedef typename iterator_traits<I>::pointer pointer;
    typedef typename iterator_traits<I>::reference reference;
    reverse_iterator() : current() {}
    explicit reverse_iterator(I i) : current(i) {}
    template <class U>
    reverse_iterator(const reverse_iterator<U>& r) : current(r.base()) {}
    // Return the underlying position after the selected element.
    I base() const { return current; }
    reference operator*() const {
        I i = current;
        return *--i;
    }
    pointer operator->() const { return &operator*(); }
    reverse_iterator& operator++() {
        --current;
        return *this;
    }
    reverse_iterator operator++(int) {
        reverse_iterator r(*this);
        --current;
        return r;
    }
    reverse_iterator& operator--() {
        ++current;
        return *this;
    }
    reverse_iterator operator--(int) {
        reverse_iterator r(*this);
        ++current;
        return r;
    }
    reverse_iterator operator+(difference_type n) const { return reverse_iterator(current - n); }
    reverse_iterator& operator+=(difference_type n) {
        current -= n;
        return *this;
    }
    reverse_iterator operator-(difference_type n) const { return reverse_iterator(current + n); }
    reverse_iterator& operator-=(difference_type n) {
        current += n;
        return *this;
    }
    reference operator[](difference_type n) const { return current[-n - 1]; }
};
template <class I>
inline bool operator==(const reverse_iterator<I>& a, const reverse_iterator<I>& b) {
    return a.base() == b.base();
}
template <class I>
inline bool operator!=(const reverse_iterator<I>& a, const reverse_iterator<I>& b) {
    return a.base() != b.base();
}
template <class I>
inline bool operator<(const reverse_iterator<I>& a, const reverse_iterator<I>& b) {
    return b.base() < a.base();
}
// Reverse the subtraction order for the distance between reverse iterators.
template <class I>
inline typename reverse_iterator<I>::difference_type
operator-(const reverse_iterator<I>& a, const reverse_iterator<I>& b) {
    return b.base() - a.base();
}
}
#endif
