#ifndef MP6_RECONSTRUCTED_LIMITS
#define MP6_RECONSTRUCTED_LIMITS
#include <cfloat>
#include <cmath>
namespace std {
// Standard classifications for floating-point rounding and subnormal values.
enum float_round_style { round_indeterminate = -1, round_toward_zero,
    round_to_nearest, round_toward_infinity, round_toward_neg_infinity };
enum float_denorm_style { denorm_indeterminate = -1, denorm_absent, denorm_present };
// Unspecialized types have no numeric representation guarantees.
template <class T> class numeric_limits {
public:
    static const bool is_specialized = false;
    static const int digits = 0;
    static const int digits10 = 0;
    static const bool is_signed = false;
    static const bool is_integer = false;
    static const bool is_exact = false;
    static const int radix = 0;
    static T min() throw() { return T(); }
    static T max() throw() { return T(); }
};
// Iterator differences on this ABI use a 32-bit signed long.
template <> class numeric_limits<long> {
public:
    static const bool is_specialized = true;
    static const bool is_signed = true;
    static const bool is_integer = true;
    static const bool is_exact = true;
    static const int digits = 31;
    static const int digits10 = 9;
    static const int radix = 2;
    static long min() throw() { return -0x7FFFFFFFL - 1; }
    static long max() throw() { return 0x7FFFFFFFL; }
};
// Container capacities on this ABI use a 32-bit unsigned long.
template <> class numeric_limits<unsigned long> {
public:
    static const bool is_specialized = true;
    static const bool is_signed = false;
    static const bool is_integer = true;
    static const bool is_exact = true;
    static const int digits = 32;
    static const int digits10 = 9;
    static const int radix = 2;
    static unsigned long min() throw() { return 0; }
    static unsigned long max() throw() { return 0xFFFFFFFFUL; }
};
}
#endif
