# Normalize repository text without altering binary game/build artifacts.
* text=auto eol=lf

*.py text eol=lf
*.sh text eol=lf
*.s text eol=lf
*.sha1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
config/**/*.txt text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.exe binary
*.dol binary
*.rel binary
